---
import '../styles/global.css';
import '../styles/account.css';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  modifiedTime?: Date;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  robots?: string;
}
const {
  title = 'Gratuit pour les devs — Les bons outils pour développer, avant la facture',
  description = 'Services cloud, API et outils pour développeurs réellement utilisables gratuitement — quotas, restrictions et conditions vérifiés.',
  ogType = 'website',
  modifiedTime,
  jsonLd,
  robots,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const jsonLdPayload = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : undefined;
const cloudflareWebAnalyticsToken = import.meta.env.CLOUDFLARE_WEB_ANALYTICS_TOKEN?.trim();
const cloudflareWebAnalyticsConfig = cloudflareWebAnalyticsToken
  ? JSON.stringify({ token: cloudflareWebAnalyticsToken })
  : undefined;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      (() => {
        let theme = 'light';
        try { theme = localStorage.getItem('theme') === 'dark' ? 'dark' : 'light'; } catch {}
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#11141a' : '#ffffff');
      })();
    </script>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/pagination-enhancement.css" />
    <script src="/pagination-enhancement.js" defer></script>
    <script src="/catalogue-editorial-enhancement.js" defer></script>
    <script src="/account-client.js?v=20260821-account-redirect" defer></script>
    <script src="/account-delete.js" defer></script>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {jsonLdPayload && <script type="application/ld+json" set:html={jsonLdPayload} is:inline />}
    <title>{title}</title>
    <style is:global>
      @media(max-width:760px){.site-header nav a.guides-nav-link{display:grid!important}}
    </style>
  </head>
  <body data-comparisons-api="https://gratuitpourlesdevs-oauth.gratuitpourlesdevsallianciasolutions.workers.dev" data-comparisons-api-local="http://127.0.0.1:8787">
    <slot />
    <script is:inline>
      (() => {
        const nav = document.querySelector('.site-header nav');
        if (nav && !nav.querySelector('a[href="/guides/"]')) {
          const link = document.createElement('a');
          link.href = '/guides/';
          link.textContent = 'Guides';
          link.className = 'guides-nav-link';
          if (location.pathname.startsWith('/guides/')) link.classList.add('active');
          nav.append(link);
        }
        const actions = document.querySelector('.site-header .header-actions');
        if (actions && !actions.querySelector('.account-header-link')) {
          const link = document.createElement('a');
          link.href = '/compte/';
          link.className = 'account-header-link';
          if (location.pathname.startsWith('/compte/')) link.classList.add('active');
          link.innerHTML = '<span data-account-label>Compte</span>';
          actions.append(link);
        }
        document.querySelectorAll('footer nav').forEach((footerNav) => {
          if (footerNav.querySelector('a[href="/confidentialite/"]')) return;
          const link = document.createElement('a');
          link.href = '/confidentialite/';
          link.textContent = 'Confidentialité';
          footerNav.append(link);
        });
      })();
    </script>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const meta = document.querySelector('meta[name="theme-color"]');
        const syncButtons = () => {
          const dark = root.dataset.theme === 'dark';
          document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
            button.setAttribute('aria-pressed', String(dark));
            button.setAttribute('aria-label', dark ? 'Activer le mode clair' : 'Activer le mode sombre');
            const label = button.querySelector('.theme-label');
            if (label) label.textContent = dark ? 'Mode clair' : 'Mode sombre';
          });
          meta?.setAttribute('content', dark ? '#11141a' : '#ffffff');
        };
        document.addEventListener('click', (event) => {
          const button = event.target.closest?.('[data-theme-toggle]');
          if (!button) return;
          const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = theme;
          root.style.colorScheme = theme;
          try { localStorage.setItem('theme', theme); } catch {}
          syncButtons();
        });
        syncButtons();
      })();
    </script>
    {cloudflareWebAnalyticsConfig && (
      <script
        is:inline
        type="module"
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={cloudflareWebAnalyticsConfig}
      ></script>
    )}
  </body>
</html>
