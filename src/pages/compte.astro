---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CustomSelect from '../components/CustomSelect.astro';
import { STACK_TEMPLATES } from '../data/stack-templates';

const stackOfferOptions = [{ value: '', label: 'Choisir une offre…' }];
const stackTemplatesPayload = JSON.stringify(STACK_TEMPLATES.map((template) => ({
  slug: template.slug,
  name: template.name,
  offerIds: template.services.map((service) => service.offerId),
}))).replace(/</g, '\\u003c');
---

<BaseLayout title="Mon espace — GratuitPourLesDevs" description="Synchronisez vos favoris, suivez jusqu’à cinq offres gratuites, sauvegardez vos recherches et comparaisons, et surveillez votre stack.">
  <SiteHeader />
  <main class="account-page">
    <header class="account-hero">
      <div class="account-hero-copy">
        <small>MON ESPACE</small>
        <h1>Votre veille gratuite,<br />au même endroit.</h1>
        <p>Votre espace personnel transforme le catalogue en veille continue : moins de vérifications à refaire, davantage de décisions prises avec le bon contexte.</p>
      </div>
      <aside class="account-login-card" id="account-login-card">
        <small>COMPTE GRATUIT</small>
        <strong>Commencez votre veille</strong>
        <p>Retrouvez vos choix et les changements importants depuis tous vos appareils.</p>
        <ul class="account-login-benefits" aria-label="Avantages du compte">
          <li>Sans abonnement</li>
          <li>GitHub, Google ou lien e-mail sécurisé</li>
          <li>Vos favoris actuels sont conservés</li>
        </ul>
        <button class="account-primary" id="account-login" type="button">Se connecter ou créer un compte</button>
      </aside>
      <aside class="account-profile-card" id="account-profile-card" hidden>
        <div class="account-profile-head"><img id="account-avatar" alt="" /><span><strong id="account-name"></strong><small id="account-login-name"></small></span></div>
        <div class="account-profile-actions"><button class="account-secondary" id="account-refresh" type="button">Actualiser</button><button class="account-danger" id="account-logout" type="button">Se déconnecter</button></div>
      </aside>
    </header>

    <div class="account-loading" id="account-loading">Chargement de votre espace…</div>

    <section class="account-signed-out" id="account-signed-out" hidden>
      <header>
        <div>
          <small>POURQUOI CRÉER UN COMPTE ?</small>
          <h2>Votre veille ne reste plus dans un seul navigateur.</h2>
          <p>Le catalogue reste entièrement public. Le compte ajoute uniquement la continuité et le suivi personnalisé.</p>
        </div>
        <button class="account-primary" id="account-login-secondary" type="button">Créer mon compte gratuit</button>
      </header>
      <div class="account-benefits">
        <article><span>01</span><strong>Favoris synchronisés</strong><p>Retrouvez automatiquement les offres que vous avez mises de côté.</p></article>
        <article><span>02</span><strong>Jusqu’à 5 offres suivies</strong><p>Surveillez leurs changements et alimentez votre digest hebdomadaire.</p></article>
        <article><span>03</span><strong>Recherches et comparaisons</strong><p>Sauvegardez jusqu’à six analyses pour les reprendre plus tard.</p></article>
        <article><span>04</span><strong>Une stack de 10 offres</strong><p>Regroupez les services gratuits qui composent votre environnement.</p></article>
      </div>
    </section>

    <div id="account-dashboard" hidden>
      <section class="account-status-grid" aria-label="Résumé du compte">
        <article class="account-stat"><small>01</small><div><strong id="stat-favorites">0</strong><span>favoris synchronisés</span></div></article>
        <article class="account-stat"><small>02</small><div><strong id="stat-follows">0 / 5</strong><span>offres suivies</span></div></article>
        <article class="account-stat"><small>03</small><div><strong id="stat-watched">0 / 1</strong><span>recherche surveillée</span></div></article>
        <article class="account-stat"><small>04</small><div><strong id="stat-searches">0 / 3</strong><span>recherches sauvegardées</span></div></article>
        <article class="account-stat"><small>05</small><div><strong id="stat-comparisons">0 / 3</strong><span>comparaisons sauvegardées</span></div></article>
        <article class="account-stat"><small>06</small><div><strong id="stat-stack">0 / 10</strong><span>offres dans la stack</span></div></article>
      </section>

      <section class="account-section">
        <header><div><small>VOTRE SÉLECTION</small><h2>Mes favoris</h2></div><p>Retrouvez ici les offres mises de côté depuis le catalogue ou une fiche détaillée.</p></header>
        <article class="account-card account-favorites-card"><small>FAVORIS SYNCHRONISÉS</small><h3>Vos derniers favoris</h3><p>Un aperçu des trois offres mises de côté le plus récemment.</p><ul class="account-list" id="favorites-list"></ul><footer class="account-favorites-footer"><a href="/?favoris=1#catalogue">Voir tous mes favoris dans le catalogue →</a><nav class="account-carousel-controls" id="favorites-carousel" aria-label="Parcourir les favoris" hidden><button id="favorites-previous" type="button" aria-label="Favori précédent">←</button><span id="favorites-carousel-summary" aria-live="polite"></span><div id="favorites-carousel-dots" aria-label="Choisir un favori"></div><button id="favorites-next" type="button" aria-label="Favori suivant">→</button></nav></footer>
        </article>
      </section>

      <section class="account-section account-watch-section">
        <header><div><small>VOTRE VEILLE</small><h2>Suivi et activité</h2></div><p>Suivez les offres importantes et consultez leurs derniers changements au même endroit.</p></header>
        <div class="account-grid">
          <article class="account-card account-card--with-limit"><small>OFFRES SUIVIES</small><h3>Votre veille <span class="account-limit account-limit--prominent" id="follow-limit">0 / 5</span></h3><p>Vous pouvez suivre cinq offres. Leurs modifications alimentent automatiquement votre activité.</p><ul class="account-list" id="follows-list"></ul></article>
          <article class="account-card account-digest-card">
            <header class="account-digest-header"><div><small>ACTIVITÉ DE VOTRE VEILLE</small><h3>Derniers changements</h3></div><label class="digest-toggle"><input id="digest-enabled" type="checkbox" checked /> Recevoir le digest par e-mail</label></header>
            <p id="digest-email-status"></p><ul class="account-list" id="digest-list"></ul>
          </article>
        </div>
      </section>

      <section class="account-section">
        <header><div><small>À RETROUVER PLUS TARD</small><h2>Recherches et comparaisons</h2></div><p>Sauvegardez-les directement depuis l’Explorateur et le comparateur.</p></header>
        <div class="account-grid">
          <article class="account-card account-card--with-limit"><small>EXPLORATEUR</small><h3>Recherches sauvegardées <span class="account-limit account-limit--prominent" id="search-limit">0 / 3</span></h3><ul class="account-list" id="searches-list"></ul><p><a href="/explorer/">Ouvrir l’Explorateur →</a></p></article>
          <article class="account-card account-card--with-limit"><small>COMPARATEUR</small><h3>Comparaisons sauvegardées <span class="account-limit account-limit--prominent" id="comparison-limit">0 / 3</span></h3><ul class="account-list" id="comparisons-list"></ul><p><a href="/#catalogue">Créer une comparaison →</a></p></article>
        </div>
      </section>

      <section class="account-section" id="stack">
        <header class="account-section-heading--with-limit"><div><small>MA STACK</small><h2>Les services gratuits de votre projet</h2></div><span class="account-limit account-limit--prominent" id="stack-limit">0 / 10</span></header>
        <article class="account-card stack-editor stack-risk-dashboard">
          <section class="stack-risk-summary" aria-labelledby="stack-risk-name">
            <header class="stack-risk-identity"><h3 id="stack-risk-name">Ma stack</h3><p id="stack-risk-service-count">0 service</p></header>
            <div class="stack-risk-signals" aria-label="Indicateurs de risque de la stack">
              <article data-tone="danger"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v6M12 17h.01"/></svg><strong id="stack-risk-billing">0</strong><span>risque de facturation</span></article>
              <article data-tone="warning"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 2.8 20h18.4L12 3Z"/><path d="M12 9v5M12 17h.01"/></svg><strong id="stack-risk-review">0</strong><span>offre à revérifier</span></article>
              <article data-tone="safe"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 20 6v6c0 4.7-3.1 7.5-8 9-4.9-1.5-8-4.3-8-9V6l8-3Z"/><path d="m8.5 12 2.2 2.2 4.8-5"/></svg><strong id="stack-risk-no-card">0</strong><span>service sans carte</span></article>
              <article data-tone="safe"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 2.5 2.5L16 9"/></svg><strong id="stack-risk-critical">Aucun</strong><span>changement critique cette semaine</span></article>
            </div>
            <aside class="stack-confidence"><span>Confiance €0</span><strong><b id="stack-confidence-score">—</b><small>/100</small></strong><p>Facturation, fraîcheur et alertes</p></aside>
          </section>

          <section class="stack-threat" id="stack-threat" aria-labelledby="stack-threat-title">
            <div><small>DIAGNOSTIC PRIORITAIRE</small><h3 id="stack-threat-title">Qu’est-ce qui menace ma stack gratuite ?</h3><p id="stack-threat-copy">Ajoutez des services pour obtenir un diagnostic.</p></div>
            <a id="stack-threat-link" href="/#catalogue" hidden>Examiner le risque →</a>
          </section>

          <section class="stack-inventory" aria-labelledby="stack-inventory-title">
            <header><h3 id="stack-inventory-title">Services et niveau de confiance</h3><p>Le rôle est déduit de la catégorie de chaque offre.</p></header>
            <div class="stack-service-head" aria-hidden="true"><span>Rôle</span><span>Service</span><span>Risque</span><span>Score GPLD</span><span></span></div>
            <ul class="stack-service-list" id="stack-chips"></ul>
          </section>

          <section class="stack-configuration" aria-labelledby="stack-configuration-title">
            <header><small>CONFIGURATION</small><h3 id="stack-configuration-title">Modifier la stack</h3></header>
            <div class="stack-config-grid">
            <label class="stack-name-field">Nom de la stack<input id="stack-name" maxlength="80" value="Ma stack" /></label>
            <div class="stack-add-row">
              <div class="stack-offer-picker">
                <CustomSelect id="stack-offer-select" label="Ajouter un service" options={stackOfferOptions} searchable searchLabel="Rechercher une offre" searchPlaceholder="Rechercher une offre par nom ou catégorie…" />
              </div>
              <button class="account-primary stack-add-button" id="stack-add" type="button">Ajouter</button>
            </div>
            </div>
            <footer class="stack-actions"><p class="stack-offer-limit-copy" id="stack-offer-limit-copy">Compte gratuit : jusqu’à 10 offres dans votre stack.</p><div><button class="account-primary" id="stack-save" type="button">Enregistrer les modifications</button><button class="account-danger" id="stack-delete" type="button">Supprimer la stack</button></div></footer>
          </section>
        </article>
      </section>

      <section class="account-section" id="pro">
        <article class="pro-card">
          <header class="pro-card-header"><div><small>GPLD PRO — PÉRIMÈTRE ENVISAGÉ</small><h2>Soyez prévenu avant que votre stack gratuite ne change.</h2><p>Pro transformerait votre catalogue personnel en véritable poste de veille : davantage de capacité, des alertes plus fines et tout l’historique nécessaire pour décider sans urgence.</p></div><span>Accès prioritaire</span></header>
          <p class="pro-scope-note"><strong>Le catalogue restera public et gratuit.</strong> Les fonctions ci-dessous correspondent au périmètre étudié avant lancement.</p>
          <div class="pro-benefit-grid">
            <section><small>VEILLE SANS LIMITE</small><h3>Suivez tout ce qui compte</h3><ul><li>Offres suivies illimitées</li><li>Recherches surveillées illimitées</li><li>Comparaisons sauvegardées illimitées</li><li>Stacks et services illimités</li></ul></section>
            <section><small>ALERTES SUR MESURE</small><h3>Réagissez au bon changement</h3><ul><li>Alertes immédiates ou regroupées</li><li>Règles par quota, score ou restriction</li><li>Seuils personnalisés par ressource</li><li>Priorités et silences temporaires</li></ul></section>
            <section><small>HISTORIQUE & PREUVES</small><h3>Décidez avec du contexte</h3><ul><li>Historique complet des changements</li><li>Comparaison avant / après</li><li>Sources et dates de vérification conservées</li><li>Exports CSV et rapports partageables</li></ul></section>
            <section><small>ORGANISATION</small><h3>Structurez plusieurs projets</h3><ul><li>Plusieurs stacks nommées</li><li>Notes et étiquettes personnelles</li><li>Listes partagées avec votre équipe</li><li>Tableau de bord sans publicité</li></ul></section>
            <section><small>INTÉGRATIONS</small><h3>Recevez l’information où vous travaillez</h3><ul><li>Webhooks configurables</li><li>Notifications Slack et Discord</li><li>Digest personnalisé par projet</li><li>API de lecture pour vos outils internes</li></ul></section>
            <section><small>ACCOMPAGNEMENT</small><h3>Allez plus vite</h3><ul><li>Analyses assistées plus généreuses</li><li>Suggestions d’alternatives ciblées</li><li>Détection des doublons dans une stack</li><li>Accès prioritaire aux nouveautés</li></ul></section>
          </div>
          <footer><p><strong>Aucun paiement aujourd’hui.</strong> Votre intérêt nous aide à prioriser le bon périmètre et vous place sur la liste d’accès anticipé.</p><button class="pro-interest-button" id="pro-interest" type="button">Rejoindre la liste d’accès prioritaire</button></footer>
        </article>
      </section>
    </div>
  </main>
  <SiteFooter />

  <script id="account-stack-templates" type="application/json" set:html={stackTemplatesPayload} is:inline />

  <dialog class="account-confirm-dialog" id="account-remove-dialog" aria-labelledby="account-remove-title" aria-describedby="account-remove-description">
    <form method="dialog">
      <small id="account-remove-eyebrow">CONFIRMATION</small>
      <h2 id="account-remove-title">Retirer cette offre ?</h2>
      <p id="account-remove-description"></p>
      <div class="account-confirm-actions"><button class="account-secondary" type="submit" value="cancel">Annuler</button><button class="account-danger" id="account-remove-confirm" type="submit" value="confirm">Retirer</button></div>
    </form>
  </dialog>

  <script is:inline>
    const $ = (selector) => document.querySelector(selector);
    const account = () => window.GPLDAccount;
    const FAVORITES_PREVIEW_SIZE = 3;
    const state = { dashboard: null, catalogue: {}, quotas: {}, stackOfferIds: [], favoritesIndex: 0 };
    const stackTemplates = (() => { try { return JSON.parse($('#account-stack-templates')?.textContent || '[]'); } catch { return []; } })();
    const stackTemplateRequest = (() => { const params = new URLSearchParams(location.search); const slug = params.get('modele'); if (!slug) return null; return { template: stackTemplates.find((item) => item.slug === slug), action: params.get('action') === 'add' ? 'add' : 'adapt' }; })();
    let stackTemplateHandled = false;
    let stackOfferSelect = null;
    const offer = (id) => state.catalogue[id] || { id, name: id, category: '', score: null, freeTier: '', cardRequired: null, overageBilled: null, permanent: null, verificationState: null, alerts: [] };
    const offerLink = (id) => `/offres/${encodeURIComponent(id)}/`;
    const formatOfferDate = (value) => value ? new Date(value).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
    const normalize = (value) => String(value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
    const emptyItem = (message) => { const li = document.createElement('li'); li.className = 'account-empty'; li.textContent = message; return li; };
    const setLimit = (selector, value, limit) => { const node = $(selector); if (!node) return; node.textContent = `${value} / ${limit}`; node.classList.toggle('is-full', value >= limit); };
    const confirmAction = ({ eyebrow = 'CONFIRMATION', title, description, confirmLabel = 'Confirmer' }) => new Promise((resolve) => {
      const dialog = $('#account-remove-dialog');
      $('#account-remove-eyebrow').textContent = eyebrow;
      $('#account-remove-title').textContent = title;
      $('#account-remove-description').textContent = description;
      $('#account-remove-confirm').textContent = confirmLabel;
      dialog.returnValue = 'cancel';
      dialog.addEventListener('close', () => resolve(dialog.returnValue === 'confirm'), { once: true });
      if (typeof dialog.showModal === 'function') dialog.showModal();
      else resolve(window.confirm(`${title}\n\n${description}`));
    });
    window.GPLDConfirmAccountAction = confirmAction;
    $('#account-remove-dialog')?.addEventListener('click', (event) => {
      if (event.target === event.currentTarget) event.currentTarget.close('cancel');
    });
    const confirmRemoval = (id, follow) => {
      const data = offer(id);
      const kind = follow ? 'de votre veille' : 'de vos favoris';
      return confirmAction({ title: `Retirer ${data.name || id} ?`, description: `${data.name || id} sera retiré ${kind}. Vous pourrez l’ajouter de nouveau à tout moment.`, confirmLabel: 'Retirer' });
    };

    const renderOfferList = (selector, ids, { removable, follow } = {}) => {
      const root = $(selector); if (!root) return;
      if (!ids.length) { root.replaceChildren(emptyItem(follow ? 'Aucune offre suivie pour le moment.' : 'Aucun favori pour le moment.')); return; }
      root.replaceChildren(...ids.map((id) => {
        const data = offer(id); const li = document.createElement('li'); li.className = 'account-offer-item account-compact-item';
        const body = document.createElement('div'); body.className = 'account-compact-body';
        const header = document.createElement('header'); const title = document.createElement('a'); title.href = offerLink(id); title.textContent = data.name || id; header.append(title);
        if (data.score != null) { const score = document.createElement('strong'); score.className = 'account-offer-score'; score.textContent = `${data.score}/100`; score.setAttribute('aria-label', `Score GratuitPourLesDevs : ${data.score} sur 100`); header.append(score); }
        const metadata = document.createElement('small'); metadata.className = 'account-compact-meta';
        const metaParts = [data.category || 'Offre gratuite'];
        if (data.cardRequired != null) metaParts.push(data.cardRequired ? 'Carte requise' : 'Sans carte');
        if (data.permanent != null) metaParts.push(data.permanent ? 'Formule permanente' : 'Durée limitée');
        metadata.textContent = metaParts.join(' · ');
        const summary = document.createElement('p'); summary.className = 'account-offer-summary'; summary.textContent = data.freeTier || 'Consultez la fiche pour connaître le quota gratuit et ses conditions.';
        const date = document.createElement('span'); date.className = 'account-offer-date';
        date.textContent = follow && data.latestChangeAt ? `${data.latestChangeTitle || 'Dernière évolution'} · ${formatOfferDate(data.latestChangeAt)}` : `Vérifiée le ${formatOfferDate(data.verifiedAt)}`;
        const actions = document.createElement('nav'); actions.className = 'account-compact-actions'; const view = document.createElement('a'); view.href = offerLink(id); view.textContent = 'Voir la fiche'; actions.append(view);
        if (removable) { const button = document.createElement('button'); button.type = 'button'; button.textContent = 'Retirer'; button.addEventListener('click', () => removeOffer(id, follow)); actions.append(button); }
        body.append(header, metadata, summary, date); li.append(body, actions);
        return li;
      }));
    };

    const renderFavorites = () => {
      const ids = [...(state.dashboard?.favorites || [])].reverse().slice(0, FAVORITES_PREVIEW_SIZE);
      if (ids.length) state.favoritesIndex = ((state.favoritesIndex % ids.length) + ids.length) % ids.length;
      else state.favoritesIndex = 0;
      renderOfferList('#favorites-list', ids.length ? [ids[state.favoritesIndex]] : [], { removable: true });
      const carousel = $('#favorites-carousel');
      if (!carousel) return;
      carousel.hidden = ids.length < 2;
      const summary = $('#favorites-carousel-summary');
      if (summary) summary.textContent = ids.length ? `${state.favoritesIndex + 1} / ${ids.length}` : '';
      const dots = $('#favorites-carousel-dots');
      if (dots) dots.replaceChildren(...ids.map((id, index) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'account-carousel-dot';
        button.classList.toggle('active', index === state.favoritesIndex);
        const label = offer(id).name || `le favori ${index + 1}`;
        button.setAttribute('aria-label', `Afficher ${label}`);
        if (index === state.favoritesIndex) button.setAttribute('aria-current', 'true');
        button.addEventListener('click', () => { state.favoritesIndex = index; renderFavorites(); });
        return button;
      }));
    };

    const removeOffer = async (id, follow) => {
      if (!await confirmRemoval(id, follow)) return;
      try {
        if (follow) await account().api('/api/account/follows', { method: 'POST', body: JSON.stringify({ offerId: id, active: false }) });
        else {
          await account().api('/api/account/favorites', { method: 'POST', body: JSON.stringify({ offerId: id, active: false }) });
          try { const local = JSON.parse(localStorage.getItem('gpld-favorites') || '[]').filter((value) => value !== id); localStorage.setItem('gpld-favorites', JSON.stringify(local)); } catch {}
        }
        await loadDashboard();
      } catch (error) { account().showToast(error.message || 'Modification impossible.'); }
    };

    const renderSavedList = (selector, items, type) => {
      const root = $(selector); if (!root) return;
      if (!items.length) { root.replaceChildren(emptyItem(type === 'searches' ? 'Aucune recherche sauvegardée.' : 'Aucune comparaison sauvegardée.')); return; }
      root.replaceChildren(...items.map((item) => {
        const li = document.createElement('li'); const span = document.createElement('span'); const link = document.createElement('a'); link.href = item.url; link.textContent = item.name; const small = document.createElement('small'); small.textContent = new Date(item.createdAt).toLocaleDateString('fr-FR'); span.append(link, small); const button = document.createElement('button'); button.type = 'button'; button.textContent = 'Supprimer'; button.addEventListener('click', async () => { const kind = type === 'searches' ? 'recherche' : 'comparaison'; if (!await confirmAction({ eyebrow: 'SUPPRESSION', title: `Supprimer « ${item.name} » ?`, description: `Cette ${kind} sauvegardée sera supprimée de votre espace. Cette action ne modifie aucune offre du catalogue.`, confirmLabel: 'Supprimer' })) return; try { await account().api(`/api/account/${type}?id=${item.id}`, { method: 'DELETE' }); await loadDashboard(); } catch (error) { account().showToast(error.message || 'Suppression impossible.'); } }); li.append(span, button); return li;
      }));
    };

    const updateStackOfferLimit = () => {
      const pro = state.dashboard?.user?.plan === 'pro';
      const limit = Number(state.dashboard?.limits?.stackOffers || 10);
      const count = state.stackOfferIds.length;
      const display = pro ? `${count} / ∞` : `${count} / ${limit}`;
      const full = !pro && count >= limit;
      ['#stat-stack', '#stack-limit'].forEach((selector) => { const node = $(selector); if (!node) return; node.textContent = display; node.classList.toggle('is-full', full); });
      const copy = $('#stack-offer-limit-copy');
      if (copy) copy.textContent = pro ? 'GPLD Pro : offres illimitées dans vos stacks.' : `Compte gratuit : ${count} offre${count > 1 ? 's' : ''} sur ${limit} dans votre stack.`;
      const add = $('#stack-add'); if (add) { add.disabled = full; add.title = full ? `La stack gratuite accepte jusqu’à ${limit} offres.` : ''; }
      stackOfferSelect?.setDisabled(full);
    };

    const DAY = 86_400_000;
    const daysSince = (value) => value ? Math.max(0, Math.floor((Date.now() - new Date(value).getTime()) / DAY)) : Number.POSITIVE_INFINITY;
    const stackRole = (category = '') => {
      const value = normalize(category);
      if (value.includes('e-mail') || value.includes('email')) return 'E-mail';
      if (value.includes('base') || value.includes('donnee')) return 'Database';
      if (value.includes('hebergement web') || value.includes('frontend')) return 'Frontend';
      if (value.includes('supervision') || value.includes('monitor')) return 'Monitoring';
      if (value.includes('stockage') || value.includes('media')) return 'Storage';
      if (value.includes('domaine') || value === 'dns') return 'Domaine';
      if (value.includes('authentification') || value.includes('identite')) return 'Auth';
      if (value.includes('projet') || value.includes('ticket')) return 'Projet';
      return category || 'Service';
    };
    const stackRisk = (data) => {
      const staleDays = daysSince(data.verifiedAt);
      const stale = staleDays > 60;
      const stackCreatedAt = Number(state.dashboard?.stack?.createdAt || 0);
      const changedSinceStack = stackCreatedAt > 0 && new Date(data.latestChangeAt || 0).getTime() > stackCreatedAt && data.latestChangeTitle && data.latestChangeTitle !== 'Offre vérifiée';
      const criticalAlert = (data.alerts || []).find((alert) => alert.level === 'critique');
      const importantAlert = (data.alerts || []).find((alert) => alert.level === 'important');
      const needsReview = stale || data.status === 'a_verifier' || ['inconclusive', 'controle_requis'].includes(data.verificationState);
      let confidence = 100;
      if (data.overageBilled) confidence -= 35;
      else if (data.cardRequired) confidence -= 16;
      if (stale) confidence -= 16;
      if (data.verificationState === 'inconclusive') confidence -= 10;
      if (data.verificationState === 'controle_requis') confidence -= 18;
      if (data.status === 'a_verifier') confidence -= 12;
      if (criticalAlert) confidence -= 18;
      else if (importantAlert) confidence -= 7;
      confidence = Math.max(0, Math.min(100, confidence));
      if (data.overageBilled) return { confidence, level: 'danger', label: 'Dépassement facturé', priority: 100, reason: `${data.name} est le maillon le plus exposé : un dépassement peut être facturé automatiquement.` };
      if (criticalAlert) return { confidence, level: 'danger', label: 'Alerte critique', priority: 90, reason: `${data.name} présente une alerte critique : ${criticalAlert.label.toLowerCase()}.` };
      if (data.cardRequired) return { confidence, level: 'danger', label: 'Risque modéré', priority: 75, reason: `${data.name} présente le risque de coût le plus élevé : une carte bancaire est requise.` };
      if (needsReview) return { confidence, level: 'warning', label: 'À revérifier', priority: 60 + Math.min(staleDays, 365) / 100, reason: stale ? `${data.name} est le maillon le moins récent : l’offre n’a pas été revérifiée depuis ${staleDays} jours.` : `${data.name} nécessite un nouveau contrôle éditorial.` };
      if (changedSinceStack) return { confidence, level: 'warning', label: 'Offre modifiée', priority: 52, reason: `${data.name} a changé depuis la création de cette stack : ${data.latestChangeTitle.toLowerCase()}.` };
      if (importantAlert) return { confidence, level: 'warning', label: 'Point d’attention', priority: 40, reason: `${data.name} mérite une attention particulière : ${importantAlert.label.toLowerCase()}.` };
      return { confidence, level: 'safe', label: 'Aucun risque', priority: Math.max(0, 20 - Number(data.score || 0) / 10), reason: `${data.name} ne présente aucun risque de facturation identifié.` };
    };
    const renderStackRisk = () => {
      const services = state.stackOfferIds.map((id) => ({ id, data: offer(id) })).filter(({ data }) => data);
      const analyses = services.map(({ id, data }) => ({ id, data, risk: stackRisk(data) }));
      const billing = analyses.filter(({ data }) => data.overageBilled || data.cardRequired).length;
      const review = analyses.filter(({ data }) => daysSince(data.verifiedAt) > 60 || data.status === 'a_verifier' || ['inconclusive', 'controle_requis'].includes(data.verificationState)).length;
      const noCard = analyses.filter(({ data }) => data.cardRequired === false).length;
      const weekAgo = Date.now() - 7 * DAY;
      const critical = analyses.filter(({ data }) => new Date(data.latestChangeAt || 0).getTime() >= weekAgo && (data.alerts || []).some((alert) => alert.level === 'critique')).length;
      const confidence = analyses.length ? Math.round(analyses.reduce((sum, item) => sum + item.risk.confidence, 0) / analyses.length) : null;
      const name = $('#stack-name')?.value || state.dashboard?.stack?.name || 'Ma stack';
      $('#stack-risk-name').textContent = name;
      $('#stack-risk-service-count').textContent = `${services.length} service${services.length > 1 ? 's' : ''}`;
      $('#stack-risk-billing').textContent = String(billing);
      $('#stack-risk-billing').nextElementSibling.textContent = `risque${billing > 1 ? 's' : ''} de facturation`;
      $('#stack-risk-billing').parentElement.dataset.tone = billing ? 'danger' : 'safe';
      $('#stack-risk-review').textContent = String(review);
      $('#stack-risk-review').nextElementSibling.textContent = `offre${review > 1 ? 's' : ''} à revérifier`;
      $('#stack-risk-review').parentElement.dataset.tone = review ? 'warning' : 'safe';
      $('#stack-risk-no-card').textContent = String(noCard);
      $('#stack-risk-no-card').nextElementSibling.textContent = `service${noCard > 1 ? 's' : ''} sans carte`;
      $('#stack-risk-critical').textContent = critical ? String(critical) : 'Aucun';
      $('#stack-risk-critical').parentElement.dataset.tone = critical ? 'danger' : 'safe';
      $('#stack-confidence-score').textContent = confidence == null ? '—' : String(confidence);
      const threat = [...analyses].sort((a, b) => b.risk.priority - a.risk.priority)[0];
      $('#stack-threat-copy').textContent = threat?.risk.reason || 'Ajoutez des services pour obtenir un diagnostic.';
      const threatLink = $('#stack-threat-link'); threatLink.hidden = !threat; if (threat) threatLink.href = offerLink(threat.id);
    };

    const renderStackChips = () => {
      const chips = $('#stack-chips');
      if (!state.stackOfferIds.length) chips.replaceChildren(emptyItem('Ajoutez les services utilisés par votre projet.'));
      else chips.replaceChildren(...state.stackOfferIds.map((id) => {
        const data = offer(id); const name = data.name || id; const risk = stackRisk(data); const item = document.createElement('li'); item.className = 'stack-service-item';
        const role = document.createElement('span'); role.className = 'stack-service-role'; role.textContent = stackRole(data.category);
        const body = document.createElement('span'); body.className = 'stack-service-main'; const title = document.createElement('a'); title.href = offerLink(id); title.textContent = name;
        const summary = document.createElement('small'); summary.textContent = data.freeTier || 'Consultez la fiche pour connaître les conditions de cette offre.'; body.append(title, summary);
        const riskLabel = document.createElement('strong'); riskLabel.className = `stack-service-risk is-${risk.level}`; riskLabel.textContent = risk.label;
        const score = document.createElement('span'); score.className = 'stack-service-score'; score.textContent = data.score == null ? '—' : `${data.score}/100`;
        const button = document.createElement('button'); button.type = 'button'; button.textContent = 'Retirer'; button.setAttribute('aria-label', `Retirer ${name} de la stack`); button.addEventListener('click', async () => { if (!await confirmAction({ title: `Retirer ${name} de la stack ?`, description: 'Le service sera retiré de la sélection en cours. La modification ne deviendra définitive qu’après avoir enregistré la stack.', confirmLabel: 'Retirer' })) return; state.stackOfferIds = state.stackOfferIds.filter((value) => value !== id); renderStackChips(); });
        item.append(role, body, riskLabel, score, button); return item;
      }));
      renderStackRisk();
      updateStackOfferLimit();
    };
    const renderStack = () => {
      const stack = state.dashboard?.stack; state.stackOfferIds = stack?.offerIds ? [...stack.offerIds] : [];
      $('#stack-name').value = stack?.name || 'Ma stack'; $('#stack-delete').hidden = !stack; renderStackChips();
    };

    const renderDigest = () => {
      const root = $('#digest-list'); const items = state.dashboard?.digest || [];
      $('#digest-enabled').checked = Boolean(state.dashboard?.user.digestEnabled);
      $('#digest-email-status').textContent = state.dashboard?.user.emailVerified && state.dashboard?.user.email ? `Digest envoyé à ${state.dashboard.user.email} lorsqu’une offre suivie change.` : 'Aucune adresse e-mail vérifiée n’est disponible : le digest reste visible ici, mais l’envoi par e-mail est suspendu.';
      if (!items.length) { root.replaceChildren(emptyItem('Aucun changement récent parmi vos offres suivies.')); return; }
      root.replaceChildren(...items.map((item) => {
        const data = offer(item.id); const li = document.createElement('li'); li.className = 'account-offer-item account-compact-item account-digest-item';
        const body = document.createElement('div'); body.className = 'account-compact-body';
        const header = document.createElement('header'); const title = document.createElement('a'); title.href = offerLink(item.id); title.textContent = item.name || data.name || item.id; header.append(title);
        if (data.score != null) { const score = document.createElement('strong'); score.className = 'account-offer-score'; score.textContent = `${data.score}/100`; score.setAttribute('aria-label', `Score GratuitPourLesDevs : ${data.score} sur 100`); header.append(score); }
        const metadata = document.createElement('small'); metadata.className = 'account-compact-meta'; metadata.textContent = `${data.category || 'Offre suivie'} · ${item.latestChangeTitle || 'Offre mise à jour'}`;
        const summary = document.createElement('p'); summary.className = 'account-offer-summary'; summary.textContent = item.latestChangeSummary || 'Consultez la fiche pour découvrir les dernières informations vérifiées.';
        const date = document.createElement('time'); date.className = 'account-offer-date'; date.dateTime = item.latestChangeAt || item.verifiedAt || ''; date.textContent = `Mis à jour le ${formatOfferDate(item.latestChangeAt || item.verifiedAt)}`;
        const actions = document.createElement('nav'); actions.className = 'account-compact-actions'; const view = document.createElement('a'); view.href = offerLink(item.id); view.textContent = 'Voir la fiche'; actions.append(view);
        body.append(header, metadata, summary, date); li.append(body, actions); return li;
      }));
    };

    const renderDashboard = () => {
      const data = state.dashboard; if (!data) return;
      $('#account-loading').hidden = true; $('#account-signed-out').hidden = true; $('#account-dashboard').hidden = false; $('#account-login-card').hidden = true; $('#account-profile-card').hidden = false;
      $('#account-name').textContent = data.user.name; $('#account-login-name').textContent = `@${data.user.login} · compte ${data.user.plan === 'pro' ? 'Pro' : 'gratuit'}`; const avatar = $('#account-avatar'); avatar.src = data.user.avatarUrl || ''; avatar.hidden = !data.user.avatarUrl;
      $('#stat-favorites').textContent = String(data.favorites.length);
      $('#stat-follows').textContent = `${data.follows.length} / ${data.limits.follows}`;
      $('#stat-searches').textContent = `${data.savedSearches.length} / ${data.limits.savedSearches}`;
      $('#stat-comparisons').textContent = `${data.savedComparisons.length} / ${data.limits.savedComparisons}`;
      setLimit('#follow-limit', data.follows.length, data.limits.follows); setLimit('#search-limit', data.savedSearches.length, data.limits.savedSearches); setLimit('#comparison-limit', data.savedComparisons.length, data.limits.savedComparisons);
      renderFavorites(); renderOfferList('#follows-list', data.follows, { removable: true, follow: true }); renderSavedList('#searches-list', data.savedSearches, 'searches'); renderSavedList('#comparisons-list', data.savedComparisons, 'comparisons'); renderStack(); renderDigest();
    };

    const renderSignedOut = () => { $('#account-loading').hidden = true; $('#account-dashboard').hidden = true; $('#account-signed-out').hidden = false; $('#account-login-card').hidden = false; $('#account-profile-card').hidden = true; };
    const applyRequestedStackTemplate = async () => {
      if (stackTemplateHandled || !stackTemplateRequest) return;
      stackTemplateHandled = true;
      const { template, action } = stackTemplateRequest;
      history.replaceState({}, '', '/compte/#stack');
      if (!template) { account().showToast('Ce modèle de stack est introuvable.'); return; }
      const existingName = state.dashboard?.stack?.name;
      const description = action === 'add'
        ? existingName ? `Votre stack « ${existingName} » sera remplacée par « ${template.name} ». Vos favoris et votre veille resteront inchangés.` : `« ${template.name} » sera enregistrée comme votre stack. Vous pourrez ensuite modifier chaque service.`
        : existingName ? `Le modèle « ${template.name} » sera chargé dans l’éditeur à la place de « ${existingName} », sans être enregistré tant que vous ne validez pas les modifications.` : `Le modèle « ${template.name} » sera chargé dans l’éditeur sans être enregistré.`;
      const confirmed = await confirmAction({ eyebrow: action === 'add' ? 'AJOUTER UN MODÈLE' : 'ADAPTER UN MODÈLE', title: action === 'add' ? `Ajouter « ${template.name} » ?` : `Adapter « ${template.name} » ?`, description, confirmLabel: action === 'add' ? 'Ajouter la stack' : 'Charger dans l’éditeur' });
      if (!confirmed) return;
      if (action === 'add') {
        try { await account().api('/api/account/stack', { method: 'PUT', body: JSON.stringify({ name: template.name, offerIds: template.offerIds }) }); account().showToast('Stack ajoutée à votre compte.'); await loadDashboard(); }
        catch (error) { account().showToast(error.message || 'Impossible d’ajouter cette stack.'); }
        return;
      }
      state.stackOfferIds = template.offerIds.filter((id) => state.catalogue[id]);
      $('#stack-name').value = template.name;
      renderStackChips();
      $('#stack')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      account().showToast('Modèle chargé. Enregistrez uniquement lorsque votre adaptation est prête.');
    };
    const setupStackOfferSelect = (entries) => {
      const root = document.querySelector('[data-control="stack-offer-select"]');
      const nativeSelect = $('#stack-offer-select');
      const trigger = root?.querySelector('.custom-select-trigger');
      const selectedLabel = root?.querySelector('[data-selected-label]');
      const popover = root?.querySelector('.custom-select-popover');
      const searchInput = root?.querySelector('.custom-select-search input');
      const optionsRoot = root?.querySelector('.custom-select-options');
      const emptyMessage = root?.querySelector('.custom-select-empty');
      if (!root || !nativeSelect || !trigger || !selectedLabel || !popover || !optionsRoot) return null;
      const options = [{ id: '', label: 'Choisir une offre…' }, ...entries.map((item) => ({ id: item.id, label: `${item.name}${item.category ? ` — ${item.category}` : ''}` }))];
      nativeSelect.replaceChildren(...options.map((item) => new Option(item.label, item.id)));
      const optionButtons = options.map((item, index) => {
        const button = document.createElement('button'); button.type = 'button'; button.setAttribute('role', 'option'); button.dataset.value = item.id; button.dataset.optionLabel = item.label; button.setAttribute('aria-selected', String(index === 0));
        const label = document.createElement('span'); label.textContent = item.label; const check = document.createElement('b'); check.setAttribute('aria-hidden', 'true'); check.textContent = '✓'; button.append(label, check); return button;
      });
      optionsRoot.replaceChildren(...optionButtons);
      const close = (restoreFocus = false) => { popover.hidden = true; trigger.setAttribute('aria-expanded', 'false'); if (restoreFocus) trigger.focus(); };
      const filter = () => { const query = normalize(searchInput?.value); let visible = 0; optionButtons.forEach((button) => { const show = normalize(button.dataset.optionLabel).includes(query); button.hidden = !show; if (show) visible++; }); if (emptyMessage) emptyMessage.hidden = visible !== 0; };
      const sync = () => { const selected = optionButtons.find((button) => button.dataset.value === nativeSelect.value) || optionButtons[0]; selectedLabel.textContent = selected?.dataset.optionLabel || ''; optionButtons.forEach((button) => button.setAttribute('aria-selected', String(button === selected))); };
      trigger.addEventListener('click', () => { if (trigger.disabled) return; const opening = popover.hidden; popover.hidden = !opening; trigger.setAttribute('aria-expanded', String(opening)); if (opening) { if (searchInput) searchInput.value = ''; filter(); (searchInput || optionButtons[0])?.focus(); } });
      optionButtons.forEach((button) => button.addEventListener('click', () => { nativeSelect.value = button.dataset.value || ''; nativeSelect.dispatchEvent(new Event('change', { bubbles: true })); sync(); close(true); }));
      searchInput?.addEventListener('input', filter);
      root.addEventListener('keydown', (event) => { if (event.key === 'Escape') close(true); });
      nativeSelect.addEventListener('change', sync);
      document.addEventListener('click', (event) => { if (!event.target.closest('[data-control="stack-offer-select"]')) close(); });
      sync();
      return {
        reset() { nativeSelect.value = ''; if (searchInput) searchInput.value = ''; filter(); sync(); close(); },
        setDisabled(disabled) { trigger.disabled = disabled; trigger.setAttribute('aria-disabled', String(disabled)); if (disabled) close(); },
      };
    };
    const loadCatalogue = async () => { const response = await fetch('/offres.json?v=20260901-stack-risk-dashboard', { headers: { Accept: 'application/json' } }); const payload = await response.json(); state.catalogue = payload.catalogue || {}; state.quotas = payload.quotas || {}; const entries = Object.values(state.catalogue).sort((a,b) => (a.name || '').localeCompare(b.name || '', 'fr')); stackOfferSelect = setupStackOfferSelect(entries); };
    const loadDashboard = async () => {
      if (!account()?.getToken()) { renderSignedOut(); return; }
      $('#account-loading').hidden = false;
      try { state.dashboard = await account().api('/api/account/dashboard'); renderDashboard(); await applyRequestedStackTemplate(); }
      catch (error) { if (error.status === 401) renderSignedOut(); else { $('#account-loading').textContent = error.message || 'Impossible de charger votre espace.'; } }
    };
    const login = async () => { try { await account().login({ redirect: true }); await loadDashboard(); } catch (error) { account().showToast(error.message || 'Connexion impossible.'); } };
    $('#account-login')?.addEventListener('click', login); $('#account-login-secondary')?.addEventListener('click', login); $('#account-refresh')?.addEventListener('click', loadDashboard);
    const favoritePreviewIds = () => [...(state.dashboard?.favorites || [])].reverse().slice(0, FAVORITES_PREVIEW_SIZE);
    $('#favorites-previous')?.addEventListener('click', () => {
      const ids = favoritePreviewIds(); if (!ids.length) return;
      state.favoritesIndex = (state.favoritesIndex - 1 + ids.length) % ids.length; renderFavorites();
    });
    $('#favorites-next')?.addEventListener('click', () => {
      const ids = favoritePreviewIds(); if (!ids.length) return;
      state.favoritesIndex = (state.favoritesIndex + 1) % ids.length; renderFavorites();
    });
    $('#account-logout')?.addEventListener('click', async () => { if (!await confirmAction({ title: 'Se déconnecter ?', description: 'Vos favoris, votre veille et votre stack resteront enregistrés dans votre compte.', confirmLabel: 'Se déconnecter' })) return; await account().logout(); renderSignedOut(); });
    $('#stack-add')?.addEventListener('click', () => { const id = $('#stack-offer-select').value; if (!id) return; if (state.stackOfferIds.includes(id)) { account().showToast('Cette offre est déjà présente dans votre stack.'); return; } const limit = Number(state.dashboard?.limits?.stackOffers || 10); if (state.dashboard?.user?.plan !== 'pro' && state.stackOfferIds.length >= limit) { account().showToast(`La stack gratuite accepte jusqu’à ${limit} offres.`, { pro: true }); return; } state.stackOfferIds.push(id); renderStackChips(); stackOfferSelect?.reset(); });
    $('#stack-name')?.addEventListener('input', renderStackRisk);
    $('#stack-save')?.addEventListener('click', async () => { try { await account().api('/api/account/stack', { method: 'PUT', body: JSON.stringify({ name: $('#stack-name').value, offerIds: state.stackOfferIds }) }); account().showToast('Stack enregistrée.'); await loadDashboard(); } catch (error) { if (error.payload?.code === 'free_limit' && error.payload?.feature === 'stackOffers') account().showToast(`La stack gratuite accepte jusqu’à ${error.payload.limit || 10} offres.`, { pro: true }); else if (error.payload?.code === 'free_limit') account().showToast('Le compte gratuit contient une stack.', { pro: true }); else account().showToast(error.message || 'Impossible d’enregistrer la stack.'); } });
    $('#stack-delete')?.addEventListener('click', async () => { const name = state.dashboard?.stack?.name || 'Ma stack'; if (!await confirmAction({ eyebrow: 'SUPPRESSION', title: `Supprimer « ${name} » ?`, description: 'La stack et sa sélection de services seront supprimées. Vos favoris et les offres suivies resteront inchangés.', confirmLabel: 'Supprimer' })) return; try { await account().api('/api/account/stack', { method: 'DELETE' }); await loadDashboard(); } catch (error) { account().showToast(error.message || 'Suppression impossible.'); } });
    $('#digest-enabled')?.addEventListener('change', async (event) => { try { await account().api('/api/account/preferences', { method: 'POST', body: JSON.stringify({ digestEnabled: event.target.checked }) }); await loadDashboard(); } catch (error) { account().showToast(error.message || 'Préférence non enregistrée.'); } });
    $('#pro-interest')?.addEventListener('click', async (event) => { const button = event.currentTarget; try { await account().api('/api/account/pro-interest', { method: 'POST' }); button.textContent = '✓ Intérêt enregistré'; button.classList.add('is-recorded'); account().showToast('Merci — cet intérêt sera mesuré avant de décider du lancement de Pro.'); } catch (error) { account().showToast(error.message || 'Impossible d’enregistrer votre intérêt.'); } });
    const scrollToRequestedSection = () => {
      const target = location.hash === '#stack' ? $('#stack') : location.hash === '#pro' ? $('#pro') : null;
      if (!target || target.closest('[hidden]')) return;
      requestAnimationFrame(() => requestAnimationFrame(() => target.scrollIntoView({ block: 'start' })));
    };
    const init = async () => { await loadCatalogue().catch(() => {}); await loadDashboard(); scrollToRequestedSection(); };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true }); else void init();
  </script>
</BaseLayout>
