---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CustomSelect from '../components/CustomSelect.astro';

const entries = (await getCollection('offres'))
  .filter(({ data }) => data.statut !== 'obsolete')
  .sort((a, b) => a.data.ordre - b.data.ordre);
const offers = await Promise.all(entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })));
const categories = (await getCollection('categories'))
  .filter(({ data }) => data.actif)
  .sort((a, b) => a.data.ordre - b.data.ordre);
const categoryNames = new Map(categories.map((category) => [category.id, category.data.nom]));
const serviceModels = [...new Set(entries.map(({ data }) => data.type))].sort((a, b) => a.localeCompare(b, 'fr'));
const categoryOptions = [{ value: '', label: 'Toutes les catégories' }, ...categories
  .map((category) => ({ value: category.id, label: category.data.nom }))
  .sort((a, b) => a.label.localeCompare(b.label, 'fr'))];
const modelOptions = [{ value: '', label: 'Tous les modèles' }, ...serviceModels.map((model) => ({ value: model, label: model }))];
const cardOptions = [{ value: '', label: 'Indifférent' }, { value: 'true', label: 'Carte requise' }, { value: 'false', label: 'Sans carte' }];
const permanenceOptions = [{ value: '', label: 'Indifférent' }, { value: 'false', label: 'Essai limité' }, { value: 'true', label: 'Formule permanente' }];
const verificationOptions = [{ value: '', label: 'Indifférent' }, { value: '31-90', label: 'De 31 à 90 jours' }, { value: '0-30', label: 'Moins de 30 jours' }, { value: '90+', label: 'Plus de 90 jours' }];
const activeOffers = entries.filter(({ data }) => data.statut === 'active').length;
const coveredCategories = new Set(entries.map(({ data }) => data.categorie)).size;
const withoutCard = entries.filter(({ data }) => !data.carteRequise).length;
const latestVerification = new Date(Math.max(...entries.map(({ data }) => data.verifieLe.getTime())));
const latestVerificationLabel = latestVerification.toLocaleDateString('fr-FR', { day: '2-digit', month: 'short' }).replace('.', '');
---

<BaseLayout>
  <header class="site-header">
    <a class="brand" href="/" aria-label="Gratuit pour les devs, accueil">
      <svg viewBox="0 0 40 40" aria-hidden="true"><path d="m4 13 16-9 16 9-16 9L4 13Zm0 9 16 9 16-9M4 31l16 9 16-9" /></svg>
      <span>Gratuit<span>PourLesDevs</span></span>
    </a>
    <nav aria-label="Navigation principale"><a class="active" href="#catalogue">Catalogue</a><a href="/archives/">Archives</a><a href="#methode">À propos</a></nav>
    <a class="outline-button" href="https://github.com/GratuitPourLesDevs/gratuitpourlesdevs.github.io/issues/new" target="_blank" rel="noreferrer">Suggérer un outil</a>
  </header>

  <main>
    <section class="hero">
      <div class="network" aria-hidden="true"><i class="n1"></i><i class="n2"></i><i class="n3"></i><i class="n4"></i><i class="n5"></i></div>
      <div class="hero-copy">
        <h1>Les bons outils.<br />Avant la facture.</h1>
        <p>Une sélection claire de services cloud avec une vraie formule gratuite, vérifiée pour les équipes DevOps et Infradev.</p>
      </div>
      <aside class="hero-kpis" aria-label="Indicateurs du catalogue">
        <div><strong>{activeOffers}</strong><span>offres actives</span></div>
        <div><strong>{coveredCategories}</strong><span>catégories couvertes</span></div>
        <div><strong>{withoutCard}</strong><span>sans carte bancaire</span></div>
        <div><strong>{latestVerificationLabel}</strong><span>dernière vérification</span></div>
      </aside>
    </section>

    <section class="catalogue" id="catalogue">
      <label class="search-shell">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16 16 5 5"/></svg>
        <span class="sr-only">Rechercher dans le catalogue</span>
        <input id="search" type="search" placeholder="Rechercher un outil, une catégorie, une limite…" autocomplete="off" />
        <kbd>⌘ K</kbd>
      </label>

      <section class="advanced-filters" aria-labelledby="filter-title">
        <div class="section-intro compact"><div><h2 id="filter-title">Affiner les résultats</h2><p>Combinez catégorie, modèle et conditions de l’offre.</p></div></div>
        <div class="filter-grid">
          <CustomSelect id="category-filter" label="Catégorie" options={categoryOptions} searchable />
          <CustomSelect id="type-filter" label="Modèle de service" options={modelOptions} />
          <CustomSelect id="card-filter" label="Carte bancaire" options={cardOptions} />
          <CustomSelect id="permanent-filter" label="Permanence" options={permanenceOptions} />
          <CustomSelect id="verification-filter" label="Date de vérification" options={verificationOptions} />
          <button class="reset" type="button">Réinitialiser</button>
        </div>
      </section>

      <div class="catalogue-heading">
        <h2><span id="result-count">{offers.length}</span> offres vérifiées</h2>
        <label>Trier par&nbsp;:<select id="sort"><option value="categorie">Catégorie</option><option value="verification">Date de vérification</option><option value="type">Modèle</option><option value="nom">Nom</option><option value="pertinence" selected>Pertinence</option></select></label>
      </div>

      <div class="offers-table" role="table" aria-label="Offres gratuites">
        <div class="table-head" role="row"><span>Outil et catégorie</span><span>Formule gratuite</span><span>Conditions</span><span>Actions</span></div>
        <div id="offers-list">
          {offers.map(({ entry, Content }) => (
            <article class="offer-row" role="row" tabindex="0" aria-expanded="false"
              data-name={entry.data.nom.toLocaleLowerCase('fr')} data-type={entry.data.type}
              data-category={entry.data.categorie} data-card={String(entry.data.carteRequise)} data-permanent={String(entry.data.permanent)} data-verified={entry.data.verifieLe.getTime()}
              data-category-name={categoryNames.get(entry.data.categorie) ?? entry.data.categorie}
              data-search={`${entry.data.nom} ${entry.data.accroche} ${entry.data.formule} ${categoryNames.get(entry.data.categorie) ?? ''} ${entry.data.type} ${entry.data.usages.join(' ')} ${entry.data.inclus.join(' ')} ${entry.data.conditions.join(' ')} ${entry.data.restrictions.join(' ')} ${entry.body ?? ''}`.toLocaleLowerCase('fr')}
              data-order={entry.data.ordre}>
              <div class="offer-identity">
                <span class="offer-logo" style={`--logo-color:${entry.data.couleur}`}>{entry.data.initiales}</span>
                <span><small class="offer-category">{categoryNames.get(entry.data.categorie) ?? entry.data.categorie}</small><strong>{entry.data.nom}</strong><span class="identity-meta"><small>{entry.data.accroche}</small><em>{entry.data.type}</em></span></span>
              </div>
              <p class="offer-plan"><strong>{entry.data.formule}</strong><small>{entry.data.usages.slice(0, 3).join(' · ')}</small></p>
              <div class="offer-status"><span class:list={{ positive: !entry.data.carteRequise }}>{entry.data.carteRequise ? 'Carte requise' : 'Sans carte'}</span><small>{entry.data.permanent ? 'Formule permanente' : 'Essai limité'}</small>{entry.data.statut === 'a_verifier' && <small class="needs-review">À vérifier</small>}</div>
              <div class="offer-actions">
                <button class="favorite" type="button" aria-label={`Ajouter ${entry.data.nom} aux favoris`} data-id={entry.id}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6-5.4-2.8-5.4 2.8 1-6-4.4-4.3 6.1-.9L12 3Z"/></svg></button>
                <button class="expand-offer" type="button" aria-label={`Afficher le détail de ${entry.data.nom}`} aria-expanded="false" aria-controls={`detail-${entry.id}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg></button>
              </div>
              <div class="offer-detail" id={`detail-${entry.id}`}>
                <section><h3>Ce qui est inclus</h3><ul>{entry.data.inclus.map((item) => <li>{item}</li>)}</ul></section>
                <section><h3>Conditions</h3><ul>{entry.data.conditions.map((item) => <li>{item}</li>)}</ul></section>
                <section><h3>Restrictions</h3><ul>{entry.data.restrictions.map((item) => <li>{item}</li>)}</ul></section>
                <section class="why-useful"><h3>Pourquoi c’est utile</h3><Content /></section>
                <div class="detail-footer"><span class="verified-date"><b>✓</b> Vérifié le {entry.data.verifieLe.toLocaleDateString('fr-FR')}</span><nav aria-label={`Liens pour ${entry.data.nom}`}><a href={entry.data.url} target="_blank" rel="noreferrer">Site officiel ↗</a>{entry.data.documentation && <a href={entry.data.documentation} target="_blank" rel="noreferrer">Documentation ↗</a>}<a href={entry.data.source} target="_blank" rel="noreferrer">Source tarifaire ↗</a></nav></div>
              </div>
            </article>
          ))}
        </div>
        <div class="empty-state" id="empty-state" hidden>Aucune offre ne correspond à ces critères.</div>
      </div>
    </section>
  </main>

  <footer id="methode">
    <div class="verified-mark"><svg viewBox="0 0 32 36" aria-hidden="true"><path d="M16 2 29 7v10c0 8-5 14-13 17C8 31 3 25 3 17V7l13-5Z"/><path d="m10 18 4 4 8-9"/></svg><span><strong>Vérifié en août 2026</strong><small>Chaque quota renvoie vers sa source officielle.</small></span></div>
    <nav aria-label="Navigation secondaire"><a href="/archives/">Archives</a><a href="#methode">Méthodologie</a><a href="https://github.com/GratuitPourLesDevs/gratuitpourlesdevs.github.io/issues/new" target="_blank" rel="noreferrer">Signaler une erreur</a><a href="mailto:julien.taverne+gratuitpourlesdevs@gmail.com">Contact</a></nav>
    <span class="terminal-mark" aria-hidden="true">›_</span>
  </footer>

  <script>
    const search = document.querySelector<HTMLInputElement>('#search');
    const categorySelect = document.querySelector<HTMLSelectElement>('#category-filter');
    const typeSelect = document.querySelector<HTMLSelectElement>('#type-filter');
    const cardSelect = document.querySelector<HTMLSelectElement>('#card-filter');
    const permanentSelect = document.querySelector<HTMLSelectElement>('#permanent-filter');
    const verificationSelect = document.querySelector<HTMLSelectElement>('#verification-filter');
    const rows = [...document.querySelectorAll<HTMLElement>('.offer-row')];
    const list = document.querySelector<HTMLElement>('#offers-list');
    const count = document.querySelector<HTMLElement>('#result-count');
    const empty = document.querySelector<HTMLElement>('#empty-state');
    const sort = document.querySelector<HTMLSelectElement>('#sort');
    const normalize = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    const customSelects = [...document.querySelectorAll<HTMLElement>('.custom-select-field')];
    const closeCustomSelect = (root: HTMLElement, restoreFocus = false) => {
      const trigger = root.querySelector<HTMLButtonElement>('.custom-select-trigger');
      const popover = root.querySelector<HTMLElement>('.custom-select-popover');
      if (!trigger || !popover) return;
      popover.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
      if (restoreFocus) trigger.focus();
    };
    const closeOtherSelects = (current?: HTMLElement) => customSelects.forEach((root) => { if (root !== current) closeCustomSelect(root); });
    customSelects.forEach((root) => {
      const nativeSelect = root.querySelector<HTMLSelectElement>('.native-filter-control');
      const trigger = root.querySelector<HTMLButtonElement>('.custom-select-trigger');
      const selectedLabel = root.querySelector<HTMLElement>('[data-selected-label]');
      const popover = root.querySelector<HTMLElement>('.custom-select-popover');
      const searchInput = root.querySelector<HTMLInputElement>('.custom-select-search input');
      const options = [...root.querySelectorAll<HTMLButtonElement>('[role="option"]')];
      const emptyMessage = root.querySelector<HTMLElement>('.custom-select-empty');
      if (!nativeSelect || !trigger || !selectedLabel || !popover) return;
      const sync = () => {
        const selected = options.find((option) => option.dataset.value === nativeSelect.value) ?? options[0];
        selectedLabel.textContent = selected?.dataset.optionLabel ?? '';
        options.forEach((option) => option.setAttribute('aria-selected', String(option === selected)));
      };
      trigger.addEventListener('click', () => {
        const opening = popover.hidden;
        closeOtherSelects(root);
        popover.hidden = !opening;
        trigger.setAttribute('aria-expanded', String(opening));
        if (opening) (searchInput ?? options[0])?.focus();
      });
      options.forEach((option) => option.addEventListener('click', () => {
        nativeSelect.value = option.dataset.value ?? '';
        nativeSelect.dispatchEvent(new Event('change', { bubbles: true }));
        sync();
        closeCustomSelect(root, true);
      }));
      searchInput?.addEventListener('input', () => {
        const query = normalize(searchInput.value); let visible = 0;
        options.forEach((option) => { const show = normalize(option.dataset.optionLabel ?? '').includes(query); option.hidden = !show; if (show) visible++; });
        if (emptyMessage) emptyMessage.hidden = visible !== 0;
      });
      root.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeCustomSelect(root, true); });
      nativeSelect.addEventListener('change', sync);
      sync();
    });
    document.addEventListener('click', (event) => { if (!(event.target as HTMLElement).closest('.custom-select-field')) closeOtherSelects(); });
    const refresh = () => {
      const query = normalize(search?.value ?? ''); let visible = 0;
      rows.forEach((row) => {
        const ageInDays = Math.max(0, (Date.now() - Number(row.dataset.verified)) / 86_400_000);
        const matchesVerification = !verificationSelect?.value
          || (verificationSelect.value === '0-30' && ageInDays <= 30)
          || (verificationSelect.value === '31-90' && ageInDays > 30 && ageInDays <= 90)
          || (verificationSelect.value === '90+' && ageInDays > 90);
        const show = normalize(row.dataset.search ?? '').includes(query)
          && (!categorySelect?.value || row.dataset.category === categorySelect.value)
          && (!typeSelect?.value || row.dataset.type === typeSelect.value)
          && (!cardSelect?.value || row.dataset.card === cardSelect.value)
          && (!permanentSelect?.value || row.dataset.permanent === permanentSelect.value)
          && matchesVerification;
        row.hidden = !show; if (show) visible++;
      });
      if (count) count.textContent = String(visible); if (empty) empty.hidden = visible !== 0;
    };
    search?.addEventListener('input', refresh);
    document.addEventListener('keydown', (event) => { if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); search?.focus(); } if (event.key === 'Escape' && document.activeElement === search) search?.blur(); });
    [categorySelect, typeSelect, cardSelect, permanentSelect, verificationSelect].forEach((select) => select?.addEventListener('change', refresh));
    document.querySelector('.reset')?.addEventListener('click', () => { if (search) search.value = ''; [categorySelect, typeSelect, cardSelect, permanentSelect, verificationSelect].forEach((select) => { if (select) { select.value = ''; select.dispatchEvent(new Event('change', { bubbles: true })); } }); closeOtherSelects(); refresh(); });
    sort?.addEventListener('change', () => { rows.sort((a, b) => sort.value === 'nom' ? (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '', 'fr') : sort.value === 'categorie' ? (a.dataset.categoryName ?? '').localeCompare(b.dataset.categoryName ?? '', 'fr') : sort.value === 'type' ? (a.dataset.type ?? '').localeCompare(b.dataset.type ?? '', 'fr') : sort.value === 'verification' ? Number(b.dataset.verified) - Number(a.dataset.verified) : Number(a.dataset.order) - Number(b.dataset.order)).forEach((row) => list?.append(row)); });
    const setRowExpanded = (row: HTMLElement, expanded: boolean) => {
      const button = row.querySelector<HTMLButtonElement>('.expand-offer');
      const offerName = row.querySelector('strong')?.textContent ?? 'l’offre';
      row.classList.toggle('expanded', expanded);
      row.setAttribute('aria-expanded', String(expanded));
      button?.setAttribute('aria-expanded', String(expanded));
      button?.setAttribute('aria-label', `${expanded ? 'Masquer' : 'Afficher'} le détail de ${offerName}`);
    };
    rows.forEach((row) => {
      row.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('a, button, input, select')) return;
        setRowExpanded(row, !row.classList.contains('expanded'));
      });
      row.addEventListener('keydown', (event) => {
        if (event.target !== row || (event.key !== 'Enter' && event.key !== ' ')) return;
        event.preventDefault();
        setRowExpanded(row, !row.classList.contains('expanded'));
      });
    });
    document.querySelectorAll<HTMLButtonElement>('.expand-offer').forEach((button) => button.addEventListener('click', () => { const row = button.closest<HTMLElement>('.offer-row'); if (row) setRowExpanded(row, !row.classList.contains('expanded')); }));
    const saved = new Set<string>(JSON.parse(localStorage.getItem('gpld-favorites') ?? '[]'));
    document.querySelectorAll<HTMLButtonElement>('.favorite').forEach((button) => { const id = button.dataset.id ?? ''; button.classList.toggle('active', saved.has(id)); button.addEventListener('click', () => { saved.has(id) ? saved.delete(id) : saved.add(id); button.classList.toggle('active', saved.has(id)); localStorage.setItem('gpld-favorites', JSON.stringify([...saved])); }); });
  </script>
</BaseLayout>
