    const toggleAdvancedFilters = () => {
      if (!advancedFiltersPanel || !advancedFiltersToggle) return;
      const opening = advancedFiltersPanel.hidden;
      advancedFiltersPanel.hidden = !opening;
      advancedFiltersToggle.setAttribute('aria-expanded', String(opening));
      if (!opening) { closeOtherSelects(); closeTagSuggestions(); }
    };
    const refresh = (resetPage = true) => {
      const query = normalize(search?.value ?? '');
      filteredRows = [];
      rows.forEach((row) => {
        const ageInDays = Math.max(0, (Date.now() - Number(row.dataset.verified)) / 86_400_000);
        const matchesVerification = !verificationSelect?.value
          || (verificationSelect.value === '0-30' && ageInDays <= 30)
          || (verificationSelect.value === '31-90' && ageInDays > 30 && ageInDays <= 90)
          || (verificationSelect.value === '90+' && ageInDays > 90);
        const show = normalize(row.dataset.search ?? '').includes(query)
          && (!categorySelect?.value || row.dataset.category === categorySelect.value)
          && (!typeSelect?.value || row.dataset.type === typeSelect.value)
          && (!cardSelect?.value || row.dataset.card === cardSelect.value)
          && (!permanentSelect?.value || row.dataset.permanent === permanentSelect.value)
          && (!quickFilters.has('score') || Number(row.dataset.score) >= 85)
          && (!quickFilters.has('risk') || row.dataset.risk === 'none')
          && (!favoritesOnly || saved.has(row.dataset.id ?? ''))
          && [...selectedTags].every((tag) => rowUsages.get(row)?.includes(normalize(tag)))
          && matchesVerification;
        if (show) filteredRows.push(row);
      });
      if (resetPage) currentPage = 1;
      if (count) count.textContent = String(filteredRows.length); if (empty) empty.hidden = filteredRows.length !== 0;
      renderPagination();
    };
    search?.addEventListener('input', () => refresh());
    document.addEventListener('keydown', (event) => { if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); search?.focus(); } if (event.key === 'Escape' && document.activeElement === search) search?.blur(); });
    advancedSelects.forEach((select) => select?.addEventListener('change', () => { renderQuickFilters(); renderAdvancedFilterCount(); refresh(); }));
    quickFilterButtons.forEach((button) => button.addEventListener('click', () => {
      const filter = button.dataset.quickFilter ?? '';
      const select = filter === 'card' ? cardSelect : filter === 'permanent' ? permanentSelect : filter === 'recent' ? verificationSelect : null;
      if (select) {
        const activeValue = filter === 'card' ? 'false' : filter === 'permanent' ? 'true' : '0-30';
        select.value = select.value === activeValue ? '' : activeValue;
        select.dispatchEvent(new Event('change', { bubbles: true }));
      } else {
        quickFilters.has(filter) ? quickFilters.delete(filter) : quickFilters.add(filter);
        renderQuickFilters();
        refresh();
      }
    }));
    advancedFiltersToggle?.addEventListener('click', toggleAdvancedFilters);
    const renderFavoritesFilter = () => {
      if (!favoritesFilter) return;
      favoritesFilter.classList.toggle('active', favoritesOnly);
      favoritesFilter.setAttribute('aria-pressed', String(favoritesOnly));
      const label = favoritesOnly ? 'Afficher toutes les offres' : 'Afficher uniquement les favoris';
      favoritesFilter.setAttribute('aria-label', label);
      favoritesFilter.title = label;
      if (favoritesFilterIndicator) favoritesFilterIndicator.hidden = !favoritesOnly;
    };
    favoritesFilter?.addEventListener('click', () => { favoritesOnly = !favoritesOnly; renderFavoritesFilter(); refresh(); });
    favoritesFilterIndicator?.addEventListener('click', () => { favoritesOnly = false; renderFavoritesFilter(); refresh(); });
    document.querySelector('.reset')?.addEventListener('click', () => { if (search) search.value = ''; if (tagInput) tagInput.value = ''; favoritesOnly = false; quickFilters.clear(); renderFavoritesFilter(); selectedTags.clear(); renderSelectedTags(); closeTagSuggestions(); advancedSelects.forEach((select) => { if (select) { select.value = ''; select.dispatchEvent(new Event('change', { bubbles: true })); } }); renderQuickFilters(); renderAdvancedFilterCount(); closeOtherSelects(); refresh(); });
    const sortRows = (resetPage = true) => {
      if (!sort || !sortDirection) return;
      const direction = sortDirection.dataset.direction === 'asc' ? 1 : -1;
      rows.sort((a, b) => {
        const comparison = sort.value === 'nom'
          ? (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '', 'fr')
          : sort.value === 'categorie'
            ? (a.dataset.categoryName ?? '').localeCompare(b.dataset.categoryName ?? '', 'fr')
            : sort.value === 'type'
              ? (a.dataset.type ?? '').localeCompare(b.dataset.type ?? '', 'fr')
              : sort.value === 'verification'
                ? Number(a.dataset.verified) - Number(b.dataset.verified)
                : sort.value === 'score'
                  ? Number(a.dataset.score) - Number(b.dataset.score)
                : sort.value === 'recent'
                  ? Number(a.dataset.updated) - Number(b.dataset.updated)
                  : Number(a.dataset.order) - Number(b.dataset.order);
        return comparison * direction || Number(a.dataset.order) - Number(b.dataset.order);
      }).forEach((row) => list?.append(row));
      refresh(resetPage);
    };
    const setSortDirection = (direction: 'asc' | 'desc') => {
      if (!sortDirection) return;
      const descending = direction === 'desc';
      sortDirection.dataset.direction = direction;
      sortDirection.querySelector('span')!.textContent = descending ? '↓' : '↑';
      const label = descending ? 'Tri décroissant — passer en ordre croissant' : 'Tri croissant — passer en ordre décroissant';
      sortDirection.setAttribute('aria-label', label);
      sortDirection.title = label;
    };
    sort?.addEventListener('change', () => { setSortDirection(sort.value === 'recent' || sort.value === 'verification' || sort.value === 'score' ? 'desc' : 'asc'); sortRows(); });
    sortDirection?.addEventListener('click', () => { setSortDirection(sortDirection.dataset.direction === 'asc' ? 'desc' : 'asc'); sortRows(); });
    renderQuickFilters();
    renderAdvancedFilterCount();
    previousPage?.addEventListener('click', () => { if (currentPage > 1) { currentPage--; renderPagination(); } });
    nextPage?.addEventListener('click', () => { if (currentPage * pageSize < filteredRows.length) { currentPage++; renderPagination(); } });
    const setRowExpanded = (row: HTMLElement, expanded: boolean) => {
      const button = row.querySelector<HTMLButtonElement>('.expand-offer');
      const offerName = row.querySelector('strong')?.textContent ?? 'l’offre';
      row.classList.toggle('expanded', expanded);
      row.setAttribute('aria-expanded', String(expanded));
      button?.setAttribute('aria-expanded', String(expanded));
      button?.setAttribute('aria-label', `${expanded ? 'Masquer' : 'Afficher'} le détail de ${offerName}`);
    };
    rows.forEach((row) => {
      row.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('a, button, input, select')) return;
        setRowExpanded(row, !row.classList.contains('expanded'));
      });
      row.addEventListener('keydown', (event) => {
        if (event.target !== row || (event.key !== 'Enter' && event.key !== ' ')) return;
        event.preventDefault();
        setRowExpanded(row, !row.classList.contains('expanded'));
      });
    });
    document.querySelectorAll<HTMLButtonElement>('.expand-offer').forEach((button) => button.addEventListener('click', () => { const row = button.closest<HTMLElement>('.offer-row'); if (row) setRowExpanded(row, !row.classList.contains('expanded')); }));
    document.querySelectorAll<HTMLButtonElement>('.favorite').forEach((button) => {
      const id = button.dataset.id ?? '';
      const offerName = button.closest<HTMLElement>('.offer-row')?.querySelector('.offer-identity strong')?.textContent ?? 'cette offre';
      const renderFavorite = () => {
        const active = saved.has(id);
        button.classList.toggle('active', active);
        button.setAttribute('aria-label', `${active ? 'Retirer' : 'Ajouter'} ${offerName} ${active ? 'des' : 'aux'} favoris`);
      };
      renderFavorite();
      button.addEventListener('click', () => {
        saved.has(id) ? saved.delete(id) : saved.add(id);
        renderFavorite();
        localStorage.setItem('gpld-favorites', JSON.stringify([...saved]));
        if (favoritesOnly) refresh();
      });
    });
    renderFavoritesFilter();
    const requestedCategory = comparisonParams.get('category');
    if (requestedCategory && categorySelect && [...categorySelect.options].some((option) => option.value === requestedCategory)) {
      categorySelect.value = requestedCategory;
      categorySelect.dispatchEvent(new Event('change', { bubbles: true }));
    }
    const requestedUsage = comparisonParams.get('usage');
    if (requestedUsage) {
      const requestedUsageOption = tagOptions.find((option) => normalize(option.dataset.optionLabel ?? option.textContent ?? '') === normalize(requestedUsage));
      const canonicalUsage = requestedUsageOption?.dataset.optionLabel ?? requestedUsageOption?.textContent?.trim();
      if (canonicalUsage) selectedTags.add(canonicalUsage);
      renderSelectedTags();
    }
    setSortDirection('desc');
    sortRows(false);
  </script>
</BaseLayout>
