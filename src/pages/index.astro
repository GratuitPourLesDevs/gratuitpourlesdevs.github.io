---
import { getCollection, render } from 'astro:content';
import { execFileSync } from 'node:child_process';
import BaseLayout from '../layouts/BaseLayout.astro';
import CustomSelect from '../components/CustomSelect.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getBillingRisk } from '../data/billing-risk';
import { getFreeTierScore } from '../data/free-tier-score';
import { OFFER_ALERT_ICONS } from '../data/offer-alerts';
import { getGeneratedOfferEditorial, getOfferSwitchLimit } from '../data/offer-editorial';
import { assertOfferQuotaCoverage, formatQuotaAmount, formatQuotaMetric, formatQuotaOverage, formatQuotaPeriod, formatQuotaReset, formatQuotaScope, getComparableQuotaValue, getOfferQuotas, getQuotaComparisonKey } from '../data/offer-quotas';
import { getOffersUpdatedMetadata } from '../lib/offers-updated';

const offerChangeDates = new Map<string, number>();
try {
  const history = execFileSync('git', ['log', '--format=@@%ct', '--name-only', '--', 'src/content/offres'], { encoding: 'utf8' });
  let commitTimestamp = 0;
  history.split(/\r?\n/).forEach((line) => {
    if (line.startsWith('@@')) commitTimestamp = Number(line.slice(2)) * 1000;
    else if (line.startsWith('src/content/offres/') && commitTimestamp && !offerChangeDates.has(line)) offerChangeDates.set(line, commitTimestamp);
  });
} catch {
  // La date de vérification sert de repli lorsque l’historique Git n’est pas disponible.
}

const entries = (await getCollection('offres'))
  .filter(({ data }) => data.statut !== 'obsolete')
  .sort((a, b) => a.data.ordre - b.data.ordre);
const offers = await Promise.all(entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content, editorial: getGeneratedOfferEditorial(entry.id, entry.data) })));
const categories = (await getCollection('categories'))
  .filter(({ data }) => data.actif)
  .sort((a, b) => a.data.ordre - b.data.ordre);
const categoryNames = new Map(categories.map((category) => [category.id, category.data.nom]));
const serviceModels = [...new Set(entries.map(({ data }) => data.type))].sort((a, b) => a.localeCompare(b, 'fr'));
const categoryOptions = [{ value: '', label: 'Toutes les catégories' }, ...categories
  .map((category) => ({ value: category.id, label: category.data.nom }))
  .sort((a, b) => a.label.localeCompare(b.label, 'fr'))];
const modelOptions = [{ value: '', label: 'Tous les modèles' }, ...serviceModels.map((model) => ({ value: model, label: model }))];
const cardOptions = [{ value: '', label: 'Indifférent' }, { value: 'true', label: 'Carte requise' }, { value: 'false', label: 'Sans carte' }];
const permanenceOptions = [{ value: '', label: 'Indifférent' }, { value: 'false', label: 'Essai limité' }, { value: 'true', label: 'Formule permanente' }];
const verificationOptions = [{ value: '', label: 'Indifférent' }, { value: '31-90', label: 'De 31 à 90 jours' }, { value: '0-30', label: 'Moins de 30 jours' }, { value: '90+', label: 'Plus de 90 jours' }];
const usageTags = [...new Map(entries
  .flatMap(({ data }) => data.usages)
  .map((tag) => [tag.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('fr'), tag])).values()]
  .sort((a, b) => a.localeCompare(b, 'fr'));
const activeOffers = entries.filter(({ data }) => data.statut === 'active').length;
const coveredCategories = new Set(entries.map(({ data }) => data.categorie)).size;
const withoutCard = entries.filter(({ data }) => !data.carteRequise).length;
const offersUpdated = await getOffersUpdatedMetadata();
const getOfferChangeDate = (entry: typeof entries[number]) => offerChangeDates.get(`src/content/offres/${entry.id}.md`) ?? entry.data.verifieLe.getTime();
const scoreById = new Map(entries.map((entry) => [entry.id, getFreeTierScore(entry.id, entry.data)]));
assertOfferQuotaCoverage(entries.map((entry) => entry.id));
const comparisonPayload = JSON.stringify(entries.map((entry) => ({
  id: entry.id,
  name: entry.data.nom,
  tagline: entry.data.accroche,
  initials: entry.data.initiales,
  color: entry.data.couleur,
  category: categoryNames.get(entry.data.categorie) ?? entry.data.categorie,
  type: entry.data.type,
  plan: entry.data.formule,
  cardRequired: entry.data.carteRequise,
  billingRisk: getBillingRisk(entry.data).label,
  freeTierScore: scoreById.get(entry.id)?.total ?? 0,
  permanent: entry.data.permanent,
  usages: entry.data.usages,
  included: entry.data.inclus,
  conditions: entry.data.conditions,
  restrictions: entry.data.restrictions,
  alerts: entry.data.alertes.map((alert) => alert.libelle),
  verified: entry.data.verifieLe.toLocaleDateString('fr-FR'),
  url: entry.data.url,
  documentation: entry.data.documentation,
  source: entry.data.source,
  quotas: getOfferQuotas(entry.id).map((quota) => { const value = getComparableQuotaValue(quota); return { ...quota, metricLabel: formatQuotaMetric(quota), amountLabel: formatQuotaAmount(quota), periodLabel: formatQuotaPeriod(quota), resetLabel: formatQuotaReset(quota), overageLabel: formatQuotaOverage(quota), scopeLabel: formatQuotaScope(quota), comparisonKey: getQuotaComparisonKey(quota), comparableValue: value === Number.POSITIVE_INFINITY ? 'unlimited' : value }; }),
}))).replace(/</g, '\\u003c');
---

<BaseLayout>
  <SiteHeader active="catalogue">
      <button slot="actions" class="favorites-filter" id="favorites-filter" type="button" aria-label="Afficher uniquement les favoris" aria-pressed="false" title="Afficher uniquement les favoris">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6-5.4-2.8-5.4 2.8 1-6-4.4-4.3 6.1-.9L12 3Z"/></svg>
      </button>
  </SiteHeader>

  <main>
    <section class="hero">
      <div class="network" aria-hidden="true"><i class="n1"></i><i class="n2"></i><i class="n3"></i><i class="n4"></i><i class="n5"></i></div>
      <div class="hero-copy">
        <h1>Les bons outils pour développer.<br />Avant la facture.</h1>
        <p>Services cloud, API et outils pour développeurs réellement utilisables gratuitement — quotas, restrictions et conditions vérifiés.</p>
      </div>
      <aside class="hero-kpis" aria-label="Indicateurs du catalogue">
        <div><strong>{activeOffers}</strong><span>offres actives</span></div>
        <div><strong>{coveredCategories}</strong><span>catégories couvertes</span></div>
        <div><strong>{withoutCard}</strong><span>sans carte bancaire</span></div>
        <div>
          <strong>{offersUpdated.shortDateLabel}</strong>
          <span>{offersUpdated.timeLabel ? `mise à jour des offres · ${offersUpdated.timeLabel}` : 'mise à jour des offres'}</span>
        </div>
      </aside>
    </section>

    <section class="editorial-trust" aria-labelledby="editorial-trust-title">
      <small id="editorial-trust-title">Nos engagements éditoriaux</small>
      <ul>
        <li><i aria-hidden="true">✓</i>Sources officielles</li>
        <li><i aria-hidden="true">✓</i>Offres revérifiées</li>
        <li><i aria-hidden="true">✓</i>Restrictions indiquées</li>
        <li><i aria-hidden="true">✓</i>Offres disparues archivées</li>
      </ul>
      <a href="/methodologie/">Comment nous vérifions les offres <span aria-hidden="true">→</span></a>
    </section>

    <section class="catalogue" id="catalogue">
      <section class="catalogue-discovery" aria-label="Rechercher et filtrer les offres">
        <label class="search-shell">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16 16 5 5"/></svg>
          <span class="sr-only">Rechercher dans le catalogue</span>
          <input id="search" type="search" placeholder="Rechercher un outil, une catégorie, une limite…" autocomplete="off" />
          <kbd>⌘ K</kbd>
        </label>

        <section class="quick-filter-bar" aria-labelledby="quick-filter-title">
          <small id="quick-filter-title">Accès rapides</small>
          <div class="quick-filter-list">
            <button type="button" data-quick-filter="score" aria-pressed="false"><span aria-hidden="true">★</span> Meilleurs free tiers</button>
            <button type="button" data-quick-filter="card" aria-pressed="false"><span aria-hidden="true">✓</span> Sans carte bancaire</button>
            <button type="button" data-quick-filter="risk" aria-pressed="false"><span aria-hidden="true">●</span> Aucun risque</button>
            <button type="button" data-quick-filter="permanent" aria-pressed="false"><span aria-hidden="true">∞</span> Formule permanente</button>
            <button type="button" data-quick-filter="recent" aria-pressed="false"><span aria-hidden="true">↻</span> Vérifiées récemment</button>
          </div>
          <a class="quota-explorer-link" href="/explorer/"><span aria-hidden="true">↗</span><strong>Comparer les quotas</strong><small>Stockage, trafic, requêtes…</small></a>
          <button class="advanced-filters-toggle" id="advanced-filters-toggle" type="button" aria-expanded="false" aria-controls="advanced-filters-panel">
            <span>Filtres avancés</span><b id="advanced-filter-count" hidden>0</b><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>
          </button>
        </section>

        <section class="advanced-filters" id="advanced-filters-panel" aria-labelledby="filter-title" hidden>
          <div class="section-intro compact">
            <div><h2 id="filter-title">Affiner les résultats</h2><p>Combinez catégorie, modèle et conditions de l’offre.</p></div>
            <div class="tag-filter" data-tag-filter>
              <div class="tag-filter-heading"><label id="usage-tag-label" for="usage-tag-input">Filtrer par usage</label><span>Les offres doivent contenir tous ces tags</span></div>
              <div class="tag-combobox">
                <div class="selected-tags" id="selected-usage-tags"></div>
                <input id="usage-tag-input" type="search" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="usage-tag-options" aria-labelledby="usage-tag-label" placeholder="Ajouter un tag…" autocomplete="off" />
              </div>
              <div class="tag-suggestions" id="usage-tag-options" role="listbox" aria-labelledby="usage-tag-label" hidden>
                {usageTags.map((tag, index) => <button id={`usage-tag-option-${index}`} type="button" role="option" aria-selected="false" data-tag={tag}>{tag}</button>)}
                <p class="tag-empty" hidden>Aucun tag correspondant</p>
              </div>
            </div>
          </div>
          <div class="filter-grid">
            <CustomSelect id="category-filter" label="Catégorie" options={categoryOptions} searchable />
            <CustomSelect id="type-filter" label="Modèle de service" options={modelOptions} />
            <CustomSelect id="card-filter" label="Carte bancaire" options={cardOptions} />
            <CustomSelect id="permanent-filter" label="Permanence" options={permanenceOptions} />
            <CustomSelect id="verification-filter" label="Date de vérification" options={verificationOptions} />
            <button class="reset" type="button">Réinitialiser</button>
          </div>
        </section>
      </section>

      <div class="catalogue-results-layout">
        <div class="catalogue-results-main">
      <div class="catalogue-heading">
        <h2><span id="result-count">{offers.length}</span> offres vérifiées</h2>
        <button class="favorites-filter-indicator" id="favorites-filter-indicator" type="button" aria-label="Désactiver le filtre favoris" hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6-5.4-2.8-5.4 2.8 1-6-4.4-4.3 6.1-.9L12 3Z"/></svg>
          <span>Favoris uniquement</span>
          <small>Tout afficher</small>
        </button>
        <div class="sort-controls">
          <label>Trier par&nbsp;:<select id="sort"><option value="recent" selected>Ajout / modification</option><option value="score">Meilleur free tier</option><option value="categorie">Catégorie</option><option value="verification">Date de vérification</option><option value="type">Modèle</option><option value="nom">Nom</option><option value="pertinence">Pertinence</option></select></label>
          <button class="sort-direction" id="sort-direction" type="button" data-direction="desc" aria-label="Tri décroissant — passer en ordre croissant" title="Tri décroissant — passer en ordre croissant"><span aria-hidden="true">↓</span></button>
        </div>
      </div>

      <div class="offers-table" role="table" aria-label="Offres gratuites">
        <div class="table-head" role="row"><span>Outil et catégorie</span><span>Formule gratuite</span><span>Facturation</span><span>Actions</span></div>
        <div id="offers-list">
          {offers.map(({ entry, Content, editorial }) => {
            const billingRisk = getBillingRisk(entry.data);
            const freeTierScore = scoreById.get(entry.id)!;
            const scoreTone = freeTierScore.total >= 85 ? 'excellent' : freeTierScore.total >= 70 ? 'strong' : freeTierScore.total >= 50 ? 'balanced' : 'limited';
            const catalogueAlerts = entry.data.alertes.filter((alert) => !(alert.type === 'finance' && alert.libelle === billingRisk.shortLabel));
            return (
            <article class="offer-row" role="row" tabindex="0" aria-expanded="false" data-id={entry.id}
              data-name={entry.data.nom.toLocaleLowerCase('fr')} data-type={entry.data.type}
              data-category={entry.data.categorie} data-card={String(entry.data.carteRequise)} data-risk={billingRisk.level} data-score={freeTierScore.total} data-permanent={String(entry.data.permanent)} data-verified={entry.data.verifieLe.getTime()} data-updated={getOfferChangeDate(entry)}
              data-usages={JSON.stringify(entry.data.usages)}
              data-category-name={categoryNames.get(entry.data.categorie) ?? entry.data.categorie}
              data-search={`${entry.data.nom} ${entry.data.accroche} ${entry.data.formule} ${categoryNames.get(entry.data.categorie) ?? ''} ${entry.data.type} ${entry.data.usages.join(' ')} ${entry.data.inclus.join(' ')} ${entry.data.conditions.join(' ')} ${entry.data.restrictions.join(' ')} ${entry.body ?? ''}`.toLocaleLowerCase('fr')}
              data-order={entry.data.ordre}>
              <div class="offer-identity">
                <a class:list={['offer-score-tile', `is-${scoreTone}`]} href={`/offres/${entry.id}/#score-gratuitpourlesdevs`} aria-label={`Score GratuitPourLesDevs de ${entry.data.nom} : ${freeTierScore.total} sur 100. Voir le calcul.`} title="Voir le calcul du score"><b>{freeTierScore.total}</b><span>/100</span></a>
                <span><small class="offer-category">{categoryNames.get(entry.data.categorie) ?? entry.data.categorie}</small><strong><a class="offer-name-link" href={`/offres/${entry.id}/`}>{entry.data.nom}</a></strong><span class="identity-meta"><small>{entry.data.accroche}</small><em>{entry.data.type}</em></span></span>
              </div>
              <p class="offer-plan"><strong>{entry.data.formule}</strong><small>{entry.data.usages.slice(0, 3).join(' · ')}</small><small class="offer-duration">{entry.data.permanent ? 'Formule permanente' : 'Essai limité'}</small></p>
              <div class="offer-status"><span class:list={['billing-risk-badge', `is-${billingRisk.level}`]}><i aria-hidden="true"></i>{billingRisk.shortLabel}</span><small class="billing-card-state">{entry.data.carteRequise ? 'Carte bancaire requise' : 'Sans carte bancaire'}</small>{catalogueAlerts.length > 0 && <div class="offer-key-alerts is-compact" aria-label={`Restrictions clés de ${entry.data.nom}`}>{catalogueAlerts.slice(0, 2).map((alert) => <a class:list={[`is-${alert.type}`, `is-${alert.niveau}`]} href={`/offres/${entry.id}/#limites`} title={alert.detail}><i aria-hidden="true">{OFFER_ALERT_ICONS[alert.type]}</i><span>{alert.libelle}</span></a>)}{catalogueAlerts.length > 2 && <a class="offer-alert-more" href={`/offres/${entry.id}/#limites`}>+{catalogueAlerts.length - 2}</a>}</div>}{entry.data.statut === 'a_verifier' && <small class="needs-review">À vérifier</small>}</div>
              <div class="offer-actions">
                <button class="favorite" type="button" aria-label={`Ajouter ${entry.data.nom} aux favoris`} data-id={entry.id}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6-5.4-2.8-5.4 2.8 1-6-4.4-4.3 6.1-.9L12 3Z"/></svg></button>
                <button class="compare-offer" type="button" aria-label={`Ajouter ${entry.data.nom} au comparateur`} aria-pressed="false" data-id={entry.id}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="7" height="7" rx="1"/><rect x="14" y="13" width="7" height="7" rx="1"/><path d="M10 7.5h4M14 16.5h-4M13 5l2.5 2.5L13 10M11 14l-2.5 2.5L11 19"/></svg></button>
                <a class="open-offer-page" href={`/offres/${entry.id}/`} aria-label={`Ouvrir la fiche de ${entry.data.nom}`} title={`Ouvrir la fiche de ${entry.data.nom}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h8l4 4v14H6Z"/><path d="M14 3v5h5M9 13h6M9 17h4"/></svg></a>
                <button class="expand-offer" type="button" aria-label={`Afficher le détail de ${entry.data.nom}`} aria-expanded="false" aria-controls={`detail-${entry.id}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg></button>
              </div>
              <div class="offer-detail" id={`detail-${entry.id}`}>
                <section><h3>Ce qui est inclus</h3><ul>{entry.data.inclus.map((item) => <li>{item}</li>)}</ul></section>
                <section><h3>Conditions</h3><ul>{entry.data.conditions.map((item) => <li>{item}</li>)}</ul></section>
                <section><h3>Restrictions</h3><ul>{entry.data.restrictions.map((item) => <li>{item}</li>)}</ul></section>
                <section class="why-useful"><h3>Pourquoi c’est utile</h3>{editorial ? <p>{editorial}</p> : <Content />}<dl class="why-useful-decisions"><div><dt>Le gratuit</dt><dd>{entry.data.formule}</dd></div><div><dt>Point de bascule</dt><dd>{getOfferSwitchLimit(entry.data)}</dd></div></dl></section>
                <div class="detail-footer"><span class="verified-date"><b>✓</b> Vérifié le {entry.data.verifieLe.toLocaleDateString('fr-FR')}</span><nav aria-label={`Liens pour ${entry.data.nom}`}><a href={`/offres/${entry.id}/`}>Voir la fiche complète →</a><a href={entry.data.url} target="_blank" rel="noreferrer">Site officiel ↗</a>{entry.data.documentation && <a href={entry.data.documentation} target="_blank" rel="noreferrer">Documentation ↗</a>}<a href={entry.data.source} target="_blank" rel="noreferrer">Source tarifaire ↗</a></nav></div>
              </div>
            </article>
            );
          })}
        </div>
        <div class="empty-state" id="empty-state" hidden>Aucune offre ne correspond à ces critères.</div>
      </div>
      <nav class="pagination" id="pagination" aria-label="Pagination du catalogue">
        <span id="pagination-summary" aria-live="polite"></span>
        <div class="pagination-controls">
          <button id="previous-page" type="button" aria-label="Page précédente">← <span>Précédent</span></button>
          <div id="page-numbers" aria-label="Pages"></div>
          <button id="next-page" type="button" aria-label="Page suivante"><span>Suivant</span> →</button>
        </div>
      </nav>
        </div>
        <aside class="catalogue-partner-slot" id="catalogue-partner-slot" aria-label="Sélection partenaire" hidden></aside>
      </div>
    </section>
  </main>

  <aside class="comparison-tray" id="comparison-tray" aria-label="Sélection à comparer" hidden>
    <div class="comparison-tray-copy"><strong><span id="comparison-count">0</span>/4 offres</strong><small id="comparison-tray-status" aria-live="polite">Sélectionnez au moins deux offres.</small></div>
    <div class="comparison-selection" id="comparison-selection"></div>
    <div class="comparison-tray-actions"><button id="clear-comparison" type="button">Effacer</button><button id="open-comparison" type="button" disabled>Comparer</button></div>
  </aside>

  <dialog class="comparison-dialog" id="comparison-dialog" aria-labelledby="comparison-title">
    <div class="comparison-dialog-shell">
      <header class="comparison-dialog-header">
        <div><small>COMPARATEUR D’OFFRES</small><h2 id="comparison-title">Comparer les offres sélectionnées</h2><p id="comparison-context"></p></div>
        <div class="comparison-dialog-controls"><label><input id="differences-only" type="checkbox" /> Afficher uniquement les différences</label><button id="close-comparison" type="button" aria-label="Fermer la comparaison">×</button></div>
      </header>
      <div class="comparison-scroll"><table class="comparison-table"><thead id="comparison-head"></thead><tbody id="comparison-body"></tbody></table></div>
      <div class="comparison-dialog-actions"><button id="copy-comparison-link" type="button">Copier le lien partageable</button><span id="comparison-share-status" aria-live="polite"></span></div>
    </div>
  </dialog>
  <script id="comparison-data" type="application/json" set:html={comparisonPayload} is:inline></script>

  <footer>
    <div class="verified-mark"><svg viewBox="0 0 32 36" aria-hidden="true"><path d="M16 2 29 7v10c0 8-5 14-13 17C8 31 3 25 3 17V7l13-5Z"/><path d="m10 18 4 4 8-9"/></svg><span><strong>Vérifié en août 2026</strong><small>Chaque quota renvoie vers sa source officielle.</small></span></div>
    <nav aria-label="Navigation secondaire"><a href="/docs/">Documentation</a><a href="/archives/">Archives</a><a href="/methodologie/">Méthodologie</a><a href="/evolutions/">Évolutions</a><a href="/contact/?objet=erreur">Signaler une erreur</a><a href="/a-propos/">À propos</a><a href="/contact/">Contact</a></nav>
    <span class="terminal-mark" aria-hidden="true">›_</span>
  </footer>

  <script>
    const search = document.querySelector<HTMLInputElement>('#search');
    const categorySelect = document.querySelector<HTMLSelectElement>('#category-filter');
    const typeSelect = document.querySelector<HTMLSelectElement>('#type-filter');
    const cardSelect = document.querySelector<HTMLSelectElement>('#card-filter');
    const permanentSelect = document.querySelector<HTMLSelectElement>('#permanent-filter');
    const verificationSelect = document.querySelector<HTMLSelectElement>('#verification-filter');
    const favoritesFilter = document.querySelector<HTMLButtonElement>('#favorites-filter');
    const favoritesFilterIndicator = document.querySelector<HTMLButtonElement>('#favorites-filter-indicator');
    const rows = [...document.querySelectorAll<HTMLElement>('.offer-row')];
    const list = document.querySelector<HTMLElement>('#offers-list');
    const count = document.querySelector<HTMLElement>('#result-count');
    const empty = document.querySelector<HTMLElement>('#empty-state');
    const sort = document.querySelector<HTMLSelectElement>('#sort');
    const sortDirection = document.querySelector<HTMLButtonElement>('#sort-direction');
    const pagination = document.querySelector<HTMLElement>('#pagination');
    const paginationSummary = document.querySelector<HTMLElement>('#pagination-summary');
    const pageNumbers = document.querySelector<HTMLElement>('#page-numbers');
    const previousPage = document.querySelector<HTMLButtonElement>('#previous-page');
    const nextPage = document.querySelector<HTMLButtonElement>('#next-page');
    const tagFilter = document.querySelector<HTMLElement>('[data-tag-filter]');
    const tagInput = document.querySelector<HTMLInputElement>('#usage-tag-input');
    const selectedTagsRoot = document.querySelector<HTMLElement>('#selected-usage-tags');
    const tagSuggestions = document.querySelector<HTMLElement>('#usage-tag-options');
    const tagOptions = [...document.querySelectorAll<HTMLButtonElement>('#usage-tag-options [role="option"]')];
    const tagEmpty = document.querySelector<HTMLElement>('.tag-empty');
    const quickFilterButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-quick-filter]')];
    const advancedFiltersToggle = document.querySelector<HTMLButtonElement>('#advanced-filters-toggle');
    const advancedFiltersPanel = document.querySelector<HTMLElement>('#advanced-filters-panel');
    const advancedFilterCount = document.querySelector<HTMLElement>('#advanced-filter-count');
    const pageSize = 10;
    let currentPage = 1;
    let filteredRows = [...rows];
    let favoritesOnly = new URLSearchParams(window.location.search).get('favoris') === '1';
    let saved: Set<string>;
