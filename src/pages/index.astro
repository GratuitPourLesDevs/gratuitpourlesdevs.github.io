---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = (await getCollection('offres')).sort((a, b) => a.data.ordre - b.data.ordre);
const offers = await Promise.all(entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })));
const featured = offers.find(({ entry }) => entry.data.vedette) ?? offers[0];
const categories = (await getCollection('categories'))
  .filter(({ data }) => data.actif)
  .sort((a, b) => a.data.ordre - b.data.ordre);
const categoryNames = new Map(categories.map((category) => [category.id, category.data.nom]));
const usages = [...new Set(entries.flatMap(({ data }) => data.usages))].sort((a, b) => a.localeCompare(b, 'fr'));
---

<BaseLayout>
  <header class="site-header">
    <a class="brand" href="/" aria-label="Gratuit pour les devs, accueil">
      <svg viewBox="0 0 40 40" aria-hidden="true"><path d="m4 13 16-9 16 9-16 9L4 13Zm0 9 16 9 16-9M4 31l16 9 16-9" /></svg>
      <span>Gratuit<span>PourLesDevs</span></span>
    </a>
    <nav aria-label="Navigation principale"><a class="active" href="#catalogue">Catalogue</a><a href="#methode">À propos</a></nav>
    <a class="outline-button" href="https://github.com/GratuitPourLesDevs/gratuitpourlesdevs.github.io/issues/new" target="_blank" rel="noreferrer">Suggérer un outil</a>
  </header>

  <main>
    <section class="hero">
      <div class="network" aria-hidden="true"><i class="n1"></i><i class="n2"></i><i class="n3"></i><i class="n4"></i><i class="n5"></i></div>
      <h1>Les bons outils.<br />Avant la facture.</h1>
      <p>Une sélection claire de services cloud avec une vraie formule gratuite, vérifiée pour les équipes DevOps et Infradev.</p>
    </section>

    <section class="catalogue" id="catalogue">
      <label class="search-shell">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16 16 5 5"/></svg>
        <span class="sr-only">Rechercher dans le catalogue</span>
        <input id="search" type="search" placeholder="Rechercher un outil, un usage…" autocomplete="off" />
        <kbd>⌘ K</kbd>
      </label>

      <div class="filter-bar">
        <div class="type-filters" aria-label="Filtrer par type">
          {['Tout', 'SaaS', 'PaaS', 'IaaS'].map((type) => <button type="button" class:list={{ active: type === 'Tout' }} data-type={type}>{type}</button>)}
        </div>
        <button class="filters-toggle" type="button" aria-expanded="false" aria-controls="usage-filters">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h2M10 17h10M14 4v6M7 14v6"/></svg>Filtres
        </button>
      </div>

      <div class="usage-filters" id="usage-filters" hidden>
        <label class="category-filter">Catégorie
          <select id="category-filter">
            <option value="">Toutes les catégories</option>
            {categories.map((category) => <option value={category.id}>{category.data.nom}</option>)}
          </select>
        </label>
        <div class="usage-filter-list"><span>Usage</span>{usages.map((usage) => <button type="button" data-usage={usage}>{usage}</button>)}</div>
        <button class="reset" type="button">Effacer les filtres</button>
      </div>

      <div class="catalogue-heading">
        <h2><span id="result-count">{offers.length}</span> offres vérifiées</h2>
        <label>Trier par&nbsp;:<select id="sort"><option value="pertinence">Pertinence</option><option value="nom">Nom</option><option value="categorie">Catégorie</option><option value="type">Type</option></select></label>
      </div>

      <div class="content-grid">
        <div class="offers-table" role="table" aria-label="Offres gratuites">
          <div class="table-head" role="row"><span>Outil</span><span>Type / catégorie</span><span>Formule gratuite</span><span>Usages</span><span>Favori</span></div>
          <div id="offers-list">
            {offers.map(({ entry, Content }) => (
              <article class="offer-row" role="row" tabindex="0"
                data-name={entry.data.nom.toLocaleLowerCase('fr')} data-type={entry.data.type}
                data-category={entry.data.categorie}
                data-category-name={categoryNames.get(entry.data.categorie) ?? entry.data.categorie}
                data-usages={entry.data.usages.join('|')}
                data-search={`${entry.data.nom} ${entry.data.accroche} ${entry.data.formule} ${categoryNames.get(entry.data.categorie) ?? ''} ${entry.data.usages.join(' ')}`.toLocaleLowerCase('fr')}
                data-order={entry.data.ordre}>
                <div class="offer-identity"><span class="offer-logo" style={`--logo-color:${entry.data.couleur}`}>{entry.data.initiales}</span><span><strong>{entry.data.nom}</strong><small>{entry.data.accroche}</small></span></div>
                <div class="offer-type"><span>{entry.data.type}</span><small class="offer-category">{categoryNames.get(entry.data.categorie) ?? entry.data.categorie}</small>{!entry.data.permanent && <small>Essai</small>}</div>
                <p class="offer-plan">{entry.data.formule}</p>
                <div class="offer-usages">{entry.data.usages.slice(0, 2).map((usage) => <span>{usage}</span>)}</div>
                <button class="favorite" type="button" aria-label={`Ajouter ${entry.data.nom} aux favoris`} data-id={entry.id}>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6-5.4-2.8-5.4 2.8 1-6-4.4-4.3 6.1-.9L12 3Z"/></svg>
                </button>
                <div class="offer-detail"><Content /><div><span>{entry.data.carteRequise ? 'Carte bancaire requise' : 'Sans carte bancaire'}</span><span>Vérifié le {entry.data.verifieLe.toLocaleDateString('fr-FR')}</span></div><a href={entry.data.url} target="_blank" rel="noreferrer">Visiter le site ↗</a><a href={entry.data.source} target="_blank" rel="noreferrer">Voir la source ↗</a></div>
              </article>
            ))}
          </div>
          <div class="empty-state" id="empty-state" hidden>Aucune offre ne correspond à cette recherche.</div>
        </div>

        {featured && <aside class="weekly-pick">
          <h3><span aria-hidden="true">✦</span> À tester cette semaine</h3>
          <div class="pick-body">
            <div class="pick-title"><span class="offer-logo" style={`--logo-color:${featured.entry.data.couleur}`}>{featured.entry.data.initiales}</span><span><strong>{featured.entry.data.nom}</strong><small>{featured.entry.data.accroche}</small></span></div>
            <p>Une pile d’observabilité complète pour découvrir métriques, journaux et traces sans héberger la plateforme.</p>
            <dl><div><dt>Formule gratuite</dt><dd>{featured.entry.data.formule}</dd></div><div><dt>Usages</dt><dd>{featured.entry.data.usages.join(', ')}</dd></div></dl>
            <a href={featured.entry.data.url} target="_blank" rel="noreferrer">Voir la fiche</a>
          </div>
        </aside>}
      </div>
    </section>
  </main>

  <footer id="methode">
    <div class="verified-mark"><svg viewBox="0 0 32 36" aria-hidden="true"><path d="M16 2 29 7v10c0 8-5 14-13 17C8 31 3 25 3 17V7l13-5Z"/><path d="m10 18 4 4 8-9"/></svg><span><strong>Vérifié en août 2026</strong><small>Chaque quota renvoie vers sa source officielle.</small></span></div>
    <nav aria-label="Navigation secondaire"><a href="#methode">Méthodologie</a><a href="https://github.com/GratuitPourLesDevs/gratuitpourlesdevs.github.io/issues/new" target="_blank" rel="noreferrer">Signaler une erreur</a><a href="mailto:julien.taverne+gratuitpourlesdevs@gmail.com">Contact</a></nav>
    <span class="terminal-mark" aria-hidden="true">›_</span>
  </footer>

  <script>
    const search = document.querySelector<HTMLInputElement>('#search');
    const typeButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-type]')];
    const usageButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-usage]')];
    const categorySelect = document.querySelector<HTMLSelectElement>('#category-filter');
    const rows = [...document.querySelectorAll<HTMLElement>('.offer-row')];
    const list = document.querySelector<HTMLElement>('#offers-list');
    const count = document.querySelector<HTMLElement>('#result-count');
    const empty = document.querySelector<HTMLElement>('#empty-state');
    const sort = document.querySelector<HTMLSelectElement>('#sort');
    let activeType = 'Tout'; let activeUsage = ''; let activeCategory = '';
    const normalize = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    const refresh = () => {
      const query = normalize(search?.value ?? ''); let visible = 0;
      rows.forEach((row) => { const show = normalize(row.dataset.search ?? '').includes(query) && (activeType === 'Tout' || row.dataset.type === activeType) && (!activeCategory || row.dataset.category === activeCategory) && (!activeUsage || (row.dataset.usages ?? '').split('|').includes(activeUsage)); row.hidden = !show; if (show) visible++; });
      if (count) count.textContent = String(visible); if (empty) empty.hidden = visible !== 0;
    };
    search?.addEventListener('input', refresh);
    document.addEventListener('keydown', (event) => { if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); search?.focus(); } if (event.key === 'Escape' && document.activeElement === search) search?.blur(); });
    typeButtons.forEach((button) => button.addEventListener('click', () => { activeType = button.dataset.type ?? 'Tout'; typeButtons.forEach((item) => item.classList.toggle('active', item === button)); refresh(); }));
    categorySelect?.addEventListener('change', () => { activeCategory = categorySelect.value; refresh(); });
    usageButtons.forEach((button) => button.addEventListener('click', () => { activeUsage = activeUsage === button.dataset.usage ? '' : (button.dataset.usage ?? ''); usageButtons.forEach((item) => item.classList.toggle('active', item.dataset.usage === activeUsage)); refresh(); }));
    document.querySelector('.filters-toggle')?.addEventListener('click', (event) => { const button = event.currentTarget as HTMLButtonElement; const panel = document.querySelector<HTMLElement>('#usage-filters'); if (!panel) return; panel.hidden = !panel.hidden; button.setAttribute('aria-expanded', String(!panel.hidden)); });
    document.querySelector('.reset')?.addEventListener('click', () => { activeUsage = ''; activeCategory = ''; if (categorySelect) categorySelect.value = ''; usageButtons.forEach((button) => button.classList.remove('active')); refresh(); });
    sort?.addEventListener('change', () => { rows.sort((a, b) => sort.value === 'nom' ? (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '', 'fr') : sort.value === 'categorie' ? (a.dataset.categoryName ?? '').localeCompare(b.dataset.categoryName ?? '', 'fr') : sort.value === 'type' ? (a.dataset.type ?? '').localeCompare(b.dataset.type ?? '', 'fr') : Number(a.dataset.order) - Number(b.dataset.order)).forEach((row) => list?.append(row)); });
    rows.forEach((row) => { row.addEventListener('click', (event) => { if (!(event.target as HTMLElement).closest('a,button')) row.classList.toggle('expanded'); }); row.addEventListener('keydown', (event) => { if (event.key === 'Enter') row.classList.toggle('expanded'); }); });
    const saved = new Set<string>(JSON.parse(localStorage.getItem('gpld-favorites') ?? '[]'));
    document.querySelectorAll<HTMLButtonElement>('.favorite').forEach((button) => { const id = button.dataset.id ?? ''; button.classList.toggle('active', saved.has(id)); button.addEventListener('click', () => { saved.has(id) ? saved.delete(id) : saved.add(id); button.classList.toggle('active', saved.has(id)); localStorage.setItem('gpld-favorites', JSON.stringify([...saved])); }); });
  </script>
</BaseLayout>
