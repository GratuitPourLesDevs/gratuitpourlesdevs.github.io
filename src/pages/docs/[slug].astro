---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import DocsSearch from '../../components/docs/DocsSearch.astro';
import DocsSidebar from '../../components/docs/DocsSidebar.astro';
import { docsArticles, getDocArticle, getDocIndex } from '../../data/docs';

export function getStaticPaths() {
  return docsArticles.map((item) => ({ params: { slug: item.slug } }));
}

const slug = Astro.params.slug ?? '';
const current = getDocArticle(slug)!;
const currentIndex = getDocIndex(slug);
const previous = docsArticles[currentIndex - 1];
const next = docsArticles[currentIndex + 1];
const isIntroductionGuide = slug === 'quest-ce-que-gratuitpourlesdevs';
const isStartGuide = slug === 'comment-utiliser-le-site';
const isCatalogueSearch = slug === 'rechercher-dans-le-catalogue';
const isBillingGuide = slug === 'risque-de-facturation';
const isStackGuide = slug === 'stack-100-gratuite';
const sectionTitle = isIntroductionGuide ? 'Un catalogue éditorial de free tiers' : isStartGuide ? 'Trouver une offre gratuite' : isCatalogueSearch ? 'Formuler une recherche utile' : isBillingGuide ? 'Identifier le chemin vers la facture' : isStackGuide ? 'Partir du besoin, pas des outils' : `Comprendre : ${current.title}`;
const secondSectionTitle = isIntroductionGuide ? 'Ce que vous trouvez dans le catalogue' : isStartGuide ? 'Affiner avec les filtres' : isCatalogueSearch ? 'Combiner recherche et filtres' : isBillingGuide ? 'Distinguer les niveaux de risque' : isStackGuide ? 'Vérifier les coûts de jonction' : 'Passer à l’action';
const thirdSectionTitle = isIntroductionGuide ? 'Ce que le catalogue exclut' : isStartGuide ? 'Lire les résultats' : isCatalogueSearch ? 'Lire et ouvrir les résultats' : 'Vérifier avant de choisir';
const pageDescription = `${current.summary} Documentation GratuitPourLesDevs.`;
---

<BaseLayout title={`${current.title} — Documentation GratuitPourLesDevs`} description={pageDescription} ogType="article">
  <SiteHeader active="docs" />
  <header class="docs-utility">
    <a href="/docs/" class="docs-utility-title"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5A3.5 3.5 0 0 1 7.5 2H11v17H7.5A3.5 3.5 0 0 0 4 22V5.5ZM20 5.5A3.5 3.5 0 0 0 16.5 2H13v17h3.5A3.5 3.5 0 0 1 20 22V5.5Z"/></svg><span>Documentation</span></a>
    <DocsSearch />
    <button class="docs-nav-toggle" type="button" data-docs-nav-open aria-label="Ouvrir le sommaire"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01"/></svg></button>
  </header>
  <main class="docs-article-shell">
    <DocsSidebar currentSlug={slug} />
    <article class="docs-article">
      <nav class="docs-breadcrumb" aria-label="Fil d’Ariane"><a href="/docs/">Documentation</a><span>/</span><span>{current.groupTitle}</span></nav>
      <header class="docs-article-header"><h1>{isStartGuide ? 'Comment utiliser GratuitPourLesDevs ?' : current.title}</h1><p>{isIntroductionGuide ? 'GratuitPourLesDevs recense, vérifie et compare les formules gratuites utiles aux développeurs — avec leurs vrais quotas, leurs conditions et leurs risques.' : isStartGuide ? 'Trouvez, évaluez et comparez des outils gratuits sans découvrir les limites au moment de la facture.' : current.summary}</p></header>

      <section id="premiere-etape" class="docs-prose-section">
        <header><span>01</span><div><h2>{sectionTitle}</h2><p>{isIntroductionGuide ? 'Le site transforme les pages tarifaires et documentations dispersées en fiches lisibles, comparables et datées.' : isStartGuide ? 'Utilisez la recherche et les filtres pour trouver rapidement des outils qui correspondent à votre besoin et proposent un accès gratuit durable.' : isCatalogueSearch ? 'Saisissez un nom d’outil, une technologie ou un besoin. La liste se met à jour immédiatement, sans recharger la page.' : isBillingGuide ? 'Une offre gratuite peut rester sans coût, être bloquée à son plafond ou ouvrir un chemin vers une consommation payante. Commencez par repérer le comportement au dépassement.' : isStackGuide ? 'Décrivez les ressources dont votre projet a besoin — calcul, données, stockage, identité, livraison et observation — avant de sélectionner les fournisseurs.' : `Ce guide explique ${current.title.toLocaleLowerCase('fr')} et les informations à vérifier avant de prendre une décision.`}</p></div></header>
        {isIntroductionGuide ? <div class="docs-checklist">
          <div><b>1</b><span><strong>Une sélection pensée pour les développeurs</strong><small>Hébergement, bases de données, APIs, CI/CD, monitoring, authentification, stockage et autres briques utiles à un projet logiciel.</small></span></div>
          <div><b>2</b><span><strong>Des offres gratuites, pas seulement des produits</strong><small>Chaque entrée décrit la formule accessible sans paiement : durée, quotas, carte bancaire, dépassement et restrictions.</small></span></div>
          <div><b>3</b><span><strong>Une information normalisée</strong><small>Les limites sont reformulées dans des unités et des périodes cohérentes afin de faciliter la lecture et la comparaison.</small></span></div>
        </div> : isStartGuide ? <div class="docs-product-demo" aria-label="Exemple de recherche dans le catalogue">
          <div class="docs-demo-controls"><label><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16 16 5 5"/></svg><input value="PostgreSQL" aria-label="Exemple de recherche" readonly /></label><button type="button" aria-pressed="true">✓ Sans carte bancaire</button><button type="button" aria-pressed="true">✓ Gratuit permanent</button></div>
          <div class="docs-demo-head"><span>Outil</span><span>Score /100</span><span>Risque</span><span>Dernière vérification</span></div>
          {[['N', 'Neon', 'PostgreSQL serverless', '92', 'Faible', '12 août 2026'], ['S', 'Supabase', 'Backend open source', '89', 'Faible', '8 août 2026'], ['A', 'Aiven', 'PostgreSQL managé', '78', 'Moyen', '2 août 2026']].map((row, index) => <a class="docs-demo-row" href={index === 0 ? '/offres/neon/' : '/#catalogue'}><span class={`demo-logo demo-logo-${index}`}>{row[0]}</span><span><strong>{row[1]}</strong><small>{row[2]}</small></span><b>{row[3]}</b><em class:list={{ medium: row[4] === 'Moyen' }}><i></i>{row[4]}</em><time>{row[5]}</time><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7 4 6 6-6 6"/></svg></a>)}
        </div> : isCatalogueSearch ? <div class="docs-checklist">
          <div><b>1</b><span><strong>Commencez par un terme précis</strong><small>Essayez par exemple « PostgreSQL », « monitoring », « stockage objet » ou le nom d’un fournisseur.</small></span></div>
          <div><b>2</b><span><strong>La recherche parcourt toute la fiche</strong><small>Nom, accroche, formule, catégorie, modèle, usages, éléments inclus, conditions et restrictions sont indexés.</small></span></div>
          <div><b>3</b><span><strong>Raccourcissez si nécessaire</strong><small>La casse et les accents sont ignorés. Si aucun résultat n’apparaît, revenez à un seul mot significatif avant d’ajouter des filtres.</small></span></div>
        </div> : <div class="docs-checklist">
          <div><b>1</b><span><strong>Formule et durée</strong><small>Vérifiez qu’il s’agit bien d’un plan gratuit et non d’un simple crédit temporaire.</small></span></div>
          <div><b>2</b><span><strong>Quota et portée</strong><small>Lisez ensemble le montant, l’unité, la période et le périmètre concerné.</small></span></div>
          <div><b>3</b><span><strong>Conditions et sources</strong><small>Confirmez les restrictions importantes sur la source officielle liée à la fiche.</small></span></div>
        </div>}
        {isCatalogueSearch && <figure class="docs-figure">
          <img src="/docs/recherche-postgresql.png" width="1360" height="400" loading="lazy" alt="Recherche PostgreSQL dans le catalogue avec une offre Neon affichée" />
          <figcaption><span>Exemple réel</span> Une requête précise réduit immédiatement le catalogue aux offres correspondantes.</figcaption>
        </figure>}
        {isStartGuide && <figure class="docs-figure">
          <img src="/docs/recherche-postgresql.png" width="1360" height="400" loading="lazy" alt="Catalogue filtré par une recherche PostgreSQL avec un résultat correspondant" />
          <figcaption><span>Étape 1</span> Commencez par un besoin, une technologie ou un fournisseur ; le compteur de résultats se met à jour immédiatement.</figcaption>
        </figure>}
        <a class="docs-inline-action" href={isIntroductionGuide ? '/docs/comment-utiliser-le-site/' : isStartGuide || isCatalogueSearch ? '/#catalogue' : isBillingGuide ? '/methodologie/#restrictions-cles' : isStackGuide ? '/explorer/' : '/'}>{isIntroductionGuide ? 'Voir comment utiliser le site' : isStartGuide ? 'Ouvrir le catalogue' : isCatalogueSearch ? 'Essayer dans le catalogue' : isBillingGuide ? 'Voir la méthodologie' : isStackGuide ? 'Explorer les quotas' : 'Mettre ce guide en pratique'} <span>→</span></a>
      </section>

      <section id="signaux" class="docs-prose-section">
        <header><span>02</span><div><h2>{secondSectionTitle}</h2><p>{isIntroductionGuide ? 'Chaque fiche rassemble ce qu’il faut savoir avant de créer un compte ou d’intégrer un service à votre architecture.' : isCatalogueSearch ? 'La recherche textuelle réduit le catalogue ; les filtres imposent ensuite des critères structurés à chaque résultat restant.' : 'Chaque fiche fait remonter les informations qui changent le plus souvent une décision.'}</p></div></header>
        {isIntroductionGuide ? <>
          <div class="docs-signals">
            <div><b>∞</b><span><strong>Nature de la gratuité</strong><small>Formule permanente, essai limité ou crédit temporaire : la durée est indiquée sans ambiguïté.</small></span></div>
            <div><b>100</b><span><strong>Quotas exploitables</strong><small>Montants, unités, périodes et périmètres sont présentés ensemble.</small></span></div>
            <div><b>!</b><span><strong>Risque de facturation</strong><small>Carte bancaire, dépassement bloqué ou facturé et conditions sensibles sont signalés.</small></span></div>
          </div>
          <aside class="docs-note"><span>i</span><div><strong>Une fiche est une synthèse, pas une copie marketing</strong><p>Elle sépare ce qui est inclus, les conditions d’accès, les restrictions et les liens vers les sources officielles.</p></div></aside>
        </> : isStartGuide ? <>
          <div class="docs-checklist">
            <div><b>1</b><span><strong>Activez les accès rapides</strong><small>« Sans carte bancaire », « Aucun risque », « Formule permanente » et « Vérifiées récemment » couvrent les choix les plus fréquents.</small></span></div>
            <div><b>2</b><span><strong>Ouvrez les filtres avancés</strong><small>Sélectionnez une catégorie, un modèle SaaS / PaaS / IaaS, une durée de gratuité ou une date de vérification.</small></span></div>
            <div><b>3</b><span><strong>Ajoutez seulement les critères décisifs</strong><small>Chaque filtre réduit la liste. Gardez les préférences secondaires pour la lecture des fiches afin de ne pas éliminer trop tôt une bonne candidate.</small></span></div>
          </div>
          <figure class="docs-figure">
            <img src="/docs/filtres-combines.png" width="1360" height="330" loading="lazy" alt="Filtres rapides et avancés appliqués au catalogue GratuitPourLesDevs" />
            <figcaption><span>Étape 2</span> Les boutons bleus sont actifs et le compteur des filtres avancés permet de repérer immédiatement une sélection trop stricte.</figcaption>
          </figure>
          <aside class="docs-note"><span>i</span><div><strong>Recherche et filtres se cumulent</strong><p>Si aucun résultat ne reste, retirez le dernier critère ajouté ou utilisez « Réinitialiser » pour repartir du catalogue complet.</p></div></aside>
        </> : isCatalogueSearch ? <>
          <div class="docs-checklist">
            <div><b>A</b><span><strong>Utilisez d’abord les accès rapides</strong><small>Activez « Sans carte bancaire », « Aucun risque », « Formule permanente » ou « Vérifiées récemment » en un clic.</small></span></div>
            <div><b>B</b><span><strong>Ouvrez les filtres avancés</strong><small>Affinez par catégorie, modèle SaaS / PaaS / IaaS, permanence, carte bancaire et date de vérification.</small></span></div>
            <div><b>C</b><span><strong>Ajoutez des tags d’usage</strong><small>Plusieurs tags se cumulent : une offre doit posséder chacun des tags sélectionnés pour rester visible.</small></span></div>
          </div>
          <aside class="docs-note"><span>i</span><div><strong>Comment les critères se combinent</strong><p>La requête, les filtres et les tags s’appliquent ensemble. Retirez un critère ou utilisez « Réinitialiser » si la sélection devient trop étroite.</p></div></aside>
          <figure class="docs-figure">
            <img src="/docs/filtres-combines.png" width="1360" height="330" loading="lazy" alt="Filtres avancés du catalogue avec Sans carte bancaire et Formule permanente activés" />
            <figcaption><span>Filtres combinés</span> Les pastilles bleues indiquent les critères actifs ; le compteur rappelle combien de filtres avancés sont appliqués.</figcaption>
          </figure>
        </> : <>
          <div class="docs-signals">
            <div><b>100</b><span><strong>Score /100</strong><small>Mesure la qualité de l’offre gratuite, pas celle du produit.</small></span></div>
            <div><b>!</b><span><strong>Risque de facturation</strong><small>Indique le risque de dépasser les limites sans s’en rendre compte.</small></span></div>
            <div><b>↻</b><span><strong>Dernière vérification</strong><small>Date à laquelle l’offre a été contrôlée manuellement.</small></span></div>
          </div>
          <aside class="docs-note"><span>i</span><div><strong>À retenir</strong><p>Un score élevé signifie que l’offre gratuite est généreuse, claire et sans piège — pas que l’outil est meilleur que tous les autres pour votre projet.</p></div></aside>
        </>}
      </section>

      <section id="verifier" class="docs-prose-section">
        <header><span>03</span><div><h2>{thirdSectionTitle}</h2><p>{isIntroductionGuide ? 'Le catalogue reste volontairement ciblé afin de ne pas mélanger gratuité durable, promotions et contenus sans rapport avec un usage de développement.' : isCatalogueSearch ? 'Le nombre de résultats confirme immédiatement la portée de votre recherche. Triez ensuite la liste selon le critère qui correspond à votre décision.' : 'Les offres évoluent. Consultez la date de vérification, l’historique et la source officielle avant un choix structurant.'}</p></div></header>
        {isIntroductionGuide ? <>
          <div class="docs-checklist">
            <div><b>×</b><span><strong>Les simples réductions</strong><small>Une remise, un coupon ou un tarif réservé aux nouveaux clients n’est pas une formule gratuite.</small></span></div>
            <div><b>×</b><span><strong>Les offres impossibles à documenter</strong><small>Une entrée sans source officielle suffisamment précise ne peut pas être présentée comme vérifiée.</small></span></div>
            <div><b>×</b><span><strong>Les outils sans intérêt développeur identifiable</strong><small>La gratuité seule ne suffit pas : l’outil doit répondre à un besoin concret de conception, livraison ou exploitation.</small></span></div>
          </div>
          <blockquote><strong>Gratuit ne veut pas dire sans condition.</strong><p>Une carte bancaire obligatoire, une limite d’usage commercial ou un dépassement facturé n’excluent pas automatiquement une offre. Ces contraintes doivent en revanche être visibles avant votre décision.</p></blockquote>
        </> : isStartGuide ? <>
          <div class="docs-checklist">
            <div><b>1</b><span><strong>Regardez la formule gratuite</strong><small>Le résumé indique les principaux quotas et précise s’il s’agit d’une formule permanente.</small></span></div>
            <div><b>2</b><span><strong>Contrôlez la facturation</strong><small>Le niveau de risque et la présence éventuelle d’une carte bancaire sont visibles directement dans la liste.</small></span></div>
            <div><b>3</b><span><strong>Dépliez le résultat</strong><small>Le chevron révèle les éléments inclus, les conditions, les restrictions et la dernière date de vérification sans perdre vos filtres.</small></span></div>
          </div>
          <figure class="docs-figure docs-figure-tall">
            <img src="/docs/resultat-neon-detail.png" width="1440" height="1100" loading="lazy" alt="Résultat Neon déplié montrant les informations à lire avant de choisir une offre" />
            <figcaption><span>Étape 3</span> Un résultat déplié permet une première évaluation complète avant d’ouvrir la fiche détaillée.</figcaption>
          </figure>
        </> : isCatalogueSearch ? <>
          <div class="docs-checklist">
            <div><b>1</b><span><strong>Choisissez le bon ordre</strong><small>Triez par pertinence, score du free tier, modification récente, date de vérification, catégorie, modèle ou nom.</small></span></div>
            <div><b>2</b><span><strong>Lisez les signaux visibles</strong><small>Formule gratuite, permanence, risque de facturation et carte bancaire permettent d’écarter rapidement un résultat inadapté.</small></span></div>
            <div><b>3</b><span><strong>Ouvrez la fiche avant de décider</strong><small>Consultez les quotas normalisés, les restrictions, l’historique et les sources officielles de l’offre retenue.</small></span></div>
          </div>
          <blockquote><strong>Exemple de parcours</strong><p>Recherchez « PostgreSQL », activez « Sans carte bancaire » et « Formule permanente », puis triez par meilleur free tier. Vous obtenez une shortlist ciblée sans confondre pertinence et générosité de l’offre.</p></blockquote>
          <figure class="docs-figure docs-figure-tall">
            <img src="/docs/resultat-neon-detail.png" width="1440" height="1100" loading="lazy" alt="Résultat Neon déplié avec formule gratuite, conditions, restrictions et liens vers les sources" />
            <figcaption><span>Résultat déplié</span> Le chevron à droite révèle les éléments inclus, les conditions, les restrictions et les liens de vérification sans quitter la liste.</figcaption>
          </figure>
        </> : <blockquote><strong>Le bon réflexe</strong><p>Comparez toujours une même ressource, sur une même période et avec une même portée. Un quota plus grand n’est utile que s’il mesure réellement la même chose.</p></blockquote>}
      </section>

      {isIntroductionGuide && <>
        <section id="verification" class="docs-prose-section">
          <header><span>04</span><div><h2>Une vérification éditoriale et datée</h2><p>Les informations importantes sont recherchées dans les sources du fournisseur, puis relues et datées pour rendre leur fraîcheur visible.</p></div></header>
          <div class="docs-checklist">
            <div><b>1</b><span><strong>Consulter les sources officielles</strong><small>Pages tarifaires, documentation produit, FAQ et conditions servent à confirmer la formule et ses limites.</small></span></div>
            <div><b>2</b><span><strong>Croiser les informations</strong><small>Lorsque plusieurs pages se complètent ou se contredisent, la fiche conserve les nuances utiles et les liens permettant de les contrôler.</small></span></div>
            <div><b>3</b><span><strong>Afficher la date de vérification</strong><small>Vous savez quand l’offre a été contrôlée et pouvez adapter votre niveau de prudence à l’ancienneté des données.</small></span></div>
          </div>
          <aside class="docs-note"><span>i</span><div><strong>Les offres évoluent</strong><p>Une vérification n’est jamais une garantie éternelle. L’historique, les archives et les signalements servent à suivre les changements.</p></div></aside>
        </section>

        <section id="difference" class="docs-prose-section">
          <header><span>05</span><div><h2>Plus qu’un annuaire de liens</h2><p>GratuitPourLesDevs ne cherche pas seulement à faire découvrir des noms : il aide à comprendre si une offre gratuite peut réellement convenir à un projet.</p></div></header>
          <div class="docs-signals">
            <div><b>◎</b><span><strong>Évaluer</strong><small>Le score /100 synthétise la qualité du free tier selon une méthodologie publique.</small></span></div>
            <div><b>⇄</b><span><strong>Comparer</strong><small>Les quotas normalisés rapprochent les offres sur des dimensions comparables.</small></span></div>
            <div><b>↻</b><span><strong>Suivre</strong><small>Historique et archives expliquent ce qui a changé ou pourquoi une offre a disparu.</small></span></div>
          </div>
          <blockquote><strong>Le meilleur score n’est pas toujours le meilleur choix.</strong><p>La localisation, les technologies supportées, les restrictions ou la progression vers une formule payante peuvent compter davantage pour votre contexte.</p></blockquote>
        </section>

        <section id="pour-qui" class="docs-prose-section">
          <header><span>06</span><div><h2>À qui s’adresse GratuitPourLesDevs ?</h2><p>Le catalogue sert aussi bien à découvrir une première stack qu’à auditer les coûts d’un prototype ou à remplacer une brique devenue trop limitée.</p></div></header>
          <div class="docs-checklist">
            <div><b>D</b><span><strong>Développeurs et étudiants</strong><small>Construire, apprendre et expérimenter sans engager immédiatement un budget.</small></span></div>
            <div><b>I</b><span><strong>Indépendants et petites équipes</strong><small>Choisir des services soutenables pour un prototype, un side project ou un produit en démarrage.</small></span></div>
            <div><b>T</b><span><strong>Équipes techniques</strong><small>Créer une shortlist, comparer les contraintes et vérifier une offre avant de l’introduire dans une architecture.</small></span></div>
          </div>
          <a class="docs-inline-action" href="/docs/trouver-son-premier-outil-gratuit/">Trouver votre premier outil gratuit <span>→</span></a>
        </section>
      </>}

      {isStartGuide && <>
        <section id="ouvrir-fiche" class="docs-prose-section">
          <header><span>04</span><div><h2>Ouvrir et comprendre une fiche</h2><p>La fiche complète rassemble les données utiles à une décision : quotas normalisés, restrictions, sources, historique et alternatives.</p></div></header>
          <div class="docs-checklist">
            <div><b>1</b><span><strong>Reliez le quota à son périmètre</strong><small>Vérifiez l’unité, la période et ce qui partage réellement la limite : compte, projet, membre ou ressource.</small></span></div>
            <div><b>2</b><span><strong>Lisez conditions et restrictions séparément</strong><small>Les conditions expliquent comment accéder à l’offre ; les restrictions décrivent ce qui limite son usage.</small></span></div>
            <div><b>3</b><span><strong>Utilisez l’historique et les alternatives</strong><small>Repérez les évolutions récentes et ouvrez les offres voisines si une contrainte est bloquante.</small></span></div>
          </div>
          <a class="docs-inline-action" href="/docs/comprendre-une-fiche-en-2-minutes/">Apprendre à lire une fiche <span>→</span></a>
        </section>

        <section id="conserver-comparer" class="docs-prose-section">
          <header><span>05</span><div><h2>Conserver et comparer vos candidates</h2><p>Quand plusieurs offres conviennent, transformez les résultats en shortlist au lieu de garder une série d’onglets difficiles à confronter.</p></div></header>
          <div class="docs-signals">
            <div><b>☆</b><span><strong>Favoris</strong><small>Conservez les offres intéressantes pour les retrouver rapidement lors d’une prochaine visite.</small></span></div>
            <div><b>⇄</b><span><strong>Comparateur</strong><small>Placez plusieurs offres côte à côte pour confronter quotas, conditions et risques.</small></span></div>
            <div><b>↗</b><span><strong>Partage</strong><small>Utilisez une comparaison partageable pour documenter une décision avec votre équipe.</small></span></div>
          </div>
          <aside class="docs-note"><span>i</span><div><strong>Comparez un même besoin</strong><p>Une base PostgreSQL et un stockage objet peuvent tous deux afficher des gigaoctets, mais ils ne rendent pas le même service. Comparez d’abord la fonction, puis le quota.</p></div></aside>
        </section>

        <section id="verifier-choix" class="docs-prose-section">
          <header><span>06</span><div><h2>Vérifier avant de choisir</h2><p>GratuitPourLesDevs accélère la recherche et la comparaison ; la source officielle reste la référence avant une intégration durable.</p></div></header>
          <div class="docs-checklist">
            <div><b>1</b><span><strong>Regardez la date de vérification</strong><small>Plus elle est récente, plus la synthèse reflète probablement l’offre actuellement commercialisée.</small></span></div>
            <div><b>2</b><span><strong>Ouvrez la documentation officielle</strong><small>Confirmez les limites qui pourraient bloquer votre projet, notamment la facturation, la région et les usages autorisés.</small></span></div>
