---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import AdSenseSlot from '../../../components/AdSenseSlot.astro';
import { getFreeTierScore } from '../../../data/free-tier-score';
import { formatQuotaAmount, formatQuotaOverage, formatQuotaPeriod, getOfferQuotas, type OfferQuota } from '../../../data/offer-quotas';
import { SOURCE_CODE_GUIDE_CONFIG } from '../../../data/source-code-guide';
import { SUPERVISION_GUIDE_CONFIG } from '../../../data/supervision-guide';
import { TESTING_GUIDE_CONFIG } from '../../../data/testing-guide';

type ComparisonColumn =
  | { key: 'service' | 'type' | 'plan' | 'duration' | 'overage' | 'card' | 'usage'; label: string }
  | { key: 'quota'; label: string; metrics: string[] };

type GuideConfig = {
  categoryLabelFallback: string;
  fallbackDescription: string;
  pageTitle: (rankingSize: number) => string;
  pageDescription: (rankingSize: number) => string;
  heroTitle: (rankingSize: number) => string;
  heroIntro: string;
  rankingTitle: (rankingSize: number) => string;
  itemListName: (rankingSize: number) => string;
  quotaPriority: string[];
  comparisonIntro: string;
  comparisonColumns: ComparisonColumn[];
  faqItems: Array<{ question: string; answer: string }>;
};

const GUIDE_CONFIGS: Record<string, GuideConfig> = {
  'depots-code-source': SOURCE_CODE_GUIDE_CONFIG as GuideConfig,
  supervision: SUPERVISION_GUIDE_CONFIG as GuideConfig,
  tests: TESTING_GUIDE_CONFIG as GuideConfig,
  email: {
    categoryLabelFallback: 'E-mail',
    fallbackDescription: 'Services e-mail pour développeurs',
    pageTitle: (rankingSize) => `Les ${rankingSize} meilleures offres gratuites e-mail pour les développeurs`,
    pageDescription: (rankingSize) => `Comparatif indépendant des ${rankingSize} meilleures offres gratuites d’e-mail pour développeurs : formules, score, carte bancaire, usages et limites vérifiés.`,
    heroTitle: (rankingSize) => `Les ${rankingSize} meilleures offres gratuites pour l’e-mail`,
    heroIntro: 'Comparatif indépendant des services d’e-mail gratuits présents dans le catalogue. Envoi transactionnel, campagnes, routage, validation ou test : retrouvez les offres les mieux notées selon notre grille de gratuité, avec leurs limites clairement exposées.',
    rankingTitle: (rankingSize) => `Top ${rankingSize} des meilleures offres gratuites e-mail`,
    itemListName: (rankingSize) => `Les ${rankingSize} meilleures offres gratuites pour l’e-mail`,
    quotaPriority: ['emails', 'messages', 'storage', 'domains', 'users', 'seats'],
  comparisonIntro: 'Pour l’e-mail, le tableau distingue le volume d’envoi et les capacités de domaines ou comptes, en plus des conditions générales du plan gratuit.',
  comparisonColumns: [
    { key: 'service', label: 'Service' },
    { key: 'type', label: 'Type d’e-mail' },
    { key: 'quota', label: 'Volume d’envoi', metrics: ['emails', 'messages', 'deliveries'] },
    { key: 'quota', label: 'Domaines / comptes', metrics: ['domains', 'users', 'seats', 'contacts', 'subscribers', 'recipients'] },
    { key: 'plan', label: 'Formule gratuite' },
    { key: 'duration', label: 'Gratuité' },
    { key: 'overage', label: 'Dépassement' },
    { key: 'card', label: 'Carte bancaire' },
    { key: 'usage', label: 'Usage idéal' },
  ],
  faqItems: [
      {
        question: 'Quel service e-mail gratuit choisir pour un projet de développement ?',
        answer: 'Le bon choix dépend surtout de votre usage : e-mails transactionnels, campagnes, tests, validation ou boîte mail. Ce classement privilégie les offres gratuites réellement exploitables, durables, documentées et vérifiées récemment.',
      },
      {
        question: 'Ces offres e-mail sont-elles réellement gratuites ?',
        answer: 'Les offres présentées ici disposent d’un accès gratuit au moment de leur dernière vérification. Certaines sont permanentes, d’autres limitées dans le temps ou soumises à des quotas. Les conditions exactes restent indiquées sur chaque fiche.',
      },
      {
        question: 'Faut-il une carte bancaire pour utiliser ces services ?',
        answer: 'Pas toujours. Le besoin d’une carte bancaire est affiché dans le comparatif rapide et entre dans le score GratuitPourLesDevs. Une offre sans carte obtient davantage de points sur ce critère.',
      },
      {
        question: 'Quelle différence entre e-mail transactionnel et e-mail marketing ?',
        answer: 'Un e-mail transactionnel est déclenché par une action ou un événement, par exemple une confirmation de compte ou une réinitialisation de mot de passe. L’e-mail marketing concerne davantage les campagnes, newsletters et communications commerciales.',
      },
    ],
  },
  'api-donnees-ml': {
    categoryLabelFallback: 'API, données et machine learning',
    fallbackDescription: 'API tierces, jeux de données et services de machine learning pour développeurs',
    pageTitle: (rankingSize) => `Les ${rankingSize} meilleures offres gratuites API, données et machine learning pour les développeurs`,
    pageDescription: (rankingSize) => `Comparatif indépendant des ${rankingSize} meilleures offres gratuites d’API, données et machine learning pour développeurs : quotas, score, carte bancaire, usages et limites vérifiés.`,
    heroTitle: (rankingSize) => `Les ${rankingSize} meilleures offres gratuites — API, données et machine learning`,
    heroIntro: 'Comparatif indépendant des API tierces, jeux de données et services de machine learning présents dans le catalogue. Accès aux données, traitement, automatisation ou expérimentation ML : retrouvez les offres les mieux notées selon notre grille de gratuité, avec leurs quotas et contraintes clairement exposés.',
    rankingTitle: (rankingSize) => `Top ${rankingSize} des meilleures offres gratuites — API, données et machine learning`,
    itemListName: (rankingSize) => `Les ${rankingSize} meilleures offres gratuites — API, données et machine learning`,
    quotaPriority: ['requests', 'operations', 'executions', 'queries', 'api_calls', 'calls', 'tokens', 'credit', 'credits', 'records', 'searches', 'predictions', 'inferences', 'compute', 'storage'],
  comparisonIntro: 'Cette catégorie mélange API, données et ML : les quotas sont donc séparés par nature afin de ne pas comparer artificiellement une requête API, un crédit IA et un volume de stockage.',
  comparisonColumns: [
    { key: 'service', label: 'Service' },
    { key: 'type', label: 'Type de service' },
    { key: 'quota', label: 'Activité API', metrics: ['requests', 'operations', 'executions', 'queries', 'api_calls', 'calls', 'searches'] },
    { key: 'quota', label: 'IA / crédits', metrics: ['tokens', 'credit', 'credits', 'predictions', 'inferences', 'compute'] },
    { key: 'quota', label: 'Données / stockage', metrics: ['records', 'storage', 'bandwidth', 'datasets', 'rows', 'data_rows'] },
    { key: 'plan', label: 'Formule gratuite' },
    { key: 'duration', label: 'Gratuité' },
    { key: 'overage', label: 'Dépassement' },
    { key: 'card', label: 'Carte bancaire' },
    { key: 'usage', label: 'Usage idéal' },
  ],
  faqItems: [
      {
        question: 'Quelle offre gratuite choisir pour une API, des données ou du machine learning ?',
        answer: 'Le bon choix dépend du besoin : consommer une API tierce, enrichir ou analyser des données, automatiser un traitement ou expérimenter un service de machine learning. Le classement met en avant les offres gratuites les plus exploitables selon le score GratuitPourLesDevs, puis détaille leurs quotas et contraintes.',
      },
      {
        question: 'Ces API et services de données ou de machine learning sont-ils réellement gratuits ?',
        answer: 'Les services de ce guide disposent d’un accès gratuit au moment de leur dernière vérification. Selon l’offre, la gratuité peut être permanente, limitée par un quota, liée à des crédits ou restreinte dans le temps. Les conditions exactes restent visibles sur chaque fiche.',
      },
      {
        question: 'Comment comparer des quotas très différents entre API, données et machine learning ?',
        answer: 'Un million de requêtes API, quelques crédits d’IA ou un volume de stockage ne se comparent pas directement. Le comparatif les sépare donc en trois familles — activité API, IA/crédits et données/stockage — et n’affiche une valeur que lorsqu’un quota structuré correspondant est documenté.',
      },
      {
        question: 'Faut-il une carte bancaire pour tester ces API et services ML ?',
        answer: 'Pas systématiquement. La carte bancaire requise ou non est affichée dans le comparatif et intervient dans le score GratuitPourLesDevs. Pour tester rapidement un service sans risque de facturation, les offres sans carte sont donc favorisées sur ce critère.',
      },
    ],
  },
};

const requestedCategoryId = typeof Astro.props.categoryId === 'string' ? Astro.props.categoryId : 'email';
const CATEGORY_ID = requestedCategoryId in GUIDE_CONFIGS ? requestedCategoryId : 'email';
const guideConfig = GUIDE_CONFIGS[CATEGORY_ID] ?? GUIDE_CONFIGS.email!;
const MAX_RESULTS = 10;

if (Astro.url.pathname.startsWith('/comparatifs/')) {
  return Astro.redirect(`/guides/${CATEGORY_ID}/meilleures-offres-gratuites/`);
}

const category = (await getCollection('categories')).find((entry) => entry.id === CATEGORY_ID);
const categoryOffers = (await getCollection('offres'))
  .filter(({ data }) => data.categorie === CATEGORY_ID && data.statut !== 'obsolete')
  .map((entry) => ({ entry, score: getFreeTierScore(entry.id, entry.data) }))
  .sort((a, b) => b.score.total - a.score.total || a.entry.data.nom.localeCompare(b.entry.data.nom, 'fr'));

const rankedOffers = categoryOffers.slice(0, MAX_RESULTS);
const rankingSize = rankedOffers.length;
const latestVerification = rankedOffers.length
  ? new Date(Math.max(...rankedOffers.map(({ entry }) => entry.data.verifieLe.getTime())))
  : new Date();
const updatedLabel = latestVerification.toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' });
const categoryLabel = category?.data.nom ?? guideConfig.categoryLabelFallback;

// Première édition du classement : aucun historique antérieur fiable n’existe encore.
// Lors de la prochaine mise à jour éditoriale, cette référence pourra accueillir les positions précédentes.
const previousPositions: Record<string, number> = {};

const getScoreTone = (total: number) => total >= 85 ? 'excellent' : total >= 70 ? 'strong' : total >= 50 ? 'balanced' : 'limited';
const getMovement = (id: string, currentPosition: number) => {
  const previousPosition = previousPositions[id];
  if (!previousPosition) return { label: 'Nouveau', tone: 'new', detail: 'Première référence disponible pour ce classement.' };
  const delta = previousPosition - currentPosition;
  if (delta > 0) return { label: `↑ +${delta}`, tone: 'up', detail: `${delta} place${delta > 1 ? 's' : ''} gagnée${delta > 1 ? 's' : ''} depuis la dernière référence.` };
  if (delta < 0) return { label: `↓ ${delta}`, tone: 'down', detail: `${Math.abs(delta)} place${Math.abs(delta) > 1 ? 's' : ''} perdue${Math.abs(delta) > 1 ? 's' : ''} depuis la dernière référence.` };
  return { label: '→ =', tone: 'stable', detail: 'Position inchangée depuis la dernière référence.' };
};

const faqItems = guideConfig.faqItems;

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: guideConfig.itemListName(rankingSize),
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  numberOfItems: rankingSize,
  itemListElement: rankedOffers.map(({ entry }, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: entry.data.nom,
    url: new URL(`/offres/${entry.id}/`, Astro.site).href,
  })),
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: `Meilleures offres gratuites ${categoryLabel}`, item: new URL(Astro.url.pathname, Astro.site).href },
  ],
};

const pageTitle = guideConfig.pageTitle(rankingSize);
const pageDescription = guideConfig.pageDescription(rankingSize);

const getKeyPoints = (entry: (typeof rankedOffers)[number]['entry']) => {
  const source = [...entry.data.inclus, ...entry.data.usages, ...entry.data.conditions];
  return [...new Set(source)].slice(0, 3);
};

const QUOTA_PRIORITY = new Map<string, number>(guideConfig.quotaPriority.map((metric, index) => [metric, index]));
const getQuickQuota = (offerId: string) => [...getOfferQuotas(offerId)].sort((a, b) =>
  (QUOTA_PRIORITY.get(a.metric) ?? 99) - (QUOTA_PRIORITY.get(b.metric) ?? 99)
)[0];
const getQuotaForMetrics = (offerId: string, metrics: string[]) => {
  const priority = new Map(metrics.map((metric, index) => [metric, index]));
  return [...getOfferQuotas(offerId)]
    .filter((quota) => priority.has(quota.metric))
    .sort((a, b) => (priority.get(a.metric) ?? 99) - (priority.get(b.metric) ?? 99))[0];
};
const getOverageTone = (quota?: OfferQuota) => {
  if (!quota) return 'neutral';
  if (quota.overage === 'billed') return 'negative';
  if (quota.overage === 'not-applicable') return 'positive';
  return 'warning';
};
---

<BaseLayout
  title={`${pageTitle} — GratuitPourLesDevs`}
  description={pageDescription}
  modifiedTime={latestVerification}
  jsonLd={[itemListJsonLd, faqJsonLd, breadcrumbJsonLd]}
>
  <SiteHeader active="guides" />

  <main class="seo-category-page">
    <nav class="seo-breadcrumb" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a><span aria-hidden="true">›</span><a href="/guides/">Guides</a><span aria-hidden="true">›</span><strong>{categoryLabel}</strong>
    </nav>

    <section class="seo-hero">
      <div class="seo-hero-copy">
        <small>GUIDE CATÉGORIE</small>
        <h1>{guideConfig.heroTitle(rankingSize)}</h1>
        <p>{guideConfig.heroIntro}</p>
      </div>

      <aside class="seo-summary" aria-label="Sommaire de la page">
        <small>DANS CE GUIDE</small>
        <a href="#top-10">Top {rankingSize} des offres</a>
        <a href="#comparatif">Comparatif rapide</a>
        <a href="#methodologie">Méthodologie</a>
        <a href="#faq">FAQ</a>
        <a href="#liens-utiles">Autres pages utiles</a>
      </aside>
    </section>

    <section class="seo-facts" aria-label="Repères du comparatif">
      <article><span>01</span><strong>{rankingSize} offres classées</strong><small>Les mieux notées de la catégorie</small></article>
      <article><span>02</span><strong>{categoryLabel}</strong><small>{category?.data.description ?? guideConfig.fallbackDescription}</small></article>
      <article><span>03</span><strong>Mise à jour {updatedLabel}</strong><small>Basée sur les dernières vérifications</small></article>
      <article><span>04</span><strong>Classement éditorial</strong><small>Score transparent sur 100 points</small></article>
    </section>

    <section class="seo-value-grid">
      <div class="seo-value-card">
        <header><small>POURQUOI CETTE PAGE ?</small><h2>Décider plus vite, sans masquer les contraintes.</h2></header>
        <div class="seo-value-points">
          <article><b>✓</b><span><strong>Sélection transparente</strong><small>Uniquement des offres présentes dans le catalogue et vérifiées.</small></span></article>
          <article><b>↗</b><span><strong>Gain de temps</strong><small>Plans, score, carte bancaire et usages réunis au même endroit.</small></span></article>
          <article><b>◇</b><span><strong>Pas de faux “gratuit”</strong><small>Durée, restrictions et risques restent visibles dans les fiches détaillées.</small></span></article>
        </div>
      </div>
      <div class="seo-score-card">
        <small>COMMENT LIRE LE CLASSEMENT ?</small>
        <strong>100 points</strong>
        <p>Le score combine permanence, absence de carte bancaire, utilité du quota, liberté d’utilisation, fraîcheur de la vérification et qualité des sources.</p>
        <a href="#methodologie">Voir la méthodologie ↓</a>
      </div>
    </section>

    <section class="seo-ranking" id="top-10">
      <header class="seo-section-heading">
        <div><small>CLASSEMENT</small><h2>{guideConfig.rankingTitle(rankingSize)}</h2></div>
        <p>Première référence du classement : les variations de position apparaîtront dès la prochaine mise à jour éditoriale.</p>
      </header>

      <div class="seo-ranking-list">
        {rankedOffers.map(({ entry, score }, index) => {
          const scoreTone = getScoreTone(score.total);
          const movement = getMovement(entry.id, index + 1);
          return (
            <article class:list={['seo-offer-row', { 'is-podium': index < 3, 'is-first': index === 0 }]}>
              <span class="seo-rank">{String(index + 1).padStart(2, '0')}</span>
              <a class:list={['offer-score-tile', 'seo-score-tile', `is-${scoreTone}`]} href={`/offres/${entry.id}/#score-gratuitpourlesdevs`} aria-label={`Score GratuitPourLesDevs de ${entry.data.nom} : ${score.total} sur 100`} title="Voir le détail du score"><b>{score.total}</b><span>/100</span></a>

              <div class="seo-offer-main">
                <div class="seo-offer-title">
                  <h3><a href={`/offres/${entry.id}/`}>{entry.data.nom}</a></h3>
                  {index === 0 && <em>Meilleur score</em>}
                </div>
                <p>{entry.data.accroche}</p>
              </div>

              <div class="seo-plan">
                <small>FORMULE GRATUITE</small>
                <strong>{entry.data.formule}</strong>
              </div>

              <ul class="seo-key-points">
                {getKeyPoints(entry).map((point) => <li>{point}</li>)}
              </ul>

              <span class:list={['seo-movement', `is-${movement.tone}`]} title={movement.detail}>{movement.label}</span>

              <div class="seo-actions">
                <a class="seo-primary-action" href={`/offres/${entry.id}/`} target="_blank" rel="noopener noreferrer" aria-label={`Voir l’offre ${entry.data.nom} dans un nouvel onglet`}>Voir l’offre ↗</a>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <AdSenseSlot placement="guide-middle" slot={import.meta.env.PUBLIC_ADSENSE_GUIDE_SLOT} />

    <section class="seo-comparison" id="comparatif">
  <header class="seo-section-heading">
    <div><small>VUE D’ENSEMBLE</small><h2>Comparatif rapide</h2></div>
    <p>{guideConfig.comparisonIntro}</p>
  </header>

  <div class="seo-table-shell">
    <table>
      <thead>
        <tr>
          {guideConfig.comparisonColumns.map((column) => <th>{column.label}</th>)}
        </tr>
      </thead>
      <tbody>
        {rankedOffers.map(({ entry, score }) => {
          const scoreTone = getScoreTone(score.total);
          const quickQuota = getQuickQuota(entry.id);
          return (
            <tr>
              {guideConfig.comparisonColumns.map((column) => {
                const quota = column.key === 'quota' ? getQuotaForMetrics(entry.id, column.metrics) : undefined;
                return (
                  <td data-label={column.label} class:list={[{ 'seo-quota-cell': column.key === 'quota' }]}>
                    {column.key === 'service' ? <><a class:list={['offer-score-tile', 'seo-table-score', `is-${scoreTone}`]} href={`/offres/${entry.id}/#score-gratuitpourlesdevs`} aria-label={`Score de ${entry.data.nom} : ${score.total} sur 100`}><b>{score.total}</b><span>/100</span></a><a href={`/offres/${entry.id}/`}>{entry.data.nom}</a></> :
                     column.key === 'type' ? entry.data.type :
                     column.key === 'quota' ? (quota ? <><strong>{formatQuotaAmount(quota)} · {formatQuotaPeriod(quota)}</strong><small>{quota.label}</small></> : <span class="seo-undocumented">Non documenté</span>) :
                     column.key === 'plan' ? entry.data.formule :
                     column.key === 'duration' ? <span class:list={['seo-binary', entry.data.permanent ? 'positive' : 'warning']}>{entry.data.permanent ? 'Permanente' : 'Essai limité'}</span> :
                     column.key === 'overage' ? (quickQuota ? <span class:list={['seo-binary', getOverageTone(quickQuota)]}>{formatQuotaOverage(quickQuota)}</span> : <span class="seo-binary neutral">Non documenté</span>) :
                     column.key === 'card' ? <span class:list={['seo-binary', entry.data.carteRequise ? 'negative' : 'positive']}>{entry.data.carteRequise ? 'Requise' : 'Non requise'}</span> :
                     column.key === 'usage' ? entry.data.usages.slice(0, 2).join(' · ') : null}
                  </td>
                );
              })}
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</section>

<section class="seo-method-faq">
      <article class="seo-methodology" id="methodologie">
        <small>MÉTHODOLOGIE</small>
        <h2>Un classement explicable, pas une préférence arbitraire.</h2>
        <p>Chaque offre obtient un score GratuitPourLesDevs sur 100 à partir de six critères déjà utilisés dans le catalogue :</p>
        <ul>
          <li><strong>25 pts</strong> — gratuit permanent</li>
          <li><strong>20 pts</strong> — accès sans carte bancaire</li>
          <li><strong>25 pts</strong> — utilité réelle du quota</li>
          <li><strong>20 pts</strong> — liberté réelle d’utilisation</li>
          <li><strong>5 pts</strong> — fraîcheur de la vérification</li>
          <li><strong>5 pts</strong> — qualité des sources officielles</li>
        </ul>
        <p class="seo-method-note">En cas d’égalité, l’ordre alphabétique départage les offres. Une meilleure position ne signifie pas qu’un outil conviendra à tous les usages : les quotas et contraintes restent déterminants.</p>
        <a href="/methodologie/">Consulter la méthodologie générale →</a>
      </article>

      <article class="seo-faq" id="faq">
        <small>FAQ</small>
        <h2>Questions fréquentes</h2>
        <div>
          {faqItems.map((item, index) => (
            <details open={index === 0}>
              <summary>{item.question}<span aria-hidden="true">+</span></summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </article>
    </section>

    <section class="seo-related" id="liens-utiles">
      <header class="seo-section-heading">
        <div><small>POURSUIVRE</small><h2>Autres pages utiles</h2></div>
        <p>Approfondissez la comparaison avec les outils déjà disponibles sur GratuitPourLesDevs.</p>
      </header>
      <div class="seo-related-grid">
        <a href="/guides/"><span>GUIDES</span><strong>Voir toutes les sélections éditoriales</strong><b>→</b></a>
        <a href="/"><span>CATALOGUE</span><strong>Voir toutes les offres gratuites</strong><b>→</b></a>
        <a href="/comparaisons/"><span>COMPARAISONS</span><strong>Découvrir les comparaisons publiques</strong><b>→</b></a>
        <a href="/methodologie/"><span>MÉTHODE</span><strong>Comprendre comment les offres sont évaluées</strong><b>→</b></a>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .seo-category-page{width:min(1600px,calc(100% - 64px));margin:0 auto;padding:32px 0 76px}
  .seo-breadcrumb{display:flex;align-items:center;gap:10px;color:var(--muted);font-size:12px}.seo-breadcrumb a{color:var(--blue);text-decoration:none}.seo-breadcrumb a:hover{text-decoration:underline;text-underline-offset:3px}.seo-breadcrumb strong{color:var(--ink);font-weight:700}
