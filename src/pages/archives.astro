  .archive-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-top:28px}.archive-stats article{min-height:92px;display:flex;align-items:center;gap:18px;padding:18px 20px;border:1px solid var(--line);border-radius:8px;background:var(--surface);box-shadow:0 4px 14px rgb(20 29 55/3%)}.archive-stat-icon{width:50px;height:50px;display:grid;place-items:center;flex:0 0 auto;border-radius:9px;color:var(--blue);background:rgb(11 69 255/7%)}.archive-stat-icon svg{width:25px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}.archive-stats article>span:last-child{display:grid;gap:2px}.archive-stats strong{font-size:25px;line-height:1}.archive-stats small{color:var(--muted);font-size:12px}
