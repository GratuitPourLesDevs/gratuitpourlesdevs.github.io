---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';

const categories = await getCollection('categories');
const categoryNames = new Map(categories.map((category) => [category.id, category.data.nom]));
const rawArchives = (await getCollection('offres'))
  .filter(({ data }) => data.statut === 'obsolete');

type ArchiveEntry = (typeof rawArchives)[number];

const getCheckedAt = (entry: ArchiveEntry) => entry.data.verificationAutomatiqueLe ?? entry.data.verifieLe;
const getArchivedAt = (entry: ArchiveEntry) => {
  const statusChange = [...entry.data.historique]
    .reverse()
    .find((event) => event.type === 'statut' && event.changements.some((change) => change.apres?.toLocaleLowerCase('fr-FR').includes('obsolete')));
  return statusChange?.date ?? getCheckedAt(entry);
};

const archiveText = (entry: ArchiveEntry) => [
  entry.data.nom,
  entry.data.accroche,
  entry.data.formule,
  entry.data.verificationNote ?? '',
].join(' ').toLocaleLowerCase('fr-FR');

const isStoppedService = (entry: ArchiveEntry) => /arrêt|arrêté|fermeture|fermé|sunset|extinction|dépréci|pivot|transfér/.test(archiveText(entry));
const isRemovedFreeTier = (entry: ArchiveEntry) => /free tier|free forever|gratuit permanent|gratuité permanente|plan gratuit|offre gratuite|quota gratuit/.test(archiveText(entry));

const getReason = (entry: ArchiveEntry) => {
  const text = archiveText(entry);
  if (isStoppedService(entry)) return { value: 'service-arrete', label: 'Service arrêté' };
  if (/payant|tarification|abonnement|essai de \d+ jours|essai \d+ jours/.test(text)) return { value: 'devenu-payant', label: 'Devenu payant' };
  if (isRemovedFreeTier(entry)) return { value: 'free-tier-supprime', label: 'Free tier supprimé' };
  return { value: 'autre', label: 'Autre évolution' };
};

const archives = rawArchives
  .map((entry) => {
    const checkedAt = getCheckedAt(entry);
    const archivedAt = getArchivedAt(entry);
    const reason = getReason(entry);
    const categoryName = categoryNames.get(entry.data.categorie) ?? entry.data.categorie;
    return {
      entry,
      checkedAt,
      archivedAt,
      reason,
      categoryName,
      year: archivedAt.getFullYear(),
      month: archivedAt.getMonth(),
    };
  })
  .sort((a, b) => b.archivedAt.getTime() - a.archivedAt.getTime());

const categoryOptions = [...new Map(archives.map(({ entry, categoryName }) => [entry.data.categorie, categoryName])).entries()]
  .sort((a, b) => a[1].localeCompare(b[1], 'fr'));
const reasonOptions = [...new Map(archives.map(({ reason }) => [reason.value, reason.label])).entries()]
  .sort((a, b) => a[1].localeCompare(b[1], 'fr'));
const yearOptions = [...new Set(archives.map(({ year }) => year))].sort((a, b) => b - a);
const freeTierCount = rawArchives.filter(isRemovedFreeTier).length;
const stoppedServiceCount = rawArchives.filter(isStoppedService).length;

const yearGroups = yearOptions.map((year) => {
  const yearEntries = archives.filter((archive) => archive.year === year);
  const months = [...new Set(yearEntries.map(({ month }) => month))]
    .sort((a, b) => b - a)
    .map((month) => ({
      month,
      entries: yearEntries.filter((archive) => archive.month === month),
    }));
  return { year, entries: yearEntries, months };
});

const monthLabel = (year: number, month: number) => {
  const label = new Intl.DateTimeFormat('fr-FR', { month: 'long', year: 'numeric' }).format(new Date(year, month, 1));
  return label.charAt(0).toUpperCase() + label.slice(1);
};
---

<BaseLayout title="Archives des offres — Gratuit pour les devs" description="Les offres gratuites retirées du catalogue, conservées avec leur dernier état de vérification.">
  <SiteHeader />

  <main class="archive-page">
    <header class="archive-hero">
      <small>MÉMOIRE DU CATALOGUE</small>
      <h1>Archives</h1>
      <p>Les offres devenues indisponibles restent consultables avec la date et le motif de leur retrait.</p>
    </header>

    {archives.length === 0 ? (
      <section class="archive-empty">
        <strong>Aucune offre archivée</strong>
        <p>Toutes les offres suivies sont encore actives ou en attente de vérification.</p>
      </section>
    ) : (
      <>
        <section class="archive-stats" aria-label="Statistiques des archives">
          <article>
            <span class="archive-stat-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M4 7h16v13H4zM3 4h18v3H3zm6 7h6"/></svg>
            </span>
            <span><strong>{archives.length}</strong><small>offres archivées</small></span>
          </article>
          <article>
            <span class="archive-stat-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="m6.5 6.5 11 11"/></svg>
            </span>
            <span><strong>{freeTierCount}</strong><small>free tiers supprimés</small></span>
          </article>
          <article>
            <span class="archive-stat-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="m9 9 6 6m0-6-6 6"/></svg>
            </span>
            <span><strong>{stoppedServiceCount}</strong><small>services arrêtés</small></span>
          </article>
        </section>

        <section class="archive-controls" aria-label="Recherche et filtres des archives">
          <label class="archive-search" for="archive-search">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16 16 4 4"/></svg>
            <span class="sr-only">Rechercher une offre archivée</span>
            <input id="archive-search" type="search" placeholder="Rechercher une offre archivée…" autocomplete="off" />
          </label>
          <div class="archive-filter-row">
            <label class="archive-select">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/></svg>
              <span class="sr-only">Filtrer par catégorie</span>
              <select id="archive-category">
                <option value="">Toutes les catégories</option>
                {categoryOptions.map(([value, label]) => <option value={value}>{label}</option>)}
              </select>
            </label>
            <label class="archive-select">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 12 8-8h6l2 2v6l-8 8z"/><circle cx="16.5" cy="7.5" r="1"/></svg>
              <span class="sr-only">Filtrer par motif</span>
              <select id="archive-reason-filter">
                <option value="">Tous les motifs</option>
                {reasonOptions.map(([value, label]) => <option value={value}>{label}</option>)}
              </select>
            </label>
            <label class="archive-select">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="6" width="16" height="14" rx="2"/><path d="M8 3v6m8-6v6M4 11h16"/></svg>
              <span class="sr-only">Filtrer par année</span>
              <select id="archive-year-filter">
                <option value="">Toutes les années</option>
                {yearOptions.map((year) => <option value={year}>{year}</option>)}
              </select>
            </label>
            <label class="archive-select archive-sort">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 4v16m0-16L5 7m3-3 3 3m5 13V4m0 16-3-3m3 3 3-3"/></svg>
              <span class="sr-only">Trier les archives</span>
              <select id="archive-sort">
                <option value="recent">Plus récentes</option>
                <option value="oldest">Plus anciennes</option>
                <option value="name">Nom A → Z</option>
              </select>
            </label>
          </div>
        </section>

        <div class="archive-results-heading" aria-live="polite">
          <strong id="archive-result-count">{archives.length} offres archivées</strong>
        </div>

        <section id="archive-groups" class="archive-groups" aria-label="Offres archivées">
          {yearGroups.map((yearGroup, yearIndex) => (
            <details class="archive-year" data-year-group data-year={yearGroup.year} data-sort={yearGroup.year} open={yearIndex === 0}>
              <summary>
                <span class="archive-chevron" aria-hidden="true"></span>
                <svg class="archive-calendar" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="6" width="16" height="14" rx="2"/><path d="M8 3v6m8-6v6M4 11h16"/></svg>
                <strong>{yearGroup.year}</strong>
                <span>—</span>
                <span data-year-count>{yearGroup.entries.length} {yearGroup.entries.length > 1 ? 'offres' : 'offre'}</span>
              </summary>
              <div class="archive-year-content">
                {yearGroup.months.map((monthGroup, monthIndex) => (
                  <details class="archive-month" data-month-group data-month={monthGroup.month} data-sort={monthGroup.month} open={yearIndex === 0 && monthIndex === 0}>
                    <summary>
                      <span class="archive-chevron" aria-hidden="true"></span>
                      <svg class="archive-calendar" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="6" width="16" height="14" rx="2"/><path d="M8 3v6m8-6v6M4 11h16"/></svg>
                      <strong>{monthLabel(yearGroup.year, monthGroup.month)}</strong>
                    </summary>
                    <div class="archive-month-list">
                      {monthGroup.entries.map(({ entry, checkedAt, archivedAt, reason, categoryName }) => (
                        <details
                          class="archive-entry"
                          data-archive-entry
                          data-name={entry.data.nom}
                          data-category={entry.data.categorie}
                          data-category-label={categoryName}
                          data-reason={reason.value}
                          data-year={archivedAt.getFullYear()}
                          data-date={archivedAt.getTime()}
                          data-search={`${entry.data.nom} ${entry.data.accroche} ${categoryName} ${entry.data.verificationNote ?? ''}`}
                          open={entry.data.nom.toLocaleLowerCase('fr-FR').includes('azure pipelines')}
                        >
                          <summary class="archive-row">
                            <span class="archive-logo" style={`--archive-logo-color:${entry.data.couleur}`}>{entry.data.initiales}</span>
                            <span class="archive-row-name"><strong>{entry.data.nom}</strong></span>
                            <span class="archive-row-category">{categoryName}</span>
                            <span class="archive-status">Obsolète</span>
                            <small>Contrôlée le {checkedAt.toLocaleDateString('fr-FR')}</small>
                            <span class="archive-chevron archive-row-chevron" aria-hidden="true"></span>
                          </summary>
                          <div class="archive-detail">
                            <h2><a href={`/offres/${entry.id}/`}>{entry.data.nom}</a></h2>
                            <p class="archive-detail-intro">{entry.data.accroche}</p>
                            <span class="archive-status">Obsolète</span>
                            <p class="archive-detail-reason">{entry.data.verificationNote ?? 'Cette offre n’est plus disponible dans le catalogue actif.'}</p>
                            <small>Contrôlée le {checkedAt.toLocaleDateString('fr-FR')}</small>
                            <nav aria-label={`Sources archivées pour ${entry.data.nom}`}>
                              <a href={entry.data.url} target="_blank" rel="noreferrer">Ancien site <span aria-hidden="true">↗</span></a>
                              <a href={entry.data.source} target="_blank" rel="noreferrer">Dernière source <span aria-hidden="true">↗</span></a>
                            </nav>
                          </div>
                        </details>
                      ))}
                    </div>
                  </details>
                ))}
              </div>
            </details>
          ))}
        </section>

        <section id="archive-filter-empty" class="archive-filter-empty" hidden>
          <strong>Aucune archive ne correspond à ces critères</strong>
          <p>Modifiez la recherche ou l’un des filtres pour retrouver davantage d’offres.</p>
        </section>

        <aside class="archive-transparency">
          <span aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 3 5 6v5c0 4.6 2.8 8.2 7 10 4.2-1.8 7-5.4 7-10V6z"/></svg>
          </span>
          <div><strong>Archives transparentes</strong><small>Une offre retirée n’est jamais effacée de l’historique.</small></div>
        </aside>
      </>
    )}
  </main>

  <footer class="archive-footer">
    <a class="archive-footer-brand" href="/" aria-label="GratuitPourLesDevs, accueil"><span aria-hidden="true">{`{ }`}</span><strong>GratuitPourLesDevs</strong></a>
    <nav aria-label="Navigation de pied de page"><a href="/methodologie/">Méthodologie</a><a href="/evolutions/">Évolutions</a><a href="/a-propos/">À propos</a><a href="/contact/">Contact</a></nav>
    <a class="archive-github" href="https://github.com/GratuitPourLesDevs/gratuitpourlesdevs.github.io" target="_blank" rel="noreferrer" aria-label="Projet GratuitPourLesDevs sur GitHub">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.8a9.3 9.3 0 0 0-2.9 18.1c.5.1.6-.2.6-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.6 1 1.6 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.7-1.4-2.2-.3-4.6-1.1-4.6-4.9 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.5 9.5 0 0 1 5.1 0c2-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.8-2.3 4.6-4.6 4.9.4.3.7.9.7 1.8v2.7c0 .3.2.6.7.5A9.3 9.3 0 0 0 12 2.8Z"/></svg>
    </a>
  </footer>
</BaseLayout>

<script is:inline>
  (() => {
    const search = document.querySelector('#archive-search');
    const category = document.querySelector('#archive-category');
    const reason = document.querySelector('#archive-reason-filter');
    const year = document.querySelector('#archive-year-filter');
    const sort = document.querySelector('#archive-sort');
    const groups = document.querySelector('#archive-groups');
    const resultCount = document.querySelector('#archive-result-count');
    const empty = document.querySelector('#archive-filter-empty');
    if (!search || !category || !reason || !year || !sort || !groups || !resultCount || !empty) return;

    const entries = [...groups.querySelectorAll('[data-archive-entry]')];
    const years = [...groups.querySelectorAll('[data-year-group]')];
    const normalize = (value) => String(value ?? '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('fr-FR');

    const sortEntries = () => {
      const mode = sort.value;
      years.sort((a, b) => {
        const left = Number(a.dataset.sort);
        const right = Number(b.dataset.sort);
        return mode === 'oldest' ? left - right : right - left;
      }).forEach((group) => groups.append(group));

      years.forEach((yearGroup) => {
        const yearContent = yearGroup.querySelector('.archive-year-content');
        const months = [...yearGroup.querySelectorAll(':scope > .archive-year-content > [data-month-group]')];
        months.sort((a, b) => {
          const left = Number(a.dataset.sort);
          const right = Number(b.dataset.sort);
          return mode === 'oldest' ? left - right : right - left;
        }).forEach((group) => yearContent?.append(group));

        months.forEach((monthGroup) => {
          const list = monthGroup.querySelector('.archive-month-list');
          const monthEntries = [...monthGroup.querySelectorAll(':scope > .archive-month-list > [data-archive-entry]')];
          monthEntries.sort((a, b) => {
            if (mode === 'name') return String(a.dataset.name).localeCompare(String(b.dataset.name), 'fr');
            const left = Number(a.dataset.date);
            const right = Number(b.dataset.date);
            return mode === 'oldest' ? left - right : right - left;
          }).forEach((entry) => list?.append(entry));
        });
      });
    };

    const update = () => {
      const query = normalize(search.value);
      const selectedCategory = category.value;
      const selectedReason = reason.value;
      const selectedYear = year.value;
      const filtering = Boolean(query || selectedCategory || selectedReason || selectedYear);
      let visibleCount = 0;

      entries.forEach((entry) => {
        const matchesQuery = !query || normalize(entry.dataset.search).includes(query);
        const matchesCategory = !selectedCategory || entry.dataset.category === selectedCategory;
        const matchesReason = !selectedReason || entry.dataset.reason === selectedReason;
        const matchesYear = !selectedYear || entry.dataset.year === selectedYear;
        const visible = matchesQuery && matchesCategory && matchesReason && matchesYear;
        entry.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      groups.querySelectorAll('[data-month-group]').forEach((monthGroup) => {
        const visibleEntries = [...monthGroup.querySelectorAll(':scope > .archive-month-list > [data-archive-entry]')].filter((entry) => !entry.hidden);
        monthGroup.hidden = visibleEntries.length === 0;
        if (filtering && visibleEntries.length > 0) monthGroup.open = true;
      });

      years.forEach((yearGroup) => {
        const visibleEntries = [...yearGroup.querySelectorAll('[data-archive-entry]')].filter((entry) => !entry.hidden);
        yearGroup.hidden = visibleEntries.length === 0;
        const count = yearGroup.querySelector('[data-year-count]');
        if (count) count.textContent = `${visibleEntries.length} ${visibleEntries.length > 1 ? 'offres' : 'offre'}`;
        if (filtering && visibleEntries.length > 0) yearGroup.open = true;
      });

      resultCount.textContent = `${visibleCount} ${visibleCount > 1 ? 'offres archivées' : 'offre archivée'}`;
      empty.hidden = visibleCount !== 0;
      groups.hidden = visibleCount === 0;
      sortEntries();
    };

    search.addEventListener('input', update);
    category.addEventListener('change', update);
    reason.addEventListener('change', update);
    year.addEventListener('change', update);
    sort.addEventListener('change', update);
    sortEntries();
  })();
</script>

<style>
