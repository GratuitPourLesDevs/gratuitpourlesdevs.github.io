---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { STACK_TEMPLATES, type StackTemplate } from '../../data/stack-templates';
import { buildStackTemplateView, getConfidenceTone, type StackOfferEntry } from '../../lib/stack-template-view';
import '../../styles/stacks.css';

export const getStaticPaths = () => STACK_TEMPLATES.map((template) => ({ params: { slug: template.slug }, props: { template } }));
const { template } = Astro.props as { template: StackTemplate };
const offerEntries = (await getCollection('offres')).filter(({ data }) => data.statut !== 'obsolete') as StackOfferEntry[];
const stack = buildStackTemplateView(template, new Map(offerEntries.map((entry) => [entry.id, entry])));
const threatCopy = stack.threat ? `${stack.threat.offer.data.nom} est actuellement le maillon le plus exposé : ${stack.threat.riskLabel.toLowerCase()}.` : 'Aucun risque prioritaire n’est identifié dans les fiches actuellement vérifiées.';
const verificationLabel = stack.oldestVerification?.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) ?? 'non disponible';
const alternatives = STACK_TEMPLATES.filter((item) => item.slug !== stack.slug && (item.category === stack.category || item.featured)).slice(0, 3);
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'TechArticle', headline: stack.name, description: stack.description, about: stack.services.map((service) => service.offer.data.nom), author: { '@type': 'Organization', name: 'GratuitPourLesDevs' }, mainEntityOfPage: new URL(`/stacks/${stack.slug}/`, Astro.site).href },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: `Services de la ${stack.name}`, numberOfItems: stack.services.length, itemListElement: stack.services.map((service, index) => ({ '@type': 'ListItem', position: index + 1, name: `${service.role} : ${service.offer.data.nom}`, url: new URL(`/offres/${service.offer.id}/`, Astro.site).href })) },
];
---

<BaseLayout title={`${stack.name} — services gratuits vérifiés | GratuitPourLesDevs`} description={`${stack.description} Consultez les risques, scores et quotas, puis ajoutez cette stack gratuite à votre compte.`} jsonLd={jsonLd}>
  <SiteHeader active="stacks" />
  <main class="stacks-page">
    <nav class="stacks-breadcrumb" aria-label="Fil d’Ariane"><a href="/">Accueil</a><span>›</span><a href="/stacks/">Stacks</a><span>›</span><strong>{stack.name}</strong></nav>
    <header class="stack-detail-hero"><h1>{stack.name}</h1><p>{stack.description}<br />{stack.services.length} services pour démarrer, tester et valider votre projet avant de faire évoluer chaque brique.</p></header>
    <section class="stack-decision-signals" aria-label="Signaux de décision"><article class:list={['stack-decision-signal', 'stack-confidence-signal', getConfidenceTone(stack.confidence)]}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 20 6v6c0 4.7-3.1 7.5-8 9-4.9-1.5-8-4.3-8-9V6l8-3Z"/><path d="m8.5 12 2.2 2.2 4.8-5"/></svg><div><strong>Confiance €0 : <b>{stack.confidence}/100</b></strong><span>Facturation, fraîcheur et restrictions.</span></div></article><article class:list={['stack-decision-signal', stack.billingRisks ? 'is-warning' : 'is-safe']}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18 M16 15h2"/></svg><div><strong>Risque de facturation</strong><span>{stack.billingRisks ? `${stack.billingRisks} service${stack.billingRisks > 1 ? 's' : ''} à surveiller.` : 'Aucun dépassement facturé identifié.'}</span></div></article><article class="stack-decision-signal is-safe"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18 M5 16l14-8"/></svg><div><strong>Sans carte bancaire</strong><span>{stack.noCard}/{stack.services.length} services sans carte au démarrage.</span></div></article><article class="stack-decision-signal"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M8 3v4 M16 3v4 M4 10h16 M8 14h2 M14 14h2 M8 18h2"/></svg><div><strong>Fraîcheur</strong><span>Offre la plus ancienne vérifiée le {verificationLabel}.</span></div></article></section>
    <nav class="stack-detail-actions"><a class="stack-button" href={`/compte/?modele=${stack.slug}&action=add#stack`}><span aria-hidden="true">＋</span> Ajouter cette stack à mon compte</a><a class="stack-button secondary" href={`/compte/?modele=${stack.slug}&action=adapt#stack`}><span aria-hidden="true">☷</span> Adapter cette stack</a></nav>

    <section aria-labelledby="stack-services-title"><h2 class="sr-only" id="stack-services-title">Services de la stack</h2><div class="stack-table"><div class="stack-table-head" aria-hidden="true"><span>Service</span><span>Pourquoi ce choix</span><span>Évaluation</span></div>{stack.services.map((service) => <article class="stack-table-row"><div class="stack-service-identity"><a class="stack-service-name" href={`/offres/${service.offer.id}/`}><i class="stack-brand-mark" style={`--offer-color:${service.offer.data.couleur}`}><span>{service.offer.data.initiales}</span>{service.logoUrl && <img src={service.logoUrl} alt="" loading="lazy" />}</i><span class="stack-service-copy"><strong>{service.offer.data.nom}</strong><small>{service.role}</small></span></a></div><p class="stack-reason">{service.reason}</p><div class="stack-service-evaluation"><strong class:list={['stack-risk', service.risk]}>{service.riskLabel}</strong><span class:list={['stack-score', getConfidenceTone(service.score)]}>{service.score == null ? '—' : `${service.score}/100`}</span></div></article>)}</div></section>

    <section class:list={['stack-diagnostic', stack.threat ? 'has-risk' : 'is-clear']}><div class="stack-diagnostic-heading"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 2.8 20h18.4L12 3Z"/><path d="M12 9v5M12 17h.01"/></svg><span><h2>Qu’est-ce qui menace cette stack gratuite ?</h2><p>{threatCopy}</p></span></div><div class="stack-diagnostic-risk"><strong>Limites d’usage</strong><p>Les quotas gratuits imposent des plafonds à surveiller.</p></div><div class="stack-diagnostic-risk"><strong>Évolution des offres</strong><p>Les services peuvent modifier leurs formules.</p></div><div class="stack-diagnostic-risk"><strong>Verrous propriétaires</strong><p>Anticipez les dépendances difficiles à remplacer.</p></div><div class="stack-diagnostic-risk"><strong>SLA et support</strong><p>Les garanties restent souvent limitées en gratuit.</p></div></section>

    <section class="stack-detail-panels"><article class="is-strength"><h2><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 20 6v6c0 4.7-3.1 7.5-8 9-4.9-1.5-8-4.3-8-9V6l8-3Z"/><path d="m8.5 12 2.2 2.2 4.8-5"/></svg>Pourquoi cette stack</h2><p>{stack.description}</p><ul>{stack.strengths.map((strength) => <li>{strength}</li>)}</ul></article><article class="is-caution"><h2><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 2.8 20h18.4L12 3Z"/><path d="M12 9v5M12 17h.01"/></svg>Limites à connaître</h2><p>{stack.vigilance}</p><p>Le score de confiance €0 aide à comparer les architectures, mais chaque quota reste celui du fournisseur.</p></article><article class="is-alternatives"><h2><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h11M13 3l4 4-4 4M19 17H8M11 13l-4 4 4 4"/></svg>Stacks alternatives</h2><nav>{alternatives.map((alternative) => <a class="stack-alternative-link" href={`/stacks/${alternative.slug}/`}>{alternative.name}<span>→</span></a>)}</nav><p>Le mode « Adapter » charge un modèle sans remplacer votre stack tant que vous ne l’enregistrez pas.</p></article></section>
  </main>
  <SiteFooter />
</BaseLayout>
