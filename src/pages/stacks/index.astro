---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { STACK_TEMPLATES } from '../../data/stack-templates';
import { buildStackTemplateView, type StackOfferEntry } from '../../lib/stack-template-view';
import '../../styles/stacks.css';

const offerEntries = (await getCollection('offres')).filter(({ data }) => data.statut !== 'obsolete') as StackOfferEntry[];
const offers = new Map(offerEntries.map((entry) => [entry.id, entry]));
const stacks = STACK_TEMPLATES.map((template) => buildStackTemplateView(template, offers));
const featured = (stacks.find((stack) => stack.featured) ?? stacks[0])!;
const directory = stacks.filter((stack) => stack.slug !== featured.slug);
const categories = [...new Set(stacks.map((stack) => stack.category))];
const confidenceTone = (score: number) => score >= 90 ? 'is-excellent' : score >= 75 ? 'is-balanced' : 'is-limited';
const iconPaths: Record<string, string> = {
  portfolio: 'M5 4h14v16H5z M8 8h8 M8 12h5',
  'api-nodejs': 'M7 4 3 8l4 4 M17 4l4 4-4 4 M9 20l6-16',
  'react-postgresql': 'M12 3c4 0 7 4 7 9s-3 9-7 9-7-4-7-9 3-9 7-9Z M5 12h14 M12 3c2 3 3 6 3 9s-1 6-3 9c-2-3-3-6-3-9s1-6 3-9Z',
  nextjs: 'M4 18 12 4l8 14 M8 18h8', mobile: 'M7 3h10v18H7z M10 17h4',
  ia: 'M12 3v4 M12 17v4 M3 12h4 M17 12h4 M6 6l3 3 M15 15l3 3 M18 6l-3 3 M9 15l-3 3 M9 9h6v6H9z',
  'e-commerce': 'M3 5h2l2 10h10l3-7H6 M9 20h.01 M17 20h.01',
  'open-source': 'M7 5v10 M17 9v10 M7 5a2 2 0 1 0 0 .01 M7 15a2 2 0 1 0 0 .01 M17 9a2 2 0 1 0 0 .01 M17 19a2 2 0 1 0 0 .01 M9 6c5 0 6 2 6 5v6',
  'sans-carte': 'M3 6h18v12H3z M3 10h18 M5 4l14 16', europe: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z M3 12h18 M12 3c3 3 4 6 4 9s-1 6-4 9c-3-3-4-6-4-9s1-6 4-9Z',
};
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'CollectionPage',
  name: 'Stacks gratuites prêtes à l’emploi pour développeurs',
  description: 'Des architectures de services gratuits composées à partir des offres vérifiées par GratuitPourLesDevs.',
  mainEntity: { '@type': 'ItemList', numberOfItems: stacks.length, itemListElement: stacks.map((stack, index) => ({ '@type': 'ListItem', position: index + 1, url: new URL(`/stacks/${stack.slug}/`, Astro.site).href, name: stack.name })) },
};
---

<BaseLayout title="Stacks gratuites prêtes à l’emploi — GratuitPourLesDevs" description="Choisissez une stack SaaS, Next.js, mobile, IA ou sans carte bancaire composée d’offres gratuites vérifiées, puis adaptez-la à votre projet." jsonLd={jsonLd}>
  <SiteHeader active="stacks" />
  <main class="stacks-page">
    <nav class="stacks-breadcrumb" aria-label="Fil d’Ariane"><a href="/">Accueil</a><span>›</span><strong>Stacks</strong></nav>
    <header class="stacks-hero"><h1>Des stacks gratuites,<br />prêtes à lancer.</h1><p>Des ensembles de services gratuits pour créer, déployer et faire évoluer vos projets. Chaque stack reste adaptable et ses risques sont calculés depuis les fiches vérifiées.</p></header>

    <section class="stacks-featured" aria-labelledby="featured-stack-title"><div class="featured-flag"><small>STACK<br />À LA UNE</small><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2 3 6 7 .9-5 4.8 1.3 6.8L12 17l-6.3 3.5L7 13.7 2 8.9 9 8l3-6Z" /></svg></div><div class="stacks-featured-main"><h2 id="featured-stack-title">{featured.name}</h2><p>{featured.description}</p></div><div class="featured-metric"><span>SERVICES</span><strong>{featured.services.length}</strong></div><div class:list={['featured-metric', 'featured-confidence', confidenceTone(featured.confidence)]}><span>CONFIANCE €0</span><strong>{featured.confidence}<small>/100</small></strong></div><div class="featured-action"><a class="stack-button" href={`/stacks/${featured.slug}/`}>Voir la stack <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg></a></div><ul class="stack-service-strip"><li>Services inclus</li>{featured.services.map((service) => <li><i class="stack-brand-mark" style={`--offer-color:${service.offer.data.couleur}`}><span>{service.offer.data.initiales}</span>{service.logoUrl && <img src={service.logoUrl} alt="" loading="lazy" />}</i><strong>{service.offer.data.nom}</strong></li>)}</ul></section>

    <section aria-labelledby="stacks-directory-title">
      <h2 class="sr-only" id="stacks-directory-title">Toutes les stacks prêtes à l’emploi</h2><header class="stacks-directory-header"><label class="stacks-search-shell"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16 16 5 5"/></svg><input class="stacks-search" id="stacks-search" type="search" placeholder="Rechercher une stack…" aria-label="Rechercher une stack" /></label><select class="stacks-filter" id="stacks-filter" aria-label="Filtrer par catégorie"><option value="">Catégorie</option>{categories.map((category) => <option value={category}>{category}</option>)}</select><select class="stacks-filter" id="stacks-use-filter" aria-label="Filtrer par nombre de services"><option value="">Cas d’usage</option><option value="compact">Stack compacte · 5 services ou moins</option><option value="complete">Stack complète · 6 services ou plus</option></select><select class="stacks-filter" id="stacks-confidence-filter" aria-label="Filtrer par confiance"><option value="">Confiance</option><option value="high">90 et plus</option><option value="attention">Moins de 90</option></select><button class="stacks-reset" id="stacks-reset" type="button">↶ Réinitialiser</button></header>
      <div class="stacks-table-shell"><div class="stacks-table-head" aria-hidden="true"><span>Stack</span><span>Cas d’usage</span><span>Confiance</span><span>Services</span><span>Actions</span></div>
      <ul class="stacks-list" id="stacks-list">
        {directory.map((stack) => <li data-stack-row data-category={stack.category} data-count={stack.services.length} data-confidence={stack.confidence} data-search={`${stack.name} ${stack.description} ${stack.services.map((service) => service.offer.data.nom).join(' ')}`}><a class="stack-directory-row" href={`/stacks/${stack.slug}/`}><span class="stack-row-identity"><span class="stack-row-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={iconPaths[stack.slug] ?? iconPaths.portfolio}/></svg></span><span class="stack-row-copy"><h3>{stack.name}</h3><p>{stack.description}</p></span></span><span class="stack-row-use">{stack.audience}</span><strong class:list={['stack-row-confidence', confidenceTone(stack.confidence)]}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 20 6v6c0 4.7-3.1 7.5-8 9-4.9-1.5-8-4.3-8-9V6l8-3Z"/><path d="m8.5 12 2.2 2.2 4.8-5"/></svg>{stack.confidence}<small>/100</small></strong><strong class="stack-row-count">{stack.services.length}<small>services</small></strong><span class="stack-row-action">Voir la stack <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg></span></a></li>)}
      </ul></div>
      <p class="stacks-empty" id="stacks-empty" hidden>Aucune stack ne correspond à ces critères.</p>
    </section>
  </main>
  <SiteFooter />
  <script is:inline>
    const normalizeStackSearch = (value) => String(value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    const stackSearch = document.querySelector('#stacks-search');
    const stackFilter = document.querySelector('#stacks-filter'); const stackUseFilter = document.querySelector('#stacks-use-filter'); const stackConfidenceFilter = document.querySelector('#stacks-confidence-filter');
    const filterStacks = () => {
      const query = normalizeStackSearch(stackSearch?.value); const category = stackFilter?.value || ''; const use = stackUseFilter?.value || ''; const confidence = stackConfidenceFilter?.value || ''; let visible = 0;
      document.querySelectorAll('[data-stack-row]').forEach((row) => { const count = Number(row.dataset.count); const score = Number(row.dataset.confidence); const useMatch = !use || (use === 'compact' ? count <= 5 : count >= 6); const confidenceMatch = !confidence || (confidence === 'high' ? score >= 90 : score < 90); const show = (!category || row.dataset.category === category) && useMatch && confidenceMatch && (!query || normalizeStackSearch(row.dataset.search).includes(query)); row.hidden = !show; if (show) visible++; });
      document.querySelector('#stacks-empty').hidden = visible !== 0;
    };
    stackSearch?.addEventListener('input', filterStacks); [stackFilter, stackUseFilter, stackConfidenceFilter].forEach((control) => control?.addEventListener('change', filterStacks)); document.querySelector('#stacks-reset')?.addEventListener('click', () => { stackSearch.value = ''; stackFilter.value = ''; stackUseFilter.value = ''; stackConfidenceFilter.value = ''; filterStacks(); });
  </script>
</BaseLayout>
