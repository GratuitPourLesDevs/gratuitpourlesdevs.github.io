---
import { getCollection } from 'astro:content';
export const prerender = true;
const offers=await getCollection('offres'),programs=await getCollection('affiliations'),campaigns=await getCollection('campagnes');const offersById=new Map(offers.map((offer)=>[offer.id,offer])),programsById=new Map(programs.map((program)=>[program.id,program]));
function campaignIsCurrent(campaign,now=new Date()){if(campaign.data.statut!=='active')return false;if(campaign.data.dateDebut&&campaign.data.dateDebut.getTime()>now.getTime())return false;if(campaign.data.dateFin&&campaign.data.dateFin.getTime()<now.getTime())return false;return true;}
function destinationFor(program,campaign,offerId){return campaign.data.urlDestination??program.data.liensOffres.find((link)=>link.offre===offerId)?.url??program.data.urlAffiliee;}
export function getStaticPaths(){const now=new Date();return campaigns.flatMap((campaign)=>{if(!campaignIsCurrent(campaign,now))return[];const program=programsById.get(campaign.data.programme);if(!program||program.data.statut!=='active')return[];return campaign.data.offres.flatMap((offerId)=>{const offer=offersById.get(offerId),destination=destinationFor(program,campaign,offerId);if(!offer||offer.data.statut!=='active'||!destination)return[];return[{params:{campaign:campaign.id,offer:offer.id},props:{campaignId:campaign.id,programId:program.id,programName:program.data.fournisseur,offerId:offer.id,offerName:offer.data.nom,destination}}];});});}
const{campaignId,programId,programName,offerId,offerName,destination}=Astro.props;const trackingApi='https://gratuitpourlesdevs-oauth.gratuitpourlesdevsallianciasolutions.workers.dev/api/affiliate/event';const payload=JSON.stringify({campaignId,programId,offerId,destination,trackingApi}).replace(/</g,'\\u003c');
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><meta http-equiv="refresh" content={`3;url=${destination}`}/><title>Redirection vers {offerName} — GratuitPourLesDevs</title><style>:root{font-family:Inter,ui-sans-serif,system-ui;color:#111827;background:#f8fafc}body{margin:0;min-height:100vh;display:grid;place-items:center;padding:24px}main{max-width:560px;background:#fff;border:1px solid #e5e7eb;border-radius:18px;padding:32px;box-shadow:0 18px 60px rgb(15 23 42/10%);text-align:center}small{color:#0b45ff;font-weight:800;letter-spacing:.08em}h1{font-size:1.7rem;margin:.7rem 0}p{color:#4b5563;line-height:1.6}a{display:inline-flex;margin-top:12px;padding:12px 18px;border-radius:10px;background:#0b45ff;color:#fff;text-decoration:none;font-weight:800}</style></head><body><main><small>LIEN PARTENAIRE</small><h1>Ouverture de {offerName}</h1><p>Vous allez être redirigé vers {programName}. Ce lien peut générer une commission pour GratuitPourLesDevs, sans surcoût pour vous.</p><a href={destination} rel="sponsored noreferrer">Continuer vers {offerName} →</a></main><script type="application/json" id="affiliate-redirect-data" set:html={payload}></script><script is:inline>(()=>{const data=JSON.parse(document.getElementById('affiliate-redirect-data').textContent),params=new URLSearchParams(location.search),allowed=['accueil','catalogue','fiche','guide','comparatif','fournisseur'],placement=allowed.includes(params.get('placement'))?params.get('placement'):'fiche',event={eventType:'click',campaign:data.campaignId,program:data.programId,offer:data.offerId,placement,pagePath:params.get('from')?.startsWith('/')?params.get('from').slice(0,256):'/'};try{fetch(data.trackingApi,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(event),keepalive:true,mode:'cors'}).catch(()=>{});}catch{}location.replace(data.destination);})();</script></body></html>
