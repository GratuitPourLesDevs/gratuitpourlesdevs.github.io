---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const guides = [
  {
    href: '/guides/email/meilleures-offres-gratuites/',
    category: 'E-MAIL',
    title: 'Les meilleures offres gratuites pour l’e-mail',
    description: 'Comparez les volumes d’envoi, les contacts inclus et les conditions d’accès.',
    signals: ['E-mails envoyés', 'Contacts', 'Sans carte'],
  },
  {
    href: '/guides/api-donnees-ml/meilleures-offres-gratuites/',
    category: 'API, DONNÉES & ML',
    title: 'Les meilleures offres gratuites — API, données et machine learning',
    description: 'Repérez les quotas réellement comparables, la permanence et les limites de facturation.',
    signals: ['Requêtes API', 'Crédits IA', 'Quotas normalisés'],
  },
  {
    href: '/guides/depots-code-source/meilleures-offres-gratuites/',
    category: 'DÉPÔTS DE CODE SOURCE',
    title: 'Les meilleurs hébergements de code source gratuits',
    description: 'Évaluez dépôts, collaborateurs, stockage et minutes CI/CD sur une même base.',
    signals: ['Dépôts', 'Collaborateurs', 'CI/CD'],
  },
  {
    href: '/guides/supervision/meilleures-offres-gratuites/',
    category: 'SUPERVISION',
    title: 'Les meilleures offres gratuites de supervision',
    description: 'Comparez monitoring, uptime, observabilité, fréquence de contrôle et rétention.',
    signals: ['Monitoring', 'Uptime', 'Rétention'],
  },
  {
    href: '/guides/tests/meilleures-offres-gratuites/',
    category: 'TESTS',
    title: 'Les meilleures offres gratuites pour tester ses applications',
    description: 'Comparez exécutions, environnements, parallélisme, projets et historique.',
    signals: ['Tests / runs', 'Parallélisme', 'Historique'],
  },
  {
    href: '/guides/ci-cd/meilleures-offres-gratuites/',
    category: 'CI/CD',
    title: 'Les meilleures offres gratuites pour vos pipelines CI/CD',
    description: 'Comparez builds, déploiements, compute, crédits, concurrence et capacité d’équipe.',
    signals: ['Builds / deploys', 'Compute / crédits', 'Concurrence'],
  },
];
---

<BaseLayout
  title="Guides des meilleurs outils gratuits pour développeurs — GratuitPourLesDevs"
  description="Retrouvez les sélections éditoriales GratuitPourLesDevs par catégorie : meilleurs free tiers, limites, scores et usages comparés."
>
  <SiteHeader active="guides" />

  <main class="guides-page">
    <nav class="guides-breadcrumb" aria-label="Fil d’Ariane"><a href="/">Accueil</a><span aria-hidden="true">›</span><strong>Guides</strong></nav>

    <header class="guides-hero">
      <div class="guides-hero-copy">
        <small>SÉLECTIONS ÉDITORIALES</small>
        <h1>Les meilleurs outils gratuits, catégorie par catégorie.</h1>
        <p>Des guides construits à partir du catalogue GratuitPourLesDevs pour comparer rapidement les offres gratuites les plus intéressantes, leurs scores, leurs limites et leurs usages.</p>
      </div>
      <aside class="guides-hero-proof" aria-label="Méthode éditoriale des guides">
        <small>DES GUIDES VÉRIFIABLES</small>
        <h2>Des choix expliqués, pas un simple palmarès.</h2>
        <ul>
          <li><span aria-hidden="true">✓</span> Quotas comparés sur une même base</li>
          <li><span aria-hidden="true">✓</span> Restrictions importantes rendues visibles</li>
          <li><span aria-hidden="true">✓</span> Sources officielles et dates de contrôle</li>
        </ul>
        <nav><a href="/methodologie/">Consulter la méthodologie →</a><a href="/explorer/">Explorer les quotas →</a></nav>
      </aside>
    </header>

    <section class="guides-directory" aria-labelledby="guides-directory-title">
      <header><div><small>GUIDES DISPONIBLES</small><h2 id="guides-directory-title">Commencer par une catégorie</h2></div></header>
      <div class="guides-directory-layout">
      <div class="guides-grid">
        {guides.slice(0, 2).map((guide) => (
          <a href={guide.href} data-guide-item>
            <span class="guides-copy">
              <small>{guide.category}</small>
              <strong>{guide.title}</strong>
              <em>{guide.description}</em>
              <span class="guides-signals" aria-label="Points comparés">{guide.signals.map((signal) => <i>{signal}</i>)}</span>
            </span>
            <b aria-hidden="true">→</b>
          </a>
        ))}
        <aside class="guides-sidebar" aria-label="À découvrir">
          <div class="catalogue-partner-slot guides-partner-slot" id="guides-partner-slot" aria-label="Sélection partenaire" hidden></div>
          <section class="guides-sidebar-fallback">
            <small>ALLER PLUS LOIN</small>
            <h2>Trouvez l’offre adaptée à votre besoin.</h2>
            <p>Comparez des quotas réellement compatibles, puis gardez les conditions de facturation visibles.</p>
            <a href="/explorer/">Ouvrir l’Explorateur →</a>
            <a href="/methodologie/">Comment nous vérifions →</a>
          </section>
        </aside>
        {guides.slice(2).map((guide) => (
          <a href={guide.href} data-guide-item>
            <span class="guides-copy">
              <small>{guide.category}</small>
              <strong>{guide.title}</strong>
              <em>{guide.description}</em>
              <span class="guides-signals" aria-label="Points comparés">{guide.signals.map((signal) => <i>{signal}</i>)}</span>
            </span>
            <b aria-hidden="true">→</b>
          </a>
        ))}
        <nav class="guides-pagination pagination" id="guides-pagination" aria-label="Pagination des guides">
          <span id="guides-pagination-summary" aria-live="polite"></span>
          <div class="pagination-controls" id="guides-pagination-controls" hidden>
            <button id="guides-previous-page" type="button" aria-label="Page précédente">← <span>Précédent</span></button>
            <div id="guides-page-numbers" aria-label="Pages des guides"></div>
            <button id="guides-next-page" type="button" aria-label="Page suivante"><span>Suivant</span> →</button>
          </div>
        </nav>
      </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .guides-page{width:min(1120px,calc(100% - 7.2vw));min-height:calc(100vh - 174px);margin:0 auto;padding:30px 0 76px}.guides-breadcrumb{display:flex;align-items:center;gap:9px;color:var(--muted);font-size:10px}.guides-breadcrumb a{color:var(--blue);text-decoration:none}.guides-breadcrumb strong{color:var(--ink)}.guides-hero{display:grid;grid-template-columns:minmax(0,2fr) minmax(280px,1fr);gap:54px;align-items:center;padding:58px 0 54px;border-bottom:1px solid var(--line)}.guides-hero-copy>small,.guides-directory>header small,.guides-hero-proof>small,.guides-sidebar-fallback>small{color:var(--blue);font:700 10px var(--mono);letter-spacing:.9px}.guides-hero h1{max-width:900px;margin:10px 0 18px;font-size:clamp(44px,4.3vw,64px);line-height:.99;letter-spacing:-3.5px}.guides-hero-copy>p{max-width:760px;margin:0;color:var(--muted);font-size:15px;line-height:1.72}.guides-hero-proof{padding:25px;border:1px solid var(--line);border-top:3px solid var(--blue);border-radius:8px;background:var(--surface)}.guides-hero-proof h2{margin:9px 0 18px;font-size:22px;line-height:1.2;letter-spacing:-.5px}.guides-hero-proof ul{display:grid;gap:11px;margin:0;padding:16px 0;border-top:1px solid var(--line);list-style:none}.guides-hero-proof li{display:flex;gap:9px;color:var(--muted);font-size:11px;line-height:1.45}.guides-hero-proof li span{color:var(--green);font-weight:800}.guides-hero-proof nav{display:flex;flex-wrap:wrap;gap:9px 16px;padding-top:5px}.guides-hero-proof a,.guides-sidebar-fallback a{color:var(--blue);font-size:10px;font-weight:800;text-decoration:none}.guides-hero-proof a:hover,.guides-sidebar-fallback a:hover{text-decoration:underline}.guides-directory{padding-top:48px}.guides-directory>header{margin-bottom:22px}.guides-directory h2{margin:7px 0 0;font-size:27px;letter-spacing:-.8px}.guides-directory-layout{display:grid;grid-template-columns:minmax(0,3fr) minmax(260px,1fr);gap:24px;align-items:start;border-top:1px solid var(--line)}.guides-grid{display:contents}.guides-grid>a{min-height:108px;grid-column:1;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:20px;align-items:center;padding:17px 12px;border-bottom:1px solid var(--line);text-decoration:none}.guides-grid>a[hidden]{display:none}.guides-grid>a:hover{background:var(--surface-hover)}.guides-copy{display:grid;gap:4px}.guides-copy small{color:var(--blue);font:700 8px var(--mono);letter-spacing:.7px}.guides-copy strong{font-size:17px}.guides-copy em{color:var(--muted);font-size:10px;font-style:normal;line-height:1.45}.guides-signals{display:flex;flex-wrap:wrap;gap:5px;margin-top:3px}.guides-signals i{padding:3px 6px;border:1px solid var(--line);border-radius:999px;color:var(--muted);background:var(--surface);font-size:8px;font-style:normal}.guides-grid b{color:var(--blue);font-size:25px}.guides-sidebar{grid-column:2;grid-row:1/span 3;position:sticky;top:92px;padding-top:22px}.guides-partner-slot{margin:0}.guides-sidebar-fallback{display:grid;gap:13px;padding:24px;border:1px solid var(--line);border-radius:8px;background:var(--surface)}.guides-sidebar-fallback h2{margin:0;font-size:22px;line-height:1.2;letter-spacing:-.5px}.guides-sidebar-fallback p{margin:0;color:var(--muted);font-size:11px;line-height:1.6}.guides-partner-slot:not([hidden])+.guides-sidebar-fallback{display:none}.guides-pagination{grid-column:1;margin:0;padding-top:18px}.guides-pagination>span{display:grid;gap:3px}.guides-pagination>span::before{content:'AFFICHAGE';color:var(--blue);font:600 8px var(--mono);letter-spacing:.7px}@media(max-width:980px){.guides-hero{grid-template-columns:1fr;gap:28px}.guides-hero-proof{display:grid;grid-template-columns:1fr 1.2fr;gap:0 28px}.guides-hero-proof>small,.guides-hero-proof h2{grid-column:1}.guides-hero-proof ul,.guides-hero-proof nav{grid-column:2}.guides-hero-proof ul{grid-row:1/span 2;padding-top:0;border-top:0}.guides-directory-layout{grid-template-columns:minmax(0,2fr) minmax(250px,1fr)}}@media(max-width:760px){.guides-page{width:calc(100% - 32px);padding:22px 0 54px}.guides-hero{padding:40px 0}.guides-hero h1{font-size:42px;letter-spacing:-2.5px}.guides-hero-proof{display:block;padding:21px}.guides-hero-proof ul{margin-top:16px;padding-top:16px;border-top:1px solid var(--line)}.guides-directory-layout{display:block}.guides-grid{display:block;border-top:1px solid var(--line)}.guides-grid>a{min-height:0;grid-template-columns:1fr auto;gap:12px;padding:18px 4px}.guides-copy strong{font-size:15px}.guides-signals{gap:4px}.guides-sidebar{position:static;padding:24px 0;border-bottom:1px solid var(--line)}.guides-sidebar .catalogue-partner-card{display:block}.guides-sidebar .catalogue-partner-facts{display:grid;grid-template-columns:1fr;margin:0 16px}.guides-sidebar .catalogue-partner-facts>div{padding:13px 0;border-right:0}.guides-sidebar .catalogue-partner-actions{display:grid;grid-template-columns:1fr 1fr}.guides-sidebar-fallback{padding:21px}.guides-pagination{align-items:flex-start;flex-direction:column;padding:18px 4px 0}.guides-pagination .pagination-controls{width:100%;justify-content:space-between}.guides-pagination .pagination-controls>div{display:none}.guides-pagination .pagination-controls button span{display:none}}
</style>

<script>
  const PAGE_SIZE = 10;
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-guide-item]'));
  const summary = document.querySelector<HTMLElement>('#guides-pagination-summary');
  const controls = document.querySelector<HTMLElement>('#guides-pagination-controls');
  const previous = document.querySelector<HTMLButtonElement>('#guides-previous-page');
  const next = document.querySelector<HTMLButtonElement>('#guides-next-page');
  const pageNumbers = document.querySelector<HTMLElement>('#guides-page-numbers');
  let currentPage = 1;
  const pageCount = Math.max(1, Math.ceil(items.length / PAGE_SIZE));

  const render = () => {
    currentPage = Math.min(Math.max(currentPage, 1), pageCount);
    const start = (currentPage - 1) * PAGE_SIZE;
    const end = Math.min(start + PAGE_SIZE, items.length);
    items.forEach((item, index) => { item.hidden = index < start || index >= end; });
    if (summary) summary.textContent = items.length ? `${start + 1}–${end} sur ${items.length} guides` : '0 guide';
    if (controls) controls.hidden = pageCount <= 1;
    if (previous) previous.disabled = currentPage === 1;
    if (next) next.disabled = currentPage === pageCount;
    if (pageNumbers) {
      pageNumbers.replaceChildren();
      for (let page = 1; page <= pageCount; page += 1) {
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = String(page);
        button.classList.toggle('active', page === currentPage);
        button.setAttribute('aria-label', `Page ${page}`);
        if (page === currentPage) button.setAttribute('aria-current', 'page');
        button.addEventListener('click', () => { currentPage = page; render(); });
        pageNumbers.append(button);
      }
    }
  };

  previous?.addEventListener('click', () => { currentPage -= 1; render(); });
  next?.addEventListener('click', () => { currentPage += 1; render(); });
  render();
</script>
