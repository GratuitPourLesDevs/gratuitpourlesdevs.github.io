---
import EmailGuidePage from '../../comparatifs/email/meilleures-offres-gratuites.astro';
---

<EmailGuidePage />

<style is:global>
  @media (max-width: 980px) {
    .seo-comparison .seo-table-shell {
      overflow: visible !important;
      border: 0 !important;
      border-radius: 0 !important;
    }

    .seo-comparison .seo-table-shell table {
      display: block;
      width: 100% !important;
      min-width: 0 !important;
      border-collapse: separate;
      font-size: 11.5px;
    }

    .seo-comparison .seo-table-shell thead {
      position: absolute !important;
      width: 1px !important;
      height: 1px !important;
      padding: 0 !important;
      margin: -1px !important;
      overflow: hidden !important;
      clip: rect(0, 0, 0, 0) !important;
      white-space: nowrap !important;
      border: 0 !important;
    }

    .seo-comparison .seo-table-shell tbody {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .seo-comparison .seo-table-shell tbody tr {
      display: grid;
      align-content: start;
      padding: 16px;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: var(--surface);
    }

    .seo-comparison .seo-table-shell tbody td {
      display: grid !important;
      grid-template-columns: minmax(110px, .75fr) minmax(0, 1.25fr);
      gap: 10px;
      align-items: center;
      min-width: 0 !important;
      padding: 9px 0 !important;
      border-top: 1px solid var(--line) !important;
      font-size: 11.5px !important;
      line-height: 1.45;
    }

    .seo-comparison .seo-table-shell tbody td:first-child {
      display: flex !important;
      grid-column: 1 / -1;
      gap: 12px;
      min-height: 50px;
      padding: 0 0 12px !important;
      border-top: 0 !important;
      font-size: 14px !important;
    }

    .seo-comparison .seo-table-shell tbody td:nth-child(n + 2)::before {
      color: var(--muted);
      font: 700 9px var(--mono);
      letter-spacing: .35px;
      line-height: 1.35;
      text-transform: uppercase;
    }

    .seo-comparison .seo-table-shell tbody td:nth-child(2)::before { content: 'Type'; }
    .seo-comparison .seo-table-shell tbody td:nth-child(3)::before { content: 'Quota clé'; }
    .seo-comparison .seo-table-shell tbody td:nth-child(4)::before { content: 'Formule gratuite'; }
    .seo-comparison .seo-table-shell tbody td:nth-child(5)::before { content: 'Durée'; }
    .seo-comparison .seo-table-shell tbody td:nth-child(6)::before { content: 'Dépassement'; }
    .seo-comparison .seo-table-shell tbody td:nth-child(7)::before { content: 'Carte bancaire'; }
    .seo-comparison .seo-table-shell tbody td:nth-child(8)::before { content: 'Usage idéal'; }

    .seo-comparison .seo-table-shell .seo-quota-cell {
      min-width: 0 !important;
    }

    .seo-comparison .seo-table-shell .seo-table-score {
      width: 42px;
      height: 42px;
    }

    .seo-comparison .seo-table-shell .seo-binary {
      width: max-content;
      max-width: 100%;
    }
  }

  @media (max-width: 680px) {
    .seo-comparison .seo-table-shell tbody {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .seo-comparison .seo-table-shell tbody tr {
      padding: 15px;
    }
  }

  @media (max-width: 430px) {
    .seo-comparison .seo-table-shell tbody td {
      grid-template-columns: 1fr;
      gap: 5px;
      padding: 10px 0 !important;
    }

    .seo-comparison .seo-table-shell tbody td:nth-child(n + 2)::before {
      font-size: 8.5px;
    }
  }
</style>
