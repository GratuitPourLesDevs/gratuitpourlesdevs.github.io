---
interface Props { active?: 'catalogue' | 'explorer' | 'comparisons' | 'guides' | 'docs'; }
const { active } = Astro.props;
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Gratuit pour les devs, accueil">
    <svg viewBox="0 0 40 40" aria-hidden="true"><path d="m4 13 16-9 16 9-16 9L4 13Zm0 9 16 9 16-9M4 31l16 9 16-9" /></svg>
    <span>Gratuit<span>PourLesDevs</span></span>
  </a>
  <nav aria-label="Navigation principale"><a class:list={{ active: active === 'catalogue' }} href="/">Catalogue</a><a class:list={{ active: active === 'explorer' }} href="/explorer/">Explorateur</a><a class:list={{ active: active === 'comparisons' }} href="/comparaisons/">Comparaisons</a><a class:list={['guides-nav-link', { active: active === 'guides' }]} href="/comparatifs/">Guides</a></nav>
  <div class="header-actions">
    <ThemeToggle />
    <a class="outline-button" href="/contact/?objet=suggestion">Suggérer un outil</a>
    <a class:list={['docs-header-link', { active: active === 'docs' }]} href="/docs/" aria-label="Documentation" aria-current={active === 'docs' ? 'page' : undefined} title="Documentation">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5A3.5 3.5 0 0 1 7.5 2H11v17H7.5A3.5 3.5 0 0 0 4 22V5.5ZM20 5.5A3.5 3.5 0 0 0 16.5 2H13v17h3.5A3.5 3.5 0 0 1 20 22V5.5Z"/></svg>
    </a>
  </div>
</header>
