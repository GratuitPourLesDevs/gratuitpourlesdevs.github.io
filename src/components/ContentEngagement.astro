---
type ContentType = 'guide' | 'offer';

interface Props {
  type: ContentType;
  contentKey: string;
  updatedAt?: Date;
  comparedOffers?: number;
  trackView?: boolean;
  class?: string;
}

const {
  type,
  contentKey,
  updatedAt,
  comparedOffers,
  trackView = false,
  class: className,
} = Astro.props;
const updatedLabel = updatedAt?.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' });
---

<div
  class:list={['content-engagement', className]}
  data-content-engagement
  data-content-type={type}
  data-content-key={contentKey}
  data-track-view={trackView ? 'true' : undefined}
>
  {typeof comparedOffers === 'number' && comparedOffers > 0 && (
    <span class="content-engagement-stat" title="Nombre d’offres analysées dans ce guide">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="7" height="14" rx="1"/><rect x="14" y="8" width="7" height="11" rx="1"/></svg>
      {comparedOffers} offre{comparedOffers > 1 ? 's' : ''} comparée{comparedOffers > 1 ? 's' : ''}
    </span>
  )}
  {updatedAt && updatedLabel && (
    <time class="content-engagement-stat" datetime={updatedAt.toISOString()} title="Dernière mise à jour éditoriale">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16v13H4zM8 3v7M16 3v7M4 11h16"/></svg>
      Mis à jour le {updatedLabel}
    </time>
  )}
  <span class="content-engagement-stat" data-engagement-views hidden title="Nombre de consultations">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg>
    <span data-engagement-view-count></span> vue<span data-engagement-view-plural>s</span>
  </span>
  <button type="button" class="content-engagement-helpful" data-engagement-helpful aria-pressed="false" title="Indiquer que ce contenu vous a été utile">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10v10H3V10h4Zm0 9h9.2a2 2 0 0 0 1.9-1.4l2.4-7A2 2 0 0 0 18.6 8H14l.7-3.1A2.4 2.4 0 0 0 12.4 2L7 10Z"/></svg>
    <span>Utile</span>
    <span data-engagement-helpful-count hidden></span>
  </button>
</div>
