---
interface SelectOption {
  value: string;
  label: string;
}

interface Props {
  id: string;
  label: string;
  options: SelectOption[];
  searchable?: boolean;
  searchLabel?: string;
  searchPlaceholder?: string;
}

const {
  id,
  label,
  options,
  searchable = false,
  searchLabel = 'Rechercher une catégorie',
  searchPlaceholder = 'Rechercher une catégorie…',
} = Astro.props;
---

<div class="filter-field custom-select-field" data-control={id} data-searchable={String(searchable)}>
  <span id={`${id}-label`}>{label}</span>
  <div class="custom-select">
    <button class="custom-select-trigger" type="button" aria-haspopup="listbox" aria-expanded="false" aria-controls={`${id}-popover`} aria-labelledby={`${id}-label ${id}-value`}>
      <span id={`${id}-value`} data-selected-label>{options[0]?.label}</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg>
    </button>
    <div class="custom-select-popover" id={`${id}-popover`} hidden>
      {searchable && <label class="custom-select-search"><span class="sr-only">{searchLabel}</span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16 16 5 5"/></svg><input type="search" placeholder={searchPlaceholder} autocomplete="off" /></label>}
      <div class="custom-select-options" role="listbox" aria-labelledby={`${id}-label`}>
        {options.map((option, index) => <button type="button" role="option" data-value={option.value} data-option-label={option.label} aria-selected={index === 0}><span>{option.label}</span><b aria-hidden="true">✓</b></button>)}
      </div>
      <p class="custom-select-empty" hidden>Aucun résultat</p>
    </div>
    <select id={id} class="native-filter-control" tabindex="-1" aria-hidden="true">
      {options.map((option) => <option value={option.value}>{option.label}</option>)}
    </select>
  </div>
</div>
