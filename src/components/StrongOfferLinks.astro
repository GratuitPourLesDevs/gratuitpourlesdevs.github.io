---
import { getCollection, type CollectionEntry } from 'astro:content';
import { getFreeTierScore } from '../data/free-tier-score';
import { isEditorialReadyOffer } from '../lib/editorial-readiness.mjs';

interface Props {
  entries: CollectionEntry<'offres'>[];
  title?: string;
  intro?: string;
  limit?: number;
  diversifyCategories?: boolean;
  class?: string;
}

const {
  entries,
  title = 'Les fiches à consulter en priorité',
  intro = 'Des offres documentées en profondeur, avec quotas, limites, cas d’usage et critères de sortie.',
  limit = 4,
  diversifyCategories = false,
  class: className,
} = Astro.props;

const ranked = entries
  .filter((entry) => entry.data.statut === 'active' && isEditorialReadyOffer(entry.id))
  .map((entry) => ({ entry, score: getFreeTierScore(entry.id, entry.data) }))
  .sort((a, b) => b.score.total - a.score.total || b.entry.data.verifieLe.getTime() - a.entry.data.verifieLe.getTime() || a.entry.data.nom.localeCompare(b.entry.data.nom, 'fr'));
const categoryNames = new Map((await getCollection('categories')).map((category) => [category.id, category.data.nom]));

const selected = [] as typeof ranked;
if (diversifyCategories) {
  const seenCategories = new Set<string>();
  for (const item of ranked) {
    if (seenCategories.has(item.entry.data.categorie)) continue;
    selected.push(item);
    seenCategories.add(item.entry.data.categorie);
    if (selected.length === limit) break;
  }
}
for (const item of ranked) {
  if (selected.length === limit) break;
  if (!selected.some(({ entry }) => entry.id === item.entry.id)) selected.push(item);
}

const headingId = `strong-offers-${Astro.url.pathname.replace(/\W/g, '-') || 'home'}`;
---

{selected.length > 0 && (
  <section class:list={['strong-offer-links', className]} aria-labelledby={headingId}>
    <header>
      <div>
        <small>FICHES DE RÉFÉRENCE</small>
        <h2 id={headingId}>{title}</h2>
      </div>
      <p>{intro}</p>
    </header>
    <div class="strong-offer-grid">
      {selected.map(({ entry, score }) => (
        <a href={`/offres/${entry.id}/`} aria-label={`Consulter la fiche détaillée de ${entry.data.nom}`}>
          <span class="strong-offer-score"><strong>{score.total}</strong><small>/100</small></span>
          <span class="strong-offer-copy">
            <small>{categoryNames.get(entry.data.categorie) ?? entry.data.categorie.replaceAll('-', ' ')}</small>
            <strong>{entry.data.nom}</strong>
            <em>{entry.data.accroche}</em>
            <span>{entry.data.carteRequise ? 'Carte requise' : 'Sans carte'} · {entry.data.permanent ? 'Gratuit permanent' : 'Durée limitée'}</span>
          </span>
          <b aria-hidden="true">→</b>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .strong-offer-links{width:100%;margin:34px 0;padding:24px;border:1px solid var(--line);border-top:3px solid var(--blue);border-radius:9px;background:linear-gradient(135deg,color-mix(in srgb,var(--blue) 4%,var(--surface)),var(--surface) 48%)}
  .strong-offer-links>header{display:grid;grid-template-columns:minmax(0,1fr) minmax(240px,.7fr);gap:32px;align-items:end;margin-bottom:20px}
  .strong-offer-links>header small{color:var(--blue);font:700 9px var(--mono);letter-spacing:.75px}
  .strong-offer-links h2{margin:7px 0 0;font-size:23px;line-height:1.18;letter-spacing:-.55px}
  .strong-offer-links>header p{margin:0;color:var(--muted);font-size:11px;line-height:1.6}
  .strong-offer-grid{display:grid;grid-template-columns:repeat(var(--strong-offer-columns,4),minmax(0,1fr));border-top:1px solid var(--line);border-left:1px solid var(--line)}
  .strong-offer-grid>a{min-width:0;display:grid;grid-template-columns:44px minmax(0,1fr) auto;gap:12px;align-items:start;padding:16px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--surface);text-decoration:none;transition:background-color .15s,border-color .15s}
  .strong-offer-grid>a:hover,.strong-offer-grid>a:focus-visible{background:var(--surface-hover);box-shadow:inset 0 -2px 0 var(--blue)}
  .strong-offer-score{width:42px;height:42px;display:grid;place-content:center;text-align:center;border:1px solid color-mix(in srgb,var(--green) 55%,var(--line));border-radius:7px;color:var(--green);background:color-mix(in srgb,var(--green) 7%,var(--surface))}
  .strong-offer-score strong{font:800 15px var(--mono);line-height:1}
  .strong-offer-score small{font:700 7px var(--mono)}
  .strong-offer-copy{min-width:0;display:grid;gap:4px}
  .strong-offer-copy>small{overflow:hidden;color:var(--blue);font:700 8px var(--mono);letter-spacing:.45px;text-overflow:ellipsis;text-transform:uppercase;white-space:nowrap}
  .strong-offer-copy>strong{font-size:14px;line-height:1.25}
  .strong-offer-copy>em{display:-webkit-box;overflow:hidden;color:var(--muted);font-size:10px;font-style:normal;line-height:1.45;-webkit-box-orient:vertical;-webkit-line-clamp:2}
  .strong-offer-copy>span{margin-top:3px;color:var(--ink);font-size:9px;font-weight:700;line-height:1.35}
  .strong-offer-grid>a>b{align-self:center;color:var(--blue);font-size:17px}
  :global(.home-strong-offers){width:auto;margin:0 3.6vw 24px;--strong-offer-columns:3}
  :global(.guide-strong-offers){--strong-offer-columns:3}
  :global(.category-strong-offers){margin-top:30px;--strong-offer-columns:4}
  @media(max-width:1000px){.strong-offer-grid,:global(.home-strong-offers),:global(.guide-strong-offers),:global(.category-strong-offers){--strong-offer-columns:2}}
  @media(max-width:760px){.strong-offer-links{padding:18px}.strong-offer-links>header{grid-template-columns:1fr;gap:10px}.strong-offer-links h2{font-size:20px}.strong-offer-grid,:global(.home-strong-offers),:global(.guide-strong-offers),:global(.category-strong-offers){--strong-offer-columns:1}:global(.home-strong-offers){margin:0 16px 20px}.strong-offer-grid>a{padding:14px}}
</style>
