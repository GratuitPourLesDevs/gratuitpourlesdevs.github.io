# Jeton public du site créé dans Cloudflare Web Analytics > Manage site.
CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# AdSense reste désactivé tant que les quatre valeurs ne sont pas renseignées.
# Le CMP certifié par Google doit être activé depuis l'interface AdSense avant la mise en production.
PUBLIC_ADSENSE_ENABLED=false
PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
PUBLIC_ADSENSE_CATALOGUE_SLOT=0000000000
PUBLIC_ADSENSE_GUIDE_SLOT=0000000000
PUBLIC_ADSENSE_OFFER_SLOT=0000000000
