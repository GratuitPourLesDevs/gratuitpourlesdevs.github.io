{
  "name": "gratuitpourlesdevs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "audit:catalogue": "node scripts/audit-catalogue-order.mjs",
    "audit:editorials": "node scripts/audit-offer-editorials.mjs",
    "verify:offers": "node scripts/verify-offers.mjs",
    "verify:offers:dry": "node scripts/verify-offers.mjs --dry-run",
    "test:verify-offers": "node --test scripts/verify-offers.test.mjs",
    "test:oauth": "node --test worker/oauth.test.mjs",
    "test:account": "node --test worker/account.test.mjs",
    "test:worker": "node --test worker/*.test.mjs",
    "migrate:worker": "wrangler d1 migrations apply gratuitpourlesdevs-comparisons --remote --config worker/wrangler.jsonc",
    "deploy:oauth": "wrangler deploy --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.122.0"
  }
}
